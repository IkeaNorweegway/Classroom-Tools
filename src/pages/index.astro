---
import BaseLayout from '../layouts/BaseLayout.astro';
import LazySusan from '../components/LazySusan.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Classroom materials"
  description="Alberta curriculum classroom materials — Grade 6 Science, Grade 7 Science, Math 9, Social 9, Social 8, and STEAM Grades 5–9"
>
  <section class="home-hero mb-14 grid items-center gap-x-10 gap-y-8 lg:gap-y-10">
    <div class="[grid-area:intro] self-end">
      <p class="rise mb-5 text-sm font-semibold text-slate-500" style="--i: 0">Alberta curriculum · Grades 5 to 9</p>
      <h1 class="rise font-display text-[2.75rem] sm:text-[4rem] leading-[0.98] font-medium tracking-[-0.03em] text-slate-900" style="--i: 1">
        Classroom materials, <span class="italic font-normal text-slate-500">all in one place.</span>
      </h1>
      <p class="rise mt-6 max-w-[46ch] text-lg leading-relaxed text-slate-600" style="--i: 2">
        Notes, workbooks, practice and answer keys for Mr. Bremness's classes. Pick a course on the table to begin.
      </p>

      <div class="rise mt-8" style="--i: 3">
        <p class="mb-3 text-sm font-semibold text-slate-500" id="who-label">I'm a…</p>
        <div class="who grid grid-cols-3 gap-2 sm:max-w-md" role="group" aria-labelledby="who-label">
          <button type="button" class="who-opt" data-who="student" aria-pressed="false">
            <span class="who-title">Student</span>
            <span class="who-sub">Notes &amp; practice</span>
          </button>
          <a class="who-opt" data-who="parent" href={`${base}parents`}>
            <span class="who-title">Parent</span>
            <span class="who-sub">Help at home</span>
          </a>
          <a class="who-opt" data-who="teacher" href={`${base}teachers`}>
            <span class="who-title">Teacher</span>
            <span class="who-sub">Guides &amp; keys</span>
          </a>
        </div>
      </div>
    </div>

    <LazySusan />
  </section>

  <a
    href="https://drive.google.com/drive/folders/1vvIuLJxxR6xu3ZQiNPvW0tNapQzEqPR5"
    target="_blank"
    rel="noopener noreferrer"
    class="lift rise group flex items-center gap-4 rounded-2xl px-5 py-4 sm:px-6"
    style="--i: 6"
  >
    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-slate-600 shadow-[inset_0_1px_0_white,inset_0_0_0_1px_rgb(31_29_26/0.08)]">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="4.5" y="10.5" width="15" height="10" rx="2.5" />
        <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" />
      </svg>
    </span>
    <span class="min-w-0 flex-1">
      <span class="block text-[0.9375rem] font-semibold text-slate-800">Teacher materials: tests and answer keys</span>
      <span class="block text-sm text-slate-500">Google Drive folder. Sign-in and permission required.</span>
    </span>
    <span class="arrow shrink-0 text-slate-500" aria-hidden="true">↗</span>
  </a>

  <a
    href={`${base}resources`}
    class="lift rise group mt-3 flex items-center gap-4 rounded-2xl px-5 py-4 sm:px-6"
    style="--i: 7"
  >
    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-slate-600 shadow-[inset_0_1px_0_white,inset_0_0_0_1px_rgb(31_29_26/0.08)]">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="4" y="4" width="6.5" height="6.5" rx="1.5" />
        <rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5" />
        <rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5" />
        <rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5" />
      </svg>
    </span>
    <span class="min-w-0 flex-1">
      <span class="block text-[0.9375rem] font-semibold text-slate-800">More resources</span>
      <span class="block text-sm text-slate-500">Extras that aren't tied to a course.</span>
    </span>
    <span class="arrow shrink-0 text-slate-500" aria-hidden="true">→</span>
  </a>
</BaseLayout>

<script>
  // "I'm a…" chooser. The choice is remembered, and course links on the
  // turntable then open that audience's view when the course has one.
  const opts = document.querySelectorAll<HTMLElement>('[data-who]');
  const apply = (who: string) => {
    opts.forEach((o) => {
      if (o instanceof HTMLButtonElement) o.setAttribute('aria-pressed', String(o.dataset.who === who));
      o.classList.toggle('is-chosen', o.dataset.who === who);
    });
    document.querySelectorAll<HTMLAnchorElement>('[data-href-student]').forEach((a) => {
      a.href = a.dataset[`href${who[0].toUpperCase()}${who.slice(1)}`] || a.dataset.hrefStudent!;
    });
  };
  const save = (who: string) => {
    try { localStorage.setItem('audience', who); } catch (e) {}
  };
  let saved: string | null = null;
  try { saved = localStorage.getItem('audience'); } catch (e) {}
  if (saved === 'student' || saved === 'parent' || saved === 'teacher') apply(saved);

  opts.forEach((o) => {
    o.addEventListener('click', () => {
      const who = o.dataset.who!;
      save(who);
      apply(who);
      if (who === 'student') {
        document.querySelector('[data-susan-stage]')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  });
</script>

<style>
  .who-opt {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    border-radius: 1rem;
    padding: 0.75rem 0.875rem;
    text-align: left;
    background: white;
    box-shadow: 0 1px 2px rgb(31 29 26 / 0.08), inset 0 0 0 1px rgb(31 29 26 / 0.08);
    transition: box-shadow 200ms, transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .who-opt:hover { transform: translateY(-2px); box-shadow: 0 6px 16px -6px rgb(31 29 26 / 0.18), inset 0 0 0 1px rgb(31 29 26 / 0.1); }
  .who-opt.is-chosen { box-shadow: 0 1px 2px rgb(31 29 26 / 0.08), inset 0 0 0 2px rgb(31 29 26 / 0.7); }
  .who-title { font-size: 0.9375rem; font-weight: 700; color: rgb(31 29 26); }
  .who-sub { font-size: 0.75rem; line-height: 1.3; color: rgb(107 102 93); }
  @media (prefers-reduced-motion: reduce) {
    .who-opt, .who-opt:hover { transition: none; transform: none; }
  }

  .home-hero {
    grid-template-areas: 'intro' 'stage' 'panel';
  }
  @media (min-width: 1024px) {
    .home-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      grid-template-areas:
        'intro stage'
        'panel stage';
    }
  }
</style>
