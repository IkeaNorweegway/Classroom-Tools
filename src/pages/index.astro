---
import BaseLayout from '../layouts/BaseLayout.astro';
import LazySusan from '../components/LazySusan.astro';
---

<BaseLayout
  title="Classroom materials"
  description="Alberta curriculum classroom materials — Grade 6 Science, Grade 7 Science, Math 9, Social 9, Social 8, and STEAM Grades 5–9"
>
  <section class="home-hero mb-14 grid items-center gap-x-10 gap-y-8 lg:gap-y-10">
    <div class="[grid-area:intro] self-end">
      <p class="rise mb-5 text-sm font-semibold text-slate-500" style="--i: 0">Alberta curriculum · Grades 5 to 9</p>
      <h1 class="rise font-display text-[2.75rem] sm:text-[4rem] leading-[0.98] font-medium tracking-[-0.03em] text-slate-900" style="--i: 1">
        Classroom materials, <span class="italic font-normal text-slate-500">all in one place.</span>
      </h1>
      <p class="rise mt-6 max-w-[46ch] text-lg leading-relaxed text-slate-600" style="--i: 2">
        Notes, workbooks, practice and answer keys for Mr. Bremness's classes. Pick a course on the table to begin.
      </p>
    </div>

    <LazySusan />
  </section>

  <a
    href="https://drive.google.com/drive/folders/1vvIuLJxxR6xu3ZQiNPvW0tNapQzEqPR5"
    target="_blank"
    rel="noopener noreferrer"
    class="lift rise group flex items-center gap-4 rounded-2xl px-5 py-4 sm:px-6"
    style="--i: 6"
  >
    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-slate-600 shadow-[inset_0_1px_0_white,inset_0_0_0_1px_rgb(31_29_26/0.08)]">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="4.5" y="10.5" width="15" height="10" rx="2.5" />
        <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" />
      </svg>
    </span>
    <span class="min-w-0 flex-1">
      <span class="block text-[0.9375rem] font-semibold text-slate-800">Teacher materials: tests and answer keys</span>
      <span class="block text-sm text-slate-500">Google Drive folder. Sign-in and permission required.</span>
    </span>
    <span class="arrow shrink-0 text-slate-500" aria-hidden="true">↗</span>
  </a>
</BaseLayout>

<style>
  .home-hero {
    grid-template-areas: 'intro' 'stage' 'panel';
  }
  @media (min-width: 1024px) {
    .home-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      grid-template-areas:
        'intro stage'
        'panel stage';
    }
  }
</style>
