---
import BaseLayout from '../layouts/BaseLayout.astro';
import { courses } from '../data/courses';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Classroom materials"
  description="Alberta curriculum classroom materials — Grade 6 Science, Grade 7 Science, Math 9, Social 9, Social 8, and STEAM Grades 5–9"
>
  <section class="mb-14 sm:mb-20 max-w-3xl">
    <p class="rise mb-5 text-sm font-semibold text-slate-500" style="--i: 0">Alberta curriculum · Grades 5 to 9</p>
    <h1 class="rise font-display text-[3rem] sm:text-[4.5rem] leading-[0.98] font-medium tracking-[-0.03em] text-slate-900" style="--i: 1">
      Classroom materials, <span class="italic font-normal text-slate-500">all in one place.</span>
    </h1>
    <p class="rise mt-7 max-w-[52ch] text-lg sm:text-xl leading-relaxed text-slate-600" style="--i: 2">
      Notes, workbooks, practice and answer keys for Mr. Bremness's classes. Pick a course to begin.
    </p>
  </section>

  <section aria-labelledby="courses-heading">
    <h2 id="courses-heading" class="sr-only">Courses</h2>
    <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5">
      {courses.map((c, i) => (
        <li class="rise" style={`--i: ${i + 3}`} data-course={c.key}>
          <a
            href={`${base}${c.path}`}
            class="tile group relative flex h-full flex-col rounded-2xl border border-slate-900/[0.07] bg-[rgb(var(--surface))] p-6 sm:p-7"
          >
            <span class="pointer-events-none absolute inset-0 overflow-hidden rounded-[inherit]" aria-hidden="true">
              <span class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-[radial-gradient(closest-side,rgb(var(--accent-soft))_0%,rgb(var(--accent-soft)/0.6)_45%,transparent_100%)]"></span>
            </span>

            <span class="relative flex items-start justify-between gap-4">
              <span
                class="font-display text-[3.75rem] leading-[0.85] font-medium tracking-tight text-accent tabular"
                style={`view-transition-name: course-num-${c.key}`}
                aria-hidden="true"
              >{c.numeral}</span>
              <span class="arrow mt-1 text-xl text-accent" aria-hidden="true">→</span>
            </span>

            <span class="relative mt-8 block text-[0.8125rem] font-semibold text-accent-ink">{c.grade}</span>
            <span class="relative mt-1 block font-display text-[1.75rem] leading-tight font-medium tracking-[-0.01em] text-slate-900">{c.name}</span>
            <span class="relative mt-2.5 block flex-1 max-w-[44ch] text-[0.9375rem] leading-relaxed text-slate-600">{c.blurb}</span>

            <span class="relative mt-6 flex flex-wrap gap-x-3 gap-y-1 text-[0.8125rem] font-semibold text-slate-500 tabular">
              {c.facts.map((f, j) => (
                <>
                  {j > 0 && <span class="text-slate-300" aria-hidden="true">·</span>}
                  <span>{f}</span>
                </>
              ))}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <a
    href="https://drive.google.com/drive/folders/1vvIuLJxxR6xu3ZQiNPvW0tNapQzEqPR5"
    target="_blank"
    rel="noopener noreferrer"
    class="rise row group mt-10 flex items-center gap-4 rounded-2xl border border-dashed border-slate-900/15 px-5 py-4 sm:px-6"
    style="--i: 9"
  >
    <svg class="h-5 w-5 shrink-0 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="4.5" y="10.5" width="15" height="10" rx="2.5" />
      <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" />
    </svg>
    <span class="min-w-0 flex-1">
      <span class="block text-[0.9375rem] font-semibold text-slate-800">Teacher materials: tests and answer keys</span>
      <span class="block text-sm text-slate-500">Google Drive folder. Sign-in and permission required.</span>
    </span>
    <span class="arrow shrink-0 text-slate-500" aria-hidden="true">↗</span>
  </a>
</BaseLayout>
