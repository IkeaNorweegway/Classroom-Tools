---
// Grade 6 Science student unit page (shared StudentUnit layout). Materials
// come from src/data/science6.ts; the intro from src/content/units/. The
// year review has no intro file and uses a short description instead.
import StudentUnit from '../../components/StudentUnit.astro';
import { getEntry } from 'astro:content';
import { science6 as m } from '../../data/science6';

export function getStaticPaths() {
  return m.units.map((u, i) => ({ params: { unit: u.slug }, props: { i } }));
}

const { i } = Astro.props as { i: number };
const u = m.units[i];
const entry = u.slug === 'year-review' ? undefined : await getEntry('units', u.slug);
if (u.slug !== 'year-review' && !entry) throw new Error(`units/${u.slug}.md is missing`);
const Content = entry ? (await entry.render()).Content : undefined;
const base = import.meta.env.BASE_URL;
---

<StudentUnit
  manifest={m}
  unit={u}
  title={`${u.label} — Grade 6 Science`}
  eyebrow={u.slug === 'year-review' ? 'Grade 6 Science · All six units' : `Grade 6 Science · Unit ${i + 1}`}
  back={{ href: `${base}materials`, label: 'Grade 6 Science' }}
  intro={entry?.data}
  Content={Content}
  description="Everything from the year in one place: a notes package covering all six units and a mixed practice workbook."
  hasParentGuide={u.slug !== 'year-review'}
  prev={m.units[i - 1]}
  next={m.units[i + 1]}
/>
