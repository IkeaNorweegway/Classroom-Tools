---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseHero from '../../components/CourseHero.astro';
import { writingPrompts, mathQuestions } from '../../data/morning-routine';
const base = import.meta.env.BASE_URL;

// CNN 10 channel uploads playlist (UU prefix, long-form only). Plays the newest episode first,
// so this part of the page never needs updating for a new day.
const playlist = 'UULFTOoRgpHTjAQPk6Ak70u-pA';
const channelUrl = 'https://www.youtube.com/cnn10';

const questions = [
  {
    prompt: 'Pick one claim or fact from today\'s episode. What evidence did the show give for it, and how much do you trust that evidence? Why?',
    starter: 'The show claims ___. The evidence for this is ___. I trust it because ___.',
  },
  {
    prompt: 'Who is affected by this story, and who might see it differently? Explain one point of view that isn\'t the one the show focused on.',
    starter: 'This story affects ___. Someone who might see it differently is ___, because ___.',
  },
  {
    prompt: 'What question does this story leave you asking, and how could you find out the answer? Describe where you would look and what would change your mind.',
    starter: 'I am still wondering ___. I could find out by ___. If I learned ___, I would change my mind.',
  },
];

const days = writingPrompts.length;
---

<BaseLayout
  title="Morning routine"
  description="A new photo to write about, a new open-middle math question, and CNN 10 to watch and think about. Something new every school day."
>
  <CourseHero
    eyebrow="Start of class"
    title="Morning routine"
    description="Watch, write, and solve something new every school day. Explain your reasoning, not just what you remember."
  />

  <div class="print:hidden mb-8 flex flex-wrap items-center justify-between gap-3">
    <p class="text-[0.9375rem] text-slate-600">
      Today's set: <span id="day-label" class="font-semibold text-slate-800">1 of {days}</span>
    </p>
    <div class="flex gap-2">
      <button type="button" id="prev-btn" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-semibold text-slate-700 hover:bg-slate-100">Previous</button>
      <button type="button" id="random-btn" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-semibold text-slate-700 hover:bg-slate-100">Random</button>
      <button type="button" id="next-btn" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-semibold text-slate-700 hover:bg-slate-100">Next</button>
    </div>
  </div>

  <section aria-labelledby="watch-heading" class="mb-14">
    <h2 id="watch-heading" class="mb-4 text-xl font-semibold text-slate-800">1. Watch and think</h2>

    <div class="print:hidden mb-6 aspect-video w-full overflow-hidden rounded-2xl bg-slate-900 shadow-sm">
      <iframe
        class="h-full w-full"
        src={`https://www.youtube-nocookie.com/embed/videoseries?list=${playlist}`}
        title="CNN 10 newest episode"
        loading="lazy"
        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>

    <p class="print:hidden mb-8 text-[0.9375rem] text-slate-600">
      Can't see the video here? <a class="font-semibold text-slate-800 underline underline-offset-2" href={channelUrl} target="_blank" rel="noopener noreferrer">Watch CNN 10 on YouTube</a>.
    </p>

    <ol class="space-y-8">
      {questions.map((q, i) => (
        <li class="raised rounded-2xl p-6">
          <p class="mb-3 text-[0.9375rem] font-semibold text-slate-900">
            <span class="mr-2 text-slate-500">{i + 1}.</span>{q.prompt}
          </p>
          <p class="mb-4 text-sm italic text-slate-500">Starter: {q.starter}</p>
          <div class="space-y-6" aria-hidden="true">
            <div class="h-px bg-slate-300"></div>
            <div class="h-px bg-slate-300"></div>
            <div class="h-px bg-slate-300"></div>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="write-heading" class="mb-14">
    <h2 id="write-heading" class="mb-2 text-xl font-semibold text-slate-800">2. Write</h2>
    <p class="mb-6 text-[0.9375rem] text-slate-600">Look at the photo. Answer in 2 to 5 sentences. The sentence starter is there if you need it.</p>

    {writingPrompts.map((w, i) => (
      <article class="day-item raised rounded-2xl p-6" data-day={i} hidden={i !== 0}>
        <figure class="mb-5">
          <img
            src={`${base}morning-routine/${w.file}`}
            alt={w.alt}
            loading={i === 0 ? 'eager' : 'lazy'}
            class="mx-auto max-h-[28rem] w-auto max-w-full rounded-xl object-contain"
          />
          <figcaption class="mt-2 text-center text-xs text-slate-500">
            Photo: {w.credit}. <a class="underline underline-offset-2" href={w.source} target="_blank" rel="noopener noreferrer">Source</a>
          </figcaption>
        </figure>
        <p class="mb-3 text-[0.9375rem] font-semibold text-slate-900">{w.prompt}</p>
        <p class="mb-4 text-sm italic text-slate-500">Starter: {w.starter}</p>
        <div class="space-y-6" aria-hidden="true">
          <div class="h-px bg-slate-300"></div>
          <div class="h-px bg-slate-300"></div>
          <div class="h-px bg-slate-300"></div>
        </div>
      </article>
    ))}
  </section>

  <section aria-labelledby="math-heading">
    <h2 id="math-heading" class="mb-2 text-xl font-semibold text-slate-800">3. Math: open middle</h2>
    <p class="mb-6 text-[0.9375rem] text-slate-600">Fill the empty boxes. Unless the question says otherwise, use each digit from 1 to 9 once. There is more than one way to fill the boxes, so try a few and compare.</p>

    {mathQuestions.map((m, i) => (
      <article class="day-item raised rounded-2xl p-6" data-day={i} hidden={i !== 0}>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">{m.strand}</p>
        <p class="mb-5 text-[1.0625rem] leading-relaxed text-slate-900">
          {m.text.split('{}').map((part, j, arr) => (
            <>
              {part}
              {j < arr.length - 1 && <span class="mx-1 inline-block h-7 w-10 rounded border-2 border-slate-400 align-middle" aria-hidden="true"></span>}
            </>
          ))}
        </p>
        <div class="mb-5 space-y-6" aria-hidden="true">
          <div class="h-px bg-slate-300"></div>
          <div class="h-px bg-slate-300"></div>
        </div>
        <details class="rounded-xl bg-slate-50 p-4 text-[0.9375rem] text-slate-700">
          <summary class="cursor-pointer font-semibold text-slate-800">Check</summary>
          <p class="mt-3"><span class="font-semibold">Answer:</span> {m.answer}</p>
          <p class="mt-2"><span class="font-semibold">One way to get it:</span> {m.example}</p>
        </details>
      </article>
    ))}
  </section>

  <script>
    // Picks today's item from the date (one item per school day, weekends show Friday's),
    // then lets anyone step through the bank. Item 1 is the no-JavaScript fallback.
    const DAYS = 50;
    const START = new Date(2026, 8, 1); // first day of the rotation, local time

    function todayIndex(now: Date): number {
      const d = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      if (d.getDay() === 6) d.setDate(d.getDate() - 1);
      if (d.getDay() === 0) d.setDate(d.getDate() - 2);
      if (d < START) return 0;
      let count = 0;
      const cur = new Date(START);
      while (cur <= d) {
        if (cur.getDay() !== 0 && cur.getDay() !== 6) count++;
        cur.setDate(cur.getDate() + 1);
      }
      return (count - 1) % DAYS;
    }

    const items = Array.from(document.querySelectorAll<HTMLElement>('.day-item'));
    const label = document.getElementById('day-label');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const randomBtn = document.getElementById('random-btn');

    // The writing and math banks each hold DAYS items, so index i pairs them: the same i appears in both.
    function show(index: number) {
      const i = ((index % DAYS) + DAYS) % DAYS;
      items.forEach((el) => {
        el.hidden = Number(el.dataset.day) !== i;
      });
      if (label) label.textContent = `${i + 1} of ${DAYS}`;
      current = i;
    }

    let current = todayIndex(new Date());
    show(current);

    prevBtn?.addEventListener('click', () => show(current - 1));
    nextBtn?.addEventListener('click', () => show(current + 1));
    randomBtn?.addEventListener('click', () => show(Math.floor(Math.random() * DAYS)));
  </script>
</BaseLayout>
