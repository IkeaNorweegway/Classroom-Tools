---
import Nav from '../../../components/Nav.astro';
import { allViewPaths, backPathFor } from '../../../data/math9';
const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  // Every Math 9 document, from the manifest. Warn at build time about any
  // listed file that is missing from public/materials/math-9/.
  const { existsSync } = await import('node:fs');
  const paths = allViewPaths();
  for (const p of paths) {
    if (!existsSync(`public/materials/math-9/${p}.html`)) console.warn(`[math9] missing material: ${p}.html`);
  }
  return paths.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const fileUrl = `${base}materials/math-9/${slug}.html`;
// Simulations and trainers fill the window: no site nav, a slim back bar, a full-screen button.
const isApp = /-(sim|trainer)-v\d+$/.test(slug!);
const backHref = `${base}${backPathFor(slug!)}`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Math 9 — {slug}</title>
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <style>
    html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; }
    .viewer-shell { display: flex; flex-direction: column; height: 100vh; }
    .back-bar { background: #f6f4ef; border-bottom: 1px solid rgb(31 29 26 / 0.07); padding: 0.6rem 1.25rem; flex-shrink: 0; }
    .back-bar a { font-family: 'Atkinson Hyperlegible Next Variable', system-ui, sans-serif;
      font-weight: 600; font-size: 0.875rem; color: #6b665d; text-decoration: none; }
    .back-bar a:hover { color: #1f1d1a; }
    .doc-frame { flex: 1; border: none; width: 100%; display: block; }
    @media print {
      .viewer-nav, .back-bar { display: none !important; }
      .doc-frame { height: 100vh; }
    }
    .back-bar.app { background: #0f1520; border-bottom-color: #263246; padding: 0.3rem 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .back-bar.app a { color: #a7b4c8; }
    .back-bar.app a:hover { color: #f5f7fb; }
    .fs-btn { font: 600 0.8rem system-ui, sans-serif; color: #a7b4c8; background: #151d2b; border: 1px solid #263246; border-radius: 8px; padding: 0.3rem 0.75rem; cursor: pointer; }
    .fs-btn:hover { color: #f5f7fb; border-color: #58c4dd; }
  </style>
</head>
<body>
  <div class="viewer-shell">
    {!isApp && (
      <div class="viewer-nav">
        <Nav course="math9" />
      </div>
    )}
    <div class:list={['back-bar', { app: isApp }]}>
      <a href={backHref}>← Back</a>
      {isApp && <button type="button" id="fs-btn" class="fs-btn">⛶ Full screen</button>}
    </div>
    <iframe src={fileUrl} class="doc-frame" title={slug} allowfullscreen />
  </div>
  <script is:inline>
    var fsBtn = document.getElementById('fs-btn');
    if (fsBtn) fsBtn.addEventListener('click', function () {
      var f = document.querySelector('.doc-frame'), go = f.requestFullscreen || f.webkitRequestFullscreen;
      if (go) go.call(f);
    });
  </script>
  <script is:inline>
    // Pass a section id (#s3) on to the document, so a link can open one notes section.
    (function () {
      var f = document.querySelector('.doc-frame');
      function go() { if (f && location.hash) f.src = f.src.split('#')[0] + location.hash; }
      go();
      window.addEventListener('hashchange', go);
    })();
  </script>
</body>
</html>
