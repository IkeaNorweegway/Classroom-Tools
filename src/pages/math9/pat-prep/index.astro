---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ActionCard from '../../../components/ActionCard.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout course="math9" title="PAT Prep — Math 9">

  <div class="mb-8">
    <p class="text-xs font-bold uppercase tracking-widest text-math9-600 mb-2">Math 9</p>
    <h1 class="text-3xl font-bold text-slate-900 mb-2">PAT Prep</h1>
    <p class="text-slate-500">Practice questions at Provincial Achievement Test level. Both multiple choice and numerical response formats.</p>
  </div>

  <div class="grid sm:grid-cols-2 gap-4">
    <!-- Released PAT items by strand, each word problem with a picture of its story -->
    <ActionCard
      href={`${base}math9/view/practice/math9-pat-questions-trainer-v1`}
      title="PAT Questions"
      description="Released PAT questions from 2013, 2015 and 2019, plus new ones like them. One tab per strand: Number, Patterns, Shape & Space, Stats & Probability, then a mixed round weighted like the PAT. Every word problem has a picture."
      cta="Start the questions"
    />
    <!-- Word problem trainer: one PAT problem type per tab, each with a picture -->
    <ActionCard
      href={`${base}math9/view/practice/math9-pat-trainer-v1`}
      title="Word Problems Trainer"
      description="Ten PAT-style word problem types, each with a picture of the story: trips, bills, saving up, budgets, shares, two plans, ladders, painting a box, and predicting from a sample. Then a mixed round."
      cta="Start the trainer"
    />
  </div>

</BaseLayout>
