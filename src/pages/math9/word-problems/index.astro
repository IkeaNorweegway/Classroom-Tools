---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WordProblems from '../../../components/WordProblems.astro';
import ActionCard from '../../../components/ActionCard.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout course="math9" title="Word Problems — Math 9">
  <div class="mb-8">
    <p class="text-xs font-bold uppercase tracking-widest text-math9-600 mb-2">Math 9</p>
    <h1 class="text-3xl font-bold text-slate-900 mb-2">Word Problems</h1>
    <p class="text-slate-500 max-w-2xl">
      Use the trainer to practise word problems on screen, with a picture, the steps and a hint for each one.
      Use the worksheets below when you want a printed set with an answer key.
    </p>
  </div>

  <div class="grid sm:grid-cols-2 gap-4 mb-10">
    <ActionCard
      href={`${base}math9/view/practice/math9-word-problems-trainer-v1`}
      title="Word Problems Trainer"
      description="Short stories for each topic. Every round of 10 goes from one-step to two-step to three-step problems, with a picture of the story, the steps, and a hint when an answer is off."
      cta="Practise"
    />
  </div>

  <h2 class="text-lg font-bold text-slate-900 mb-1">Printable worksheets</h2>
  <p class="text-sm text-slate-500 mb-4">Pick a topic and level, or print a worksheet with an answer key.</p>
  <WordProblems courseName="Math 9" />
</BaseLayout>

<script>
  import { initWordProblems } from '../../../scripts/word-problems/engine.js';
  import { MATH9_TOPICS } from '../../../scripts/word-problems/math9.js';
  initWordProblems({ topics: MATH9_TOPICS, storageKey: 'math9-word-problems', courseName: 'Math 9' });
</script>
