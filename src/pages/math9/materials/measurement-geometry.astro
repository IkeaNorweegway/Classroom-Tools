---
import Collapsible from '../../../components/Collapsible.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseHero from '../../../components/CourseHero.astro';
import MaterialRow from '../../../components/MaterialRow.astro';
import { getEntry } from 'astro:content';
const base = import.meta.env.BASE_URL;
const b = base;

function viewHref(path: string) { return `${b}math9/view/${path}`; }

const topics = [
  { label: 'Circle Geometry',       slug: 'circle-geometry', noteSlug: 'math9-circle-geometry-notes-v1',    wsSlug: 'math9-circle-geometry',  exitSlug: 'math9-circle-geometry-exits-v1' },
  { label: 'Surface Area & Volume', slug: 'measurement',     noteSlug: 'math9-measurement-notes-v1',        wsSlug: 'math9-measurement',       exitSlug: 'math9-measurement-exits-v1' },
  { label: 'Similarity & Scale',    slug: 'similarity',      noteSlug: 'math9-similarity-notes-v1',         wsSlug: 'math9-similarity',        exitSlug: 'math9-similarity-exits-v1' },
];

const topicUnits = await Promise.all(
  topics.map(async t => {
    const entry = await getEntry('math9-units', t.slug);
    return entry ? { ...await entry.render(), data: entry.data } : null;
  })
);
---

<BaseLayout course="math9" title="Measurement & Geometry — Math 9 Materials">
  <CourseHero
    back={{ href: `${b}math9/materials`, label: 'All strands' }}
    eyebrow="Grade 9 Mathematics · Measurement & Geometry strand"
    title="Measurement & Geometry"
    description="Circle Geometry · Surface Area & Volume · Similarity & Scale"
  />

  <div class="raised mb-12 rounded-2xl p-6" style="background: linear-gradient(160deg, rgb(var(--accent-soft)), rgb(255 255 255) 80%)">
    <p class="mb-1.5 text-sm font-semibold text-accent-ink">Strand focus</p>
    <p class="max-w-[68ch] text-slate-800 leading-relaxed">Chord and tangent properties of circles, surface area and volume of composite 3D objects, and similar triangles with scale diagrams and factors.</p>
  </div>

  <section class="mb-10">
    <h2 class="mb-4 font-display text-[1.375rem] font-medium tracking-[-0.01em] text-slate-900">Strand workbook</h2>
    <div class="grid gap-3">
      <MaterialRow label="Measurement & Geometry — Strand Workbook" href={viewHref(`worksheets/measurement-geometry/math9-measurement-geometry-workbook-v1`)} />
    </div>
    <details class="disclosure mt-4">
      <summary class="keys-toggle">
          <span class="chev inline-block text-[0.625rem]" aria-hidden="true">▶</span> Workbook answer key
      </summary>
      <div class="mt-2">
        <MaterialRow label="M&G Workbook Answer Key" href={viewHref(`worksheets/measurement-geometry/math9-measurement-geometry-workbook-answers-v1`)} type="key" compact />
      </div>
    </details>
  </section>

  {topics.map((t, i) => {
    const unit = topicUnits[i];
    const TopicContent = unit?.Content;
    return (
    <section class="mb-12">
      <h2 class="mb-3 flex items-center gap-3"><span class="num-chip font-display tabular" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span class="font-display text-[1.75rem] font-medium tracking-[-0.015em] text-slate-900">{t.label}</span></h2>
      {unit && TopicContent && (
        <div class="mb-5">
          <p class="mb-4 italic text-slate-600">{unit.data.guidingQuestion}</p>
          <div class="raised mb-4 rounded-xl p-4">
            <p class="mb-1 text-sm font-semibold text-accent-ink">Learning outcome</p>
            <p class="text-slate-700 text-sm">{unit.data.learningOutcome}</p>
          </div>
          <Collapsible label="this topic">
            <div class="prose prose-slate prose-sm max-w-none">
              <TopicContent />
            </div>
          </Collapsible>
        </div>
      )}
      <div class="grid gap-3 sm:grid-cols-2 mb-5">
        {[
          { label: 'Guided Notes',      badge: 'Notes',     badgeStyle: 'bg-green-100 text-green-800', href: viewHref(`notes/${t.slug}/${t.noteSlug}`) },
          { label: 'Concept Reference', badge: 'Reference', badgeStyle: 'bg-slate-100 text-slate-700', href: viewHref(`worksheets/measurement-geometry/${t.slug}/${t.wsSlug}-concepts-v1`) },
          { label: 'Core Practice',     badge: '★',         badgeStyle: 'bg-green-100 text-green-800', href: viewHref(`worksheets/measurement-geometry/${t.slug}/${t.wsSlug}-worksheet-core-v1`) },
          { label: 'Challenge',         badge: '★★',        badgeStyle: 'bg-green-100 text-green-800', href: viewHref(`worksheets/measurement-geometry/${t.slug}/${t.wsSlug}-worksheet-challenge-v1`) },
          { label: 'Exit Tickets',      badge: 'Formative', badgeStyle: 'bg-slate-100 text-slate-700', href: viewHref(`exits/${t.slug}/${t.exitSlug}`) },
        ].map(item => (
          <MaterialRow label={item.label} badge={['Notes', 'Reference', 'Interactive'].includes(item.badge) ? undefined : item.badge} href={item.href} />
        ))}
      </div>
      <details class="disclosure mt-1">
        <summary class="keys-toggle">
          <span class="chev inline-block text-[0.625rem]" aria-hidden="true">▶</span> Show answer keys
        </summary>
        <div class="mt-4 grid gap-2.5 sm:grid-cols-2">
          {[
            { label: 'Notes Answer Key',          path: `notes/${t.slug}/${t.noteSlug.replace('-notes-v1','-notes-answers-v1')}` },
            { label: 'Core Worksheet Answer Key',  path: `worksheets/measurement-geometry/${t.slug}/${t.wsSlug}-worksheet-core-answers-v1` },
            { label: 'Challenge Answer Key',       path: `worksheets/measurement-geometry/${t.slug}/${t.wsSlug}-worksheet-challenge-answers-v1` },
          ].map(ak => (
            <MaterialRow label={ak.label} href={viewHref(ak.path)} type="key" compact />
          ))}
        </div>
      </details>
    </section>
    );
  })}
</BaseLayout>
