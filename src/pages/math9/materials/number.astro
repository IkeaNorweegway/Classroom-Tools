---
import Collapsible from '../../../components/Collapsible.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseHero from '../../../components/CourseHero.astro';
import MaterialRow from '../../../components/MaterialRow.astro';
import { getEntry } from 'astro:content';
const base = import.meta.env.BASE_URL;
const b = base;


type Item = { label: string; badge?: string; badgeStyle?: string; href: string };
type Section = { heading: string; items: Item[] };

function viewHref(path: string) {
  return `${b}math9/view/${path}`;
}

const topics: { label: string; slug: string; noteSlug: string; wsSlug: string; exitSlug: string }[] = [
  { label: 'Rational Numbers',    slug: 'rational-numbers',  noteSlug: 'math9-rational-numbers-notes-v1',    wsSlug: 'math9-rational-numbers', exitSlug: 'math9-rational-numbers-exits-v1' },
  { label: 'Square Roots',        slug: 'square-roots',      noteSlug: 'math9-square-roots-notes-v1',        wsSlug: 'math9-square-roots',     exitSlug: 'math9-square-roots-exits-v1' },
  { label: 'Powers & Exponents',  slug: 'powers-exponents',  noteSlug: 'math9-powers-notes-v1',              wsSlug: 'math9-powers',           exitSlug: 'math9-powers-exits-v1' },
];

const topicUnits = await Promise.all(
  topics.map(async t => {
    const entry = await getEntry('math9-units', t.slug);
    return entry ? { ...await entry.render(), data: entry.data } : null;
  })
);
---

<BaseLayout course="math9" title="Number — Math 9 Materials">
  <CourseHero
    back={{ href: `${b}math9/materials`, label: 'All strands' }}
    eyebrow="Grade 9 Mathematics · Number strand"
    title="Number"
    description="Rational Numbers · Square Roots · Powers & Exponents"
  />

  <div class="raised mb-12 rounded-2xl p-6" style="background: linear-gradient(160deg, rgb(var(--accent-soft)), rgb(255 255 255) 80%)">
    <p class="mb-1.5 text-sm font-semibold text-accent-ink">Strand focus</p>
    <p class="max-w-[68ch] text-slate-800 leading-relaxed">Operations with rational numbers, estimating and calculating square roots, the Pythagorean theorem, and the full set of exponent laws — including product, quotient, power, and zero exponents.</p>
  </div>

  <!-- Strand workbook -->
  <section class="mb-10">
    <h2 class="mb-4 font-display text-[1.375rem] font-medium tracking-[-0.01em] text-slate-900">Strand workbook</h2>
    <div class="grid gap-3">
      <MaterialRow label="Number — Strand Workbook" href={viewHref(`worksheets/number/math9-number-workbook-v1`)} />
    </div>
    <details class="disclosure mt-4">
      <summary class="keys-toggle">
          <span class="chev inline-block text-[0.625rem]" aria-hidden="true">▶</span> Workbook answer key
      </summary>
      <div class="mt-4 grid gap-2.5 sm:grid-cols-2">
        <MaterialRow label="Number Workbook Answer Key" href={viewHref(`worksheets/number/math9-number-workbook-answers-v1`)} type="key" compact />
      </div>
    </details>
  </section>

  <!-- Per-topic sections -->
  {topics.map((t, i) => {
    const unit = topicUnits[i];
    const TopicContent = unit?.Content;
    return (
    <section class="mb-12">
      <h2 class="mb-3 flex items-center gap-3"><span class="num-chip font-display tabular" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span class="font-display text-[1.75rem] font-medium tracking-[-0.015em] text-slate-900">{t.label}</span></h2>
      {unit && TopicContent && (
        <div class="mb-5">
          <p class="mb-4 italic text-slate-600">{unit.data.guidingQuestion}</p>
          <div class="raised mb-4 rounded-xl p-4">
            <p class="mb-1 text-sm font-semibold text-accent-ink">Learning outcome</p>
            <p class="text-slate-700 text-sm">{unit.data.learningOutcome}</p>
          </div>
          <Collapsible label="this topic">
            <div class="prose prose-slate prose-sm max-w-none">
              <TopicContent />
            </div>
          </Collapsible>
        </div>
      )}
      <div class="grid gap-3 sm:grid-cols-2 mb-5">
        <!-- Notes -->
        <MaterialRow label="Guided Notes" href={viewHref(`notes/${t.slug}/${t.noteSlug}`)} />
        <!-- Concept page -->
        <MaterialRow label="Concept Reference" href={viewHref(`worksheets/number/${t.slug}/${t.wsSlug}-concepts-v1`)} />
        <!-- Fraction simulator -->
        {t.slug === 'rational-numbers' && (
        <MaterialRow label="Fraction Simulator (equivalent fractions, simplifying, cross-cancelling)" href={viewHref('practice/math9-fraction-sim-v1')} />
        )}
        <!-- Core worksheet -->
        <MaterialRow label="Core Practice" href={viewHref(`worksheets/number/${t.slug}/${t.wsSlug}-worksheet-core-v1`)} badge="★" />
        <!-- Extra practice worksheet -->
        {t.slug === 'rational-numbers' && (
        <MaterialRow label="Extra Practice" href={viewHref(`worksheets/number/${t.slug}/${t.wsSlug}-worksheet-extra-v1`)} badge="★" />
        )}
        <!-- Challenge worksheet -->
        <MaterialRow label="Challenge" href={viewHref(`worksheets/number/${t.slug}/${t.wsSlug}-worksheet-challenge-v1`)} badge="★★" />
        <!-- Exit tickets -->
        <MaterialRow label="Exit Tickets" href={viewHref(`exits/${t.slug}/${t.exitSlug}`)} badge="Formative" />
        <!-- Practice test -->
        {t.slug === 'rational-numbers' && (
        <MaterialRow label="Practice Test" href={viewHref(`tests/${t.slug}/${t.wsSlug}-practice-test-v1`)} badge="Test prep" />
        )}

      </div>

      <!-- Answer keys collapsible -->
      <details class="disclosure mt-1">
        <summary class="keys-toggle">
          <span class="chev inline-block text-[0.625rem]" aria-hidden="true">▶</span> Show answer keys
        </summary>
        <div class="mt-4 grid gap-2.5 sm:grid-cols-2">
          {[
            { label: 'Notes Answer Key', path: `notes/${t.slug}/${t.noteSlug.replace('-notes-v1', '-notes-answers-v1')}` },
            { label: 'Core Worksheet Answer Key', path: `worksheets/number/${t.slug}/${t.wsSlug}-worksheet-core-answers-v1` },
            ...(t.slug === 'rational-numbers' ? [{ label: 'Extra Practice Answer Key', path: `worksheets/number/${t.slug}/${t.wsSlug}-worksheet-extra-answers-v1` }] : []),
            { label: 'Challenge Answer Key', path: `worksheets/number/${t.slug}/${t.wsSlug}-worksheet-challenge-answers-v1` },
            ...(t.slug === 'rational-numbers' ? [{ label: 'Practice Test Answer Key', path: `tests/${t.slug}/${t.wsSlug}-practice-test-answers-v1` }] : []),
          ].map(ak => (
            <MaterialRow label={ak.label} href={viewHref(ak.path)} type="key" compact />
          ))}
        </div>
      </details>
    </section>
    );
  })}

</BaseLayout>
