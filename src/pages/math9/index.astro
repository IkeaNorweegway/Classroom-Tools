---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseHero from '../../components/CourseHero.astro';
import TopicList from '../../components/TopicList.astro';
import ActionCard from '../../components/ActionCard.astro';
import { strands, topics, topicsInStrand, math9Course } from '../../data/math9';
import { materialCount } from '../../data/manifest';
const base = import.meta.env.BASE_URL;
// The same three facts as the other courses' landing pages, all read from the data.
const materials = materialCount(math9Course.units);

// One card per strand; each strand page lists its topics, workbook and project.
const descriptions: Record<string, string> = {
  number: 'Operations with rational numbers, estimating square roots, the Pythagorean theorem, and the full exponent law set.',
  algebra: 'Slope, y = mx + b, solving multi-step equations, graphing inequalities, and multiplying polynomials.',
  'measurement-geometry': 'Chord and tangent properties, composite 3D objects, similar triangles, and scale diagrams.',
  'statistics-probability': 'Correlation, lines of best fit, interpolation vs. extrapolation, independent and dependent events.',
};
---

<BaseLayout course="math9" title="Grade 9 Mathematics">
  <CourseHero
    eyebrow="Alberta curriculum"
    title="Grade 9 Mathematics"
    numeral="9"
    vtName="course-num-math9"
    description="Four strands, eleven topics. Notes, concept pages, worksheets, exit tickets, and answer keys."
    facts={[
      { n: `${strands.length}`, label: 'strands' },
      { n: `${topics.length}`, label: 'topics' },
      { n: `${materials}`, label: 'materials' },
    ]}
  />

  <TopicList
    heading="Strands"
    items={strands.map((s) => ({
      art: s.slug,
      href: `${base}math9/materials/${s.slug}`,
      title: s.label,
      kicker: topicsInStrand(s.slug).map((t) => t.label).join(' · '),
      description: descriptions[s.slug],
    }))}
  />

  <div class="grid gap-4 sm:grid-cols-2">
    <ActionCard
      href={`${base}math9/potd`}
      title="Problem of the Day"
      description="A short problem to project at the start of class. Visual patterns, estimation, number puzzles, and more."
      cta="Today's problem"
      index={4}
    />
    <ActionCard
      href={`${base}math9/pat-prep`}
      title="PAT prep"
      description="Practice at Provincial Achievement Test level: a word problems trainer with pictures, and multiple choice and numerical response by PAT strand."
      cta="Practice"
      index={5}
    />
  </div>
</BaseLayout>
