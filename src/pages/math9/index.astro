---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseHero from '../../components/CourseHero.astro';
import TopicList from '../../components/TopicList.astro';
import ActionCard from '../../components/ActionCard.astro';
import { getEntry } from 'astro:content';
import { strands, topics, topicsInStrand, math9Course } from '../../data/math9';
import { materialCount } from '../../data/manifest';
const base = import.meta.env.BASE_URL;
// The same three facts as the other courses' landing pages, all read from the data.
const materials = materialCount(math9Course.units);

// Every topic, one click away, grouped under its strand.
const groups = await Promise.all(
  strands.map(async (s) => ({
    s,
    items: await Promise.all(
      topicsInStrand(s.slug).map(async (t) => ({
        href: `${base}math9/${t.slug}`,
        title: t.label,
        description: (await getEntry('math9-units', t.slug))?.data.hook,
      })),
    ),
  })),
);
---

<BaseLayout course="math9" title="Grade 9 Mathematics">
  <CourseHero
    eyebrow="Alberta curriculum"
    title="Grade 9 Mathematics"
    numeral="9"
    vtName="course-num-math9"
    description="Eleven topics in four strands. Pick a topic to see what it’s about and work through its materials step by step."
    facts={[
      { n: `${strands.length}`, label: 'strands' },
      { n: `${topics.length}`, label: 'topics' },
      { n: `${materials}`, label: 'materials' },
    ]}
  />

  {groups.map(({ s, items }) => (
    <section id={s.slug} class="mb-4 scroll-mt-28">
      <div class="mb-1 flex items-baseline justify-between gap-4">
        <h2 class="font-display text-[1.5rem] font-medium tracking-[-0.01em] text-slate-900">{s.label}</h2>
        <div class="flex shrink-0 flex-wrap justify-end gap-x-4 gap-y-1">
          {s.project && (
            <a href={`${base}math9/view/${s.project.brief}`} class="text-sm font-semibold text-accent-ink hover:underline">Inquiry project →</a>
          )}
          <a href={`${base}math9/view/${s.workbook}`} class="text-sm font-semibold text-accent-ink hover:underline">Strand workbook →</a>
        </div>
      </div>
      <p class="mb-4 max-w-[62ch] text-slate-600">{s.blurb}</p>
      <TopicList items={items} />
    </section>
  ))}

  <div class="grid gap-4 sm:grid-cols-3">
    <ActionCard
      href={`${base}math9/practice`}
      title="Prereq practice"
      description="Warm up on the foundational skills you need before each topic. Randomized problems with worked solutions."
      cta="Practice"
      index={4}
    />
    <ActionCard
      href={`${base}math9/potd`}
      title="Problem of the Day"
      description="A short problem to project at the start of class. Visual patterns, estimation, number puzzles, and more."
      cta="Today's problem"
      index={5}
    />
    <ActionCard
      href={`${base}math9/pat-prep`}
      title="PAT prep"
      description="Practice at Provincial Achievement Test level. Multiple choice and numerical response, by PAT strand."
      cta="Practice"
      index={6}
    />
  </div>
</BaseLayout>
