const data = units[unit];
const viewHref = (href: string) =>
  href.replace(/\.html$/, '').replace(`${base}materials/`, `${base}materials/view/${unit}/`);
---

<BaseLayout title={`${data.label} — Materials`} course="science">
  <CourseHero
    back={{ href: `${base}materials`, label: 'All materials' }}
    eyebrow="Grade 6 Science"
    title={data.label}
    description={data.tagline}
  />

  {data.sections.map(section => (
    <MaterialList
      heading={section.heading}
      items={section.items.map(item => ({ label: item.label, badge: item.badge, href: viewHref(item.href) }))}
    />
  ))}

  <MaterialList
    answerKeys
    heading="Show answer keys"
    items={data.answerKeys.map(item => ({ label: item.label, href: viewHref(item.href) }))}
  />
</BaseLayout>
