---
// Old Grade 6 unit materials URL. The unit page (units/[unit]) now holds the
// materials, so this sends visitors and old links there.
import { science6 as m } from '../../data/science6';

export function getStaticPaths() {
  return m.units.map((u) => ({ params: { unit: u.slug } }));
}

const { unit } = Astro.params;
const to = `${import.meta.env.BASE_URL}${m.studentHref(unit!)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <title>Moved</title>
  </head>
  <body>
    <p>This page has moved: <a href={to}>{to}</a></p>
  </body>
</html>
