---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseHero from '../../components/CourseHero.astro';
import TopicList from '../../components/TopicList.astro';
import ActionCard from '../../components/ActionCard.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
// Cards lead with the student hook; the topic list stays as small print.
const hooks: Record<string, string> = Object.fromEntries((await getCollection('units')).map((e) => [e.slug, e.data.hook]));

const unitCards = [
  {
    slug: 'matter',
    label: 'Matter',
    description: 'Particle model, states of matter, phase changes, thermometers, expansion, and the water anomaly.',
    bg: 'bg-cyan-50', text: 'text-cyan-800', border: 'border-cyan-400', link: 'text-cyan-700', hover: 'hover:bg-cyan-100',
  },
  {
    slug: 'forces',
    label: 'Forces',
    description: 'Pushes and pulls, external and internal forces, elasticity, plasticity, and Newton\'s Third Law.',
    bg: 'bg-violet-50', text: 'text-violet-800', border: 'border-violet-400', link: 'text-violet-700', hover: 'hover:bg-violet-100',
  },
  {
    slug: 'living-systems',
    label: 'Living Systems',
    description: 'Biotic and abiotic factors, photosynthesis, food webs, trophic cascades, and Indigenous ecological knowledge.',
    bg: 'bg-emerald-50', text: 'text-emerald-800', border: 'border-emerald-400', link: 'text-emerald-700', hover: 'hover:bg-emerald-100',
  },
  {
    slug: 'climate',
    label: 'Climate',
    description: 'Weather vs. climate, greenhouse effect, causes of climate change, and Alberta-specific impacts.',
    bg: 'bg-amber-50', text: 'text-amber-800', border: 'border-amber-400', link: 'text-amber-700', hover: 'hover:bg-amber-100',
  },
  {
    slug: 'energy-resources',
    label: 'Energy Resources',
    description: 'Renewable vs. non-renewable energy, before and after processing, and the five selection factors.',
    bg: 'bg-orange-50', text: 'text-orange-800', border: 'border-orange-400', link: 'text-orange-700', hover: 'hover:bg-orange-100',
  },
  {
    slug: 'space',
    label: 'Space',
    description: 'Solar system objects, exploration technologies, satellites, orbital mechanics, and the ISS.',
    bg: 'bg-indigo-50', text: 'text-indigo-800', border: 'border-indigo-400', link: 'text-indigo-700', hover: 'hover:bg-indigo-100',
  },
];
---

<BaseLayout course="science" title="Grade 6 Science">
  <CourseHero
    eyebrow="Alberta curriculum · 2023"
    title="Grade 6 Science"
    numeral="6"
    vtName="course-num-science"
    description="Pick the unit your child is studying. You'll find notes, a practice workbook, and answer keys, all in one place."
    facts={[
      { n: '6', label: 'units' },
      { n: '~28', label: 'weeks' },
      { n: '3', label: 'versions: English, Easy Read, French' },
    ]}
  />

  <TopicList
    heading="Units"
    items={unitCards.map(u => ({ art: u.slug, href: `${base}units/${u.slug}`, title: u.label, description: hooks[u.slug] ?? u.description, meta: hooks[u.slug] ? u.description : undefined }))}
  />

  <div class="grid gap-4 sm:grid-cols-2">
    <ActionCard
      href={`${base}units/year-review`}
      title="Year review"
      description="End-of-year review covering all six units. Notes and a mixed-topic practice workbook."
      cta="View materials"
      index={6}
    />
    <ActionCard
      href={`${base}materials/fr`}
      title="Français · immersion"
      description="Notes guidées et cahiers d'exercices en français pour toutes les unités. Niveau H–I."
      cta="Voir les matériaux"
      index={7}
      lang="fr"
    />
  </div>
</BaseLayout>
