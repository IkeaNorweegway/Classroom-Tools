---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseHero from '../../components/CourseHero.astro';
import TopicList from '../../components/TopicList.astro';
import ActionCard from '../../components/ActionCard.astro';
import { getCollection } from 'astro:content';
import { science6 } from '../../data/science6';
import { materialCount, weeksRange } from '../../data/manifest';
const base = import.meta.env.BASE_URL;

// Cards lead with the student hook; the topic list stays as small print.
const units = (await getCollection('units')).sort((a, b) => a.data.order - b.data.order);
const hooks: Record<string, string> = Object.fromEntries(units.map((e) => [e.slug, e.data.hook]));

const unitCards = [
  { slug: 'matter', label: 'Matter', description: 'Particle model, states of matter, phase changes, thermometers, expansion, and the water anomaly.' },
  { slug: 'forces', label: 'Forces', description: 'Pushes and pulls, external and internal forces, elasticity, plasticity, and Newton\'s Third Law.' },
  { slug: 'living-systems', label: 'Living Systems', description: 'Biotic and abiotic factors, photosynthesis, food webs, trophic cascades, and Indigenous ecological knowledge.' },
  { slug: 'climate', label: 'Climate', description: 'Weather vs. climate, greenhouse effect, causes of climate change, and Alberta-specific impacts.' },
  { slug: 'energy-resources', label: 'Energy Resources', description: 'Renewable vs. non-renewable energy, before and after processing, and the five selection factors.' },
  { slug: 'space', label: 'Space', description: 'Solar system objects, exploration technologies, satellites, orbital mechanics, and the ISS.' },
];

// The same three facts as the other courses' landing pages, all read from the data.
const weeks = weeksRange(units.map((u) => u.data.weeks));
const materials = materialCount(science6.units);
---

<BaseLayout course="science" title="Grade 6 Science">
  <CourseHero
    eyebrow="Alberta curriculum · 2023"
    title="Grade 6 Science"
    numeral="6"
    vtName="course-num-science"
    description="Six units. Guided notes, a practice workbook, Easy Read and French versions, and answer keys."
    facts={[
      { n: `${units.length}`, label: 'units' },
      { n: weeks, label: 'weeks' },
      { n: `${materials}`, label: 'materials' },
    ]}
  />

  <TopicList
    heading="Units"
    items={unitCards.map(u => ({ art: u.slug, href: `${base}units/${u.slug}`, title: u.label, description: hooks[u.slug] ?? u.description, meta: hooks[u.slug] ? u.description : undefined }))}
  />

  <div class="grid gap-4 sm:grid-cols-2">
    <ActionCard
      href={`${base}science6/practice`}
      title="Prereq practice"
      description="Check what you need to know before each unit. Quick questions with hints and explanations."
      cta="Practice"
      index={6}
    />
    <ActionCard
      href={`${base}units/year-review`}
      title="Year review"
      description="End-of-year review covering all six units. Notes and a mixed-topic practice workbook."
      cta="View materials"
      index={7}
    />
    <ActionCard
      href={`${base}materials/fr`}
      title="Français · immersion"
      description="Notes guidées et cahiers d'exercices en français pour toutes les unités. Niveau H–I."
      cta="Voir les matériaux"
      index={8}
      lang="fr"
    />
  </div>
</BaseLayout>
