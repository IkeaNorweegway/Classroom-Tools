---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseHero from '../../components/CourseHero.astro';
import TopicList from '../../components/TopicList.astro';
import ActionCard from '../../components/ActionCard.astro';
import { getCollection } from 'astro:content';
import { social9 } from '../../data/social9';
import { materialCount } from '../../data/manifest';
const base = import.meta.env.BASE_URL;
// Cards lead with the student hook; the topic list stays as small print.
// The same three facts as the other courses' landing pages, all read from the data.
const materials = materialCount(social9.units);
const hooks: Record<string, string> = Object.fromEntries((await getCollection('social9-units')).map((e) => [e.slug, e.data.hook]));

const units = [
  {
    slug: 'urbanization-industry',
    label: 'Urbanization and the Growth of Industry',
    description: 'Push and pull factors, postwar immigration, the growth of Alberta industry, and the environmental cost of urban growth.',
    organizingIdea: 'Time and Place',
  },
  {
    slug: 'independence-democratic-rights',
    label: "Canada's Independence and Democratic Rights",
    description: 'The Balfour Declaration, the Statute of Westminster, and the Persons Case.',
    organizingIdea: 'Time and Place',
  },
  {
    slug: 'canada-in-wwii',
    label: 'Canada in the Second World War',
    description: "Canada's independent declaration of war, key battles, and the contributions of Chinese Canadians and Cree code talkers.",
    organizingIdea: 'Time and Place',
  },
  {
    slug: 'postwar-canada',
    label: 'Post-War Canada: Change, Cooperation, and Conflict',
    description: 'The welfare state, peacekeeping, multiculturalism, residential schools, Western alienation, and the Charter of Rights and Freedoms.',
    organizingIdea: 'Time and Place',
  },
  {
    slug: 'modern-economy',
    label: 'Building a Modern Economy',
    description: 'The Great Depression, government response, postwar industrial growth, and trade with the United States.',
    organizingIdea: 'Systems',
  },
  {
    slug: 'system-of-government',
    label: "Canada's System of Government",
    description: 'Responsible government, how laws are made, federalism and natural resources, and the judiciary.',
    organizingIdea: 'Systems',
  },
  {
    slug: 'evolving-citizenship',
    label: 'Evolving Citizenship and Rights',
    description: 'Canadian citizenship categories, the legislative path to the Charter, and the balance of rights and responsibilities.',
    organizingIdea: 'Citizenship',
  },
];
---

<BaseLayout course="social9" title="Social Studies 9">
  <CourseHero
    eyebrow="Alberta draft curriculum · 2026"
    title="Social Studies 9"
    numeral="9"
    vtName="course-num-social9"
    description="Seven units across Time and Place, Systems, and Citizenship. Notes, workbooks, and answer keys."
    facts={[
      { n: `${units.length}`, label: 'units' },
      { n: `${new Set(units.map((u) => u.organizingIdea)).size}`, label: 'organizing ideas' },
      { n: `${materials}`, label: 'materials' },
    ]}
  />

  <TopicList
    heading="Units"
    items={units.map(u => ({ art: u.slug, href: `${base}social9/materials/${u.slug}`, title: u.label, kicker: u.organizingIdea, description: hooks[u.slug] ?? u.description, meta: hooks[u.slug] ? u.description : undefined }))}
  />

  <div class="grid gap-4 sm:grid-cols-2">
    <ActionCard
      href={`${base}social9/practice`}
      title="Prereq practice"
      description="Check what you need to know before each unit. Quick questions with hints and explanations."
      cta="Practice"
      index={7}
    />
  </div>
</BaseLayout>
