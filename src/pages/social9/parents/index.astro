---
// Parent overview for Grade 9 Social Studies (shared ParentOverview layout).
import ParentOverview from '../../../components/ParentOverview.astro';
import { getCollection } from 'astro:content';
import { social9 as m } from '../../../data/social9';

const base = import.meta.env.BASE_URL;
const written = new Set((await getCollection('parent-guides')).map((e) => e.slug));
const groups = [{
  items: m.units.filter((u) => u.home.length > 0).map((u) => ({
    label: u.label,
    href: written.has(`social9/${u.slug}`) ? `${base}${m.parentHref(u.slug)}` : undefined,
  })),
}];

const stages = [{"label": "Grade 7", "idea": "Building Canada after Confederation: expansion west, the new government, the economy, immigration and the armed forces."}, {"label": "Grade 8", "idea": "Ideologies, economic systems, political systems and civic engagement."}, {"label": "Grade 9", "idea": "Canada in the 20th century: industry, independence, the Second World War, the economy, government and citizenship.", "now": true}, {"label": "Social 10", "idea": "Globalization: trade, identity and how the world is connected."}, {"label": "Social 20 and 30", "idea": "Nationalism (20) and ideology (30), with more source analysis and essay writing."}];
const tips: [string, string][] = [["Talk about the news", "Pick a headline together and ask “Who is affected? What do different people think about it?”"], ["Ask for evidence", "When your child gives an opinion, ask “What makes you think that?” Good answers point to facts or sources."], ["Look at more than one side", "Ask “How might someone else see this?” Considering other perspectives is a key skill in social studies."], ["Use their notes", "The notes show how ideas were taught in class. Reading a section together before practice helps."], ["Learn the key words", "Words like ideology, democracy and economy have specific meanings. Ask your child to explain one in their own words."], ["Short and often", "Fifteen focused minutes a few times a week beats a long session the night before a test."]];
---

<ParentOverview
  course="social9"
  title="Grade 9 social studies at home"
  pageTitle="Social Studies 9 — Parent guide"
  eyebrow="Parent guide · Grade 9 Social Studies"
  numeral="9"
  description={"What your child is learning in social studies this year, how it connects to earlier and later grades, and simple ways to help, with worked examples and short practice sheets for each unit."}
  aboutHeading={"What Grade 9 social studies is about"}
  about={["Grade 9 social studies tells the story of how Canada became the country it is today: cities and industry, independence from Britain, the Second World War, the changes that followed, the modern economy, how our government works, and how rights and citizenship have grown.", "Students practise thinking skills: reading historical sources, explaining causes and effects, comparing points of view, and backing up an argument with evidence. These are the skills high school social studies builds on."]}
  stages={stages}
  groups={groups}
  listHeading="Units this year"
  listIntro="Seven units. Pick one to see the parent guide."
  tips={tips}
/>
