---
import Nav from '../../../../components/Nav.astro';
const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
  const units = [
    'urbanization-industry',
    'independence-democratic-rights',
    'canada-in-wwii',
    'postwar-canada',
    'modern-economy',
    'system-of-government',
    'evolving-citizenship',
  ];
  const kinds = ['notes', 'notes-answers', 'workbook', 'workbook-answers', 'teacherguide'];

  const paths: { params: { unit: string; doc: string } }[] = [];
  for (const unit of units) {
    for (const kind of kinds) {
      paths.push({ params: { unit, doc: `soc9-${unit}-${kind}-v1` } });
    }
  }
  return paths;
}

const { unit, doc } = Astro.params;

const unitLabels: Record<string, string> = {
  'urbanization-industry': 'Urbanization and the Growth of Industry',
  'independence-democratic-rights': "Canada's Independence and Democratic Rights",
  'canada-in-wwii': 'Canada in the Second World War',
  'postwar-canada': 'Post-War Canada',
  'modern-economy': 'Building a Modern Economy',
  'system-of-government': "Canada's System of Government",
  'evolving-citizenship': 'Evolving Citizenship and Rights',
};

const backHref = `${base}social9/materials/${unit}`;
const backLabel = `← ${unitLabels[unit] ?? 'Social Studies 9'}`;
const fileUrl = `${base}materials/${doc}.html`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{unitLabels[unit] ?? unit} — {doc} | Social Studies 9</title>
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <style>
    html, body {
      margin: 0;
      padding: 0;
      height: 100%;
      overflow: hidden;
    }
    .viewer-shell {
      display: flex;
      flex-direction: column;
      height: 100vh;
    }
    .back-bar {
      background: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
      padding: 0.4rem 1.25rem;
      flex-shrink: 0;
    }
    .back-bar a {
      font-family: system-ui, -apple-system, sans-serif;
      font-size: 0.8rem;
      color: #64748b;
      text-decoration: none;
    }
    .back-bar a:hover { color: #0f172a; }
    .doc-frame {
      flex: 1;
      border: none;
      width: 100%;
      display: block;
    }
    @media print {
      .viewer-nav, .back-bar { display: none !important; }
      .doc-frame { height: 100vh; }
    }
  </style>
</head>
<body>
  <div class="viewer-shell">
    <div class="viewer-nav">
      <Nav course="social9" />
    </div>
    <div class="back-bar">
      <a href={backHref}>{backLabel}</a>
    </div>
    <iframe
      src={fileUrl}
      class="doc-frame"
      title={doc}
    />
  </div>
</body>
</html>
