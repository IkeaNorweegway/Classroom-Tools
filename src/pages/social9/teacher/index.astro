---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SocialTeacherHub from '../../../components/SocialTeacherHub.astro';
import { getCollection } from 'astro:content';
import { social9 } from '../../../data/social9';

// Per-unit colour and organizing-idea tag. Names and documents come from the manifest.
const meta = [
  { slug: 'urbanization-industry', organizingIdea: 'Time and Place', color: '#b45309', tagStyle: 'bg-amber-100 text-amber-800' },
  { slug: 'independence-democratic-rights', organizingIdea: 'Time and Place', color: '#4338ca', tagStyle: 'bg-indigo-100 text-indigo-800' },
  { slug: 'canada-in-wwii', organizingIdea: 'Time and Place', color: '#b91c1c', tagStyle: 'bg-red-100 text-red-800' },
  { slug: 'postwar-canada', organizingIdea: 'Time and Place', color: '#0f766e', tagStyle: 'bg-teal-100 text-teal-800' },
  { slug: 'modern-economy', organizingIdea: 'Systems', color: '#15803d', tagStyle: 'bg-green-100 text-green-800' },
  { slug: 'system-of-government', organizingIdea: 'Systems', color: '#1d4ed8', tagStyle: 'bg-blue-100 text-blue-800' },
  { slug: 'evolving-citizenship', organizingIdea: 'Citizenship', color: '#be185d', tagStyle: 'bg-pink-100 text-pink-800' },
];

// One-line scope note per unit, from the unit files.
const summaries = Object.fromEntries((await getCollection('social9-units')).map((e) => [e.slug, e.data.teacherSummary]));
const units = meta.map((u) => ({ ...u, summary: summaries[u.slug] ?? '' }));
---

<BaseLayout title="Social 9 — Teacher Hub" course="social9" audience="teacher">
  <SocialTeacherHub course="social9" name="Social Studies 9" accent="#b45309" manifest={social9} units={units} />
</BaseLayout>
