---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;

const units = [
  { slug: 'urbanization-industry', label: 'Urbanization and the Growth of Industry', organizingIdea: 'Time and Place', color: '#b45309', tagStyle: 'bg-amber-100 text-amber-800' },
  { slug: 'independence-democratic-rights', label: "Canada's Independence and Democratic Rights", organizingIdea: 'Time and Place', color: '#4338ca', tagStyle: 'bg-indigo-100 text-indigo-800' },
  { slug: 'canada-in-wwii', label: 'Canada in the Second World War', organizingIdea: 'Time and Place', color: '#b91c1c', tagStyle: 'bg-red-100 text-red-800' },
  { slug: 'postwar-canada', label: 'Post-War Canada: Change, Cooperation, and Conflict', organizingIdea: 'Time and Place', color: '#0f766e', tagStyle: 'bg-teal-100 text-teal-800' },
  { slug: 'modern-economy', label: 'Building a Modern Economy', organizingIdea: 'Systems', color: '#15803d', tagStyle: 'bg-green-100 text-green-800' },
  { slug: 'system-of-government', label: "Canada's System of Government", organizingIdea: 'Systems', color: '#1d4ed8', tagStyle: 'bg-blue-100 text-blue-800' },
  { slug: 'evolving-citizenship', label: 'Evolving Citizenship and Rights', organizingIdea: 'Citizenship', color: '#be185d', tagStyle: 'bg-pink-100 text-pink-800' },
];
---

<BaseLayout title="Social 9 — Teacher Hub" course="social9" teacherMode={true}>

  <div class="mb-8">
    <p class="text-xs font-bold uppercase tracking-widest mb-2" style="color: #b45309;">Teacher Hub · Social Studies 9</p>
    <h1 class="text-3xl font-bold text-slate-900 mb-2">Social Studies 9 — Teacher View</h1>
    <p class="text-slate-500">Teaching guides with pacing, discussion prompts, and misconception flags for all 7 units.</p>
  </div>

  <div class="space-y-4">
    {units.map(u => (
      <div
        class="bg-white rounded-xl border border-slate-200 border-l-4 overflow-hidden"
        style={`border-left-color: ${u.color};`}
      >
        <!-- Unit header -->
        <div class="px-5 py-4 flex items-start justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class={`text-xs font-semibold px-2 py-0.5 rounded-full ${u.tagStyle}`}>{u.organizingIdea}</span>
            </div>
            <p class="font-bold text-slate-900">{u.label}</p>
          </div>
        </div>

        <!-- Teaching guide link -->
        <div class="border-t border-slate-100 px-5 py-3 flex items-center justify-between gap-4 bg-amber-50">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-amber-600 text-white">Teacher Guide</span>
            <span class="text-sm font-medium text-slate-700">Pacing · Discussion Prompts · Misconceptions</span>
          </div>
          <a
            href={`${base}social9/view/${u.slug}/soc9-${u.slug}-teacherguide-v1`}
            target="_blank"
            rel="noopener"
            class="flex-shrink-0 text-sm font-semibold text-amber-700 hover:text-amber-900 border border-amber-300 hover:border-amber-500 px-4 py-1.5 rounded-lg transition-colors whitespace-nowrap"
          >
            Open ↗
          </a>
        </div>

        <!-- Answer keys (collapsed) -->
        <div class="border-t border-slate-100 px-5 py-3">
          <details class="group">
            <summary class="cursor-pointer list-none flex items-center gap-2 text-sm font-medium text-slate-400 hover:text-slate-600 transition-colors select-none">
              <span class="inline-block transition-transform group-open:rotate-90">▶</span>
              Answer keys
            </summary>
            <div class="mt-3 space-y-2">
              {[
                { label: 'Notes Answer Key',    doc: `soc9-${u.slug}-notes-answers-v1` },
                { label: 'Workbook Answer Key', doc: `soc9-${u.slug}-workbook-answers-v1` },
              ].map(ak => (
                <div class="bg-slate-50 rounded-lg border border-slate-200 px-4 py-2.5 flex items-center justify-between gap-4">
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-slate-200 text-slate-600">Answer Key</span>
                    <span class="text-sm font-medium text-slate-600">{ak.label}</span>
                  </div>
                  <a
                    href={`${base}social9/view/${u.slug}/${ak.doc}`}
                    target="_blank"
                    rel="noopener"
                    class="flex-shrink-0 text-sm font-semibold text-slate-500 hover:text-slate-800 border border-slate-200 hover:border-slate-400 px-4 py-1.5 rounded-lg transition-colors"
                  >
                    Open ↗
                  </a>
                </div>
              ))}
            </div>
          </details>
        </div>

      </div>
    ))}
  </div>

  <div class="mt-10 pt-6 border-t border-slate-100">
    <a href={`${base}social9`} class="text-sm text-slate-400 hover:text-slate-600 transition-colors">
      ← Back to Social Studies 9
    </a>
  </div>

</BaseLayout>
