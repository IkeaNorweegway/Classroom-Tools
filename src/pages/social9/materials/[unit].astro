---
// Student unit page (shared StudentUnit layout). Materials come from
// src/data/social9.ts; the intro from src/content/social9-units/.
import StudentUnit from '../../../components/StudentUnit.astro';
import { getEntry } from 'astro:content';
import { social9 as m } from '../../../data/social9';

export function getStaticPaths() {
  return m.units.map((u, i) => ({ params: { unit: u.slug }, props: { i } }));
}

const { i } = Astro.props as { i: number };
const u = m.units[i];
const entry = await getEntry('social9-units', u.slug);
if (!entry) throw new Error(`social9-units/${u.slug}.md is missing`);
const { Content } = await entry.render();
const base = import.meta.env.BASE_URL;
---

<StudentUnit
  manifest={m}
  unit={u}
  title={`${u.label} — Materials`}
  eyebrow={`Social Studies 9 · Unit ${i + 1}`}
  back={{ href: `${base}social9`, label: 'Social Studies 9' }}
  intro={entry.data}
  Content={Content}
  prev={m.units[i - 1]}
  next={m.units[i + 1]}
/>
