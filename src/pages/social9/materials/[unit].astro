---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
  return [
    { params: { unit: 'urbanization-industry' } },
    { params: { unit: 'independence-democratic-rights' } },
    { params: { unit: 'canada-in-wwii' } },
    { params: { unit: 'postwar-canada' } },
    { params: { unit: 'modern-economy' } },
    { params: { unit: 'system-of-government' } },
    { params: { unit: 'evolving-citizenship' } },
  ];
}

const { unit } = Astro.params;

type MaterialFile = { label: string; badge?: string; badgeStyle?: string; doc: string };
type Section = { heading: string; items: MaterialFile[] };

interface UnitData {
  label: string;
  tagline: string;
  color: string;
  colorDark: string;
  colorLight: string;
  sections: Section[];
  answerKeys: MaterialFile[];
}

const units: Record<string, UnitData> = {
  'urbanization-industry': {
    label: 'Urbanization and the Growth of Industry',
    tagline: 'Push and pull factors, postwar immigration, the growth of Alberta industry, and the environmental cost of urban growth.',
    color: '#b45309', colorDark: '#92400e', colorLight: '#fef3c7',
    sections: [
      { heading: 'Notes', items: [{ label: 'Guided Notes', doc: 'soc9-urbanization-industry-notes-v1' }] },
      { heading: 'Practice Workbook', items: [{ label: 'Workbook', doc: 'soc9-urbanization-industry-workbook-v1' }] },
    ],
    answerKeys: [
      { label: 'Notes Answer Key', doc: 'soc9-urbanization-industry-notes-answers-v1' },
      { label: 'Workbook Answer Key', doc: 'soc9-urbanization-industry-workbook-answers-v1' },
    ],
  },
  'independence-democratic-rights': {
    label: "Canada's Independence and Democratic Rights",
    tagline: 'The Balfour Declaration, the Statute of Westminster, and the Persons Case.',
    color: '#4338ca', colorDark: '#3730a3', colorLight: '#e0e7ff',
    sections: [
      { heading: 'Notes', items: [{ label: 'Guided Notes', doc: 'soc9-independence-democratic-rights-notes-v1' }] },
      { heading: 'Practice Workbook', items: [{ label: 'Workbook', doc: 'soc9-independence-democratic-rights-workbook-v1' }] },
    ],
    answerKeys: [
      { label: 'Notes Answer Key', doc: 'soc9-independence-democratic-rights-notes-answers-v1' },
      { label: 'Workbook Answer Key', doc: 'soc9-independence-democratic-rights-workbook-answers-v1' },
    ],
  },
  'canada-in-wwii': {
    label: 'Canada in the Second World War',
    tagline: "Canada's independent declaration of war, key battles, and the contributions of Chinese Canadians and Cree code talkers.",
    color: '#b91c1c', colorDark: '#991b1b', colorLight: '#fee2e2',
    sections: [
      { heading: 'Notes', items: [{ label: 'Guided Notes', doc: 'soc9-canada-in-wwii-notes-v1' }] },
      { heading: 'Practice Workbook', items: [{ label: 'Workbook', doc: 'soc9-canada-in-wwii-workbook-v1' }] },
    ],
    answerKeys: [
      { label: 'Notes Answer Key', doc: 'soc9-canada-in-wwii-notes-answers-v1' },
      { label: 'Workbook Answer Key', doc: 'soc9-canada-in-wwii-workbook-answers-v1' },
    ],
  },
  'postwar-canada': {
    label: 'Post-War Canada: Change, Cooperation, and Conflict',
    tagline: 'The welfare state, peacekeeping, multiculturalism, residential schools, Western alienation, and the Charter of Rights and Freedoms.',
    color: '#0f766e', colorDark: '#115e59', colorLight: '#ccfbf1',
    sections: [
      { heading: 'Notes', items: [{ label: 'Guided Notes', doc: 'soc9-postwar-canada-notes-v1' }] },
      { heading: 'Practice Workbook', items: [{ label: 'Workbook', doc: 'soc9-postwar-canada-workbook-v1' }] },
    ],
    answerKeys: [
      { label: 'Notes Answer Key', doc: 'soc9-postwar-canada-notes-answers-v1' },
      { label: 'Workbook Answer Key', doc: 'soc9-postwar-canada-workbook-answers-v1' },
    ],
  },
  'modern-economy': {
    label: 'Building a Modern Economy',
    tagline: 'The Great Depression, government response, postwar industrial growth, and trade with the United States.',
    color: '#15803d', colorDark: '#166534', colorLight: '#dcfce7',
    sections: [
      { heading: 'Notes', items: [{ label: 'Guided Notes', doc: 'soc9-modern-economy-notes-v1' }] },
      { heading: 'Practice Workbook', items: [{ label: 'Workbook', doc: 'soc9-modern-economy-workbook-v1' }] },
    ],
    answerKeys: [
      { label: 'Notes Answer Key', doc: 'soc9-modern-economy-notes-answers-v1' },
      { label: 'Workbook Answer Key', doc: 'soc9-modern-economy-workbook-answers-v1' },
    ],
  },
  'system-of-government': {
    label: "Canada's System of Government",
    tagline: 'Responsible government, how laws are made, federalism and natural resources, and the judiciary.',
    color: '#1d4ed8', colorDark: '#1e40af', colorLight: '#dbeafe',
    sections: [
      { heading: 'Notes', items: [{ label: 'Guided Notes', doc: 'soc9-system-of-government-notes-v1' }] },
      { heading: 'Practice Workbook', items: [{ label: 'Workbook', doc: 'soc9-system-of-government-workbook-v1' }] },
    ],
    answerKeys: [
      { label: 'Notes Answer Key', doc: 'soc9-system-of-government-notes-answers-v1' },
      { label: 'Workbook Answer Key', doc: 'soc9-system-of-government-workbook-answers-v1' },
    ],
  },
  'evolving-citizenship': {
    label: 'Evolving Citizenship and Rights',
    tagline: 'Canadian citizenship categories, the legislative path to the Charter, and the balance of rights and responsibilities.',
    color: '#be185d', colorDark: '#9d174d', colorLight: '#fce7f3',
    sections: [
      { heading: 'Notes', items: [{ label: 'Guided Notes', doc: 'soc9-evolving-citizenship-notes-v1' }] },
      { heading: 'Practice Workbook', items: [{ label: 'Workbook', doc: 'soc9-evolving-citizenship-workbook-v1' }] },
    ],
    answerKeys: [
      { label: 'Notes Answer Key', doc: 'soc9-evolving-citizenship-notes-answers-v1' },
      { label: 'Workbook Answer Key', doc: 'soc9-evolving-citizenship-workbook-answers-v1' },
    ],
  },
};

const data = units[unit];
const borderStyle = `border-left-color: ${data.color};`;

const unitEntry = await getEntry('social9-units', unit!);
const { Content } = unitEntry ? await unitEntry.render() : { Content: null };
---

<BaseLayout title={`${data.label} — Materials`} course="social9">

  <!-- Back link -->
  <a href={`${base}social9`} class="inline-flex items-center gap-1 text-sm text-slate-400 hover:text-slate-600 mb-8 transition-colors">
    ← Social Studies 9
  </a>

  <!-- Header -->
  <div class="mb-8">
    <div class="flex items-center gap-2 mb-1">
      <p class="text-xs font-bold uppercase tracking-widest" style={`color: ${data.colorDark};`}>
        Social Studies 9{unitEntry ? ` · ${unitEntry.data.organizingIdea}` : ''}
      </p>
    </div>
    <h1 class="text-4xl font-bold text-slate-900 mb-3">{data.label}</h1>
    <p class="text-slate-500 text-lg max-w-xl italic">{unitEntry ? unitEntry.data.guidingQuestion : data.tagline}</p>
  </div>

  {unitEntry && (
    <>
      <!-- Learning outcome -->
      <div class="bg-white rounded-xl border border-slate-200 p-4 mb-6">
        <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Learning Outcome</p>
        <p class="text-slate-700">{unitEntry.data.learningOutcome}</p>
      </div>

      <!-- Unit description -->
      <div class="prose prose-slate max-w-none mb-10">
        <Content />
      </div>
    </>
  )}

  <!-- Material sections -->
  {data.sections.map(section => (
    <section class="mb-10">
      <h2 class="text-xs font-bold uppercase tracking-widest mb-3" style={`color: ${data.colorDark};`}>{section.heading}</h2>
      <div class="space-y-2">
        {section.items.map(item => (
          <div class="bg-white rounded-xl border border-slate-200 border-l-4 px-5 py-4 flex items-center justify-between gap-4" style={borderStyle}>
            <div class="flex items-center gap-2 min-w-0">
              <span class="text-sm font-medium text-slate-800">{item.label}</span>
              {item.badge && (
                <span class={`text-xs font-semibold px-2 py-0.5 rounded-full ${item.badgeStyle}`}>{item.badge}</span>
              )}
            </div>
            <a
              href={`${base}social9/view/${unit}/${item.doc}`}
              class="flex-shrink-0 text-sm font-semibold text-slate-600 hover:text-slate-900 border border-slate-200 hover:border-slate-400 px-4 py-1.5 rounded-lg transition-colors whitespace-nowrap"
            >
              Open
            </a>
          </div>
        ))}
      </div>
    </section>
  ))}

  <!-- Answer keys — hidden by default -->
  <details class="group mt-2">
    <summary class="cursor-pointer list-none flex items-center gap-2 text-sm font-medium text-slate-400 hover:text-slate-600 transition-colors select-none mb-3">
      <span class="inline-block transition-transform group-open:rotate-90">▶</span>
      Show answer keys
    </summary>
    <div class="space-y-2 mt-1">
      {data.answerKeys.map(item => (
        <div class="bg-slate-50 rounded-xl border border-slate-200 px-5 py-4 flex items-center justify-between gap-4">
          <div class="flex items-center gap-2 min-w-0">
            <span class="text-sm font-medium text-slate-600">{item.label}</span>
            <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-slate-200 text-slate-600 tracking-wide">Answer Key</span>
          </div>
          <a
            href={`${base}social9/view/${unit}/${item.doc}`}
            class="flex-shrink-0 text-sm font-semibold text-slate-500 hover:text-slate-800 border border-slate-200 hover:border-slate-400 px-4 py-1.5 rounded-lg transition-colors whitespace-nowrap"
          >
            Open
          </a>
        </div>
      ))}
    </div>
  </details>

</BaseLayout>
