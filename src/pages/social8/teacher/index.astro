---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SocialTeacherHub from '../../../components/SocialTeacherHub.astro';
import { getCollection } from 'astro:content';
import { social8 } from '../../../data/social8';

// Per-unit colour and organizing-idea tag. Names and documents come from the manifest.
const meta = [
  { slug: 'ideologies', organizingIdea: 'Time and Place', color: '#92400e', tagStyle: 'bg-amber-100 text-amber-800' },
  { slug: 'economic-systems', organizingIdea: 'Systems', color: '#1d4ed8', tagStyle: 'bg-blue-100 text-blue-800' },
  { slug: 'political-systems', organizingIdea: 'Systems', color: '#4338ca', tagStyle: 'bg-indigo-100 text-indigo-800' },
  { slug: 'civic-engagement', organizingIdea: 'Citizenship', color: '#0f766e', tagStyle: 'bg-teal-100 text-teal-800' },
];

// One-line scope note per unit, from the unit files.
const summaries = Object.fromEntries((await getCollection('social8-units')).map((e) => [e.slug, e.data.teacherSummary]));
const units = meta.map((u) => ({ ...u, summary: summaries[u.slug] ?? '' }));
---

<BaseLayout title="Social 8 — Teacher Hub" course="social8" audience="teacher">
  <SocialTeacherHub course="social8" name="Social Studies 8" accent="#4338ca" manifest={social8} units={units} />
</BaseLayout>
