---
// Parent overview for Grade 8 Social Studies (shared ParentOverview layout).
import ParentOverview from '../../../components/ParentOverview.astro';
import { getCollection } from 'astro:content';
import { social8 as m } from '../../../data/social8';

const base = import.meta.env.BASE_URL;
const written = new Set((await getCollection('parent-guides')).map((e) => e.slug));
const groups = [{
  items: m.units.filter((u) => u.home.length > 0).map((u) => ({
    label: u.label,
    href: written.has(`social8/${u.slug}`) ? `${base}${m.parentHref(u.slug)}` : undefined,
  })),
}];

const stages = [{"label": "Grade 6", "idea": "How democracy works in Canada: rights, voting and local government."}, {"label": "Grade 7", "idea": "Building Canada after Confederation: expansion west, the new government, the economy, immigration and the armed forces."}, {"label": "Grade 8", "idea": "Ideologies, economic systems, political systems and civic engagement.", "now": true}, {"label": "Grade 9", "idea": "Canada in the 20th century: industry, independence, the Second World War, the economy, government and citizenship."}, {"label": "High school", "idea": "Social 10 (globalization), 20 (nationalism) and 30 (ideology), where Grade 8’s ideas come back in depth."}];
const tips: [string, string][] = [["Talk about the news", "Pick a headline together and ask “Who is affected? What do different people think about it?”"], ["Ask for evidence", "When your child gives an opinion, ask “What makes you think that?” Good answers point to facts or sources."], ["Look at more than one side", "Ask “How might someone else see this?” Considering other perspectives is a key skill in social studies."], ["Use their notes", "The notes show how ideas were taught in class. Reading a section together before practice helps."], ["Learn the key words", "Words like ideology, democracy and economy have specific meanings. Ask your child to explain one in their own words."], ["Short and often", "Fifteen focused minutes a few times a week beats a long session the night before a test."]];
---

<ParentOverview
  course="social8"
  title="Grade 8 social studies at home"
  pageTitle="Social Studies 8 — Parent guide"
  eyebrow="Parent guide · Grade 8 Social Studies"
  numeral="8"
  description={"What your child is learning in social studies this year, how it connects to earlier and later grades, and simple ways to help, with worked examples and short practice sheets for each unit."}
  aboutHeading={"What Grade 8 social studies is about"}
  about={["Grade 8 social studies looks at the big ideas behind how societies are run: what people believe (ideologies), how economies work, how governments are organised, and how citizens take part. These are the ideas behind the news, elections and debates your child hears about.", "Students practise thinking skills: reading sources carefully, comparing points of view, and backing up their own opinion with evidence. Those skills matter as much as the content."]}
  stages={stages}
  groups={groups}
  listHeading="Units this year"
  listIntro="Four units. Pick one to see the parent guide."
  tips={tips}
/>
