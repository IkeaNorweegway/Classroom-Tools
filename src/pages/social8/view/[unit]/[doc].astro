---
import Nav from '../../../../components/Nav.astro';
import { social8 as manifest } from '../../../../data/social8';
import { unitDocs } from '../../../../data/manifest';
import { existsSync } from 'node:fs';
const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
  const units = [
    'ideologies',
    'economic-systems',
    'political-systems',
    'civic-engagement',
  ];
  const kinds = ['notes', 'notes-answers', 'workbook', 'workbook-answers', 'teacherguide'];

  const paths: { params: { unit: string; doc: string } }[] = [];
  for (const unit of units) {
    for (const kind of kinds) {
      paths.push({ params: { unit, doc: `soc8-${unit}-${kind}-v1` } });
    }
  }
  // Every document the course's pages link to (from the manifest), including
  // the parent home sheets. Routes listed above stay even if no page links them.
  for (const u of manifest.units) {
    for (const doc of unitDocs(u)) {
      if (!existsSync(`public/materials/${doc}.html`)) console.warn(`[${manifest.course}] missing material: ${doc}.html`);
      if (!paths.some((p) => p.params.unit === u.slug && p.params.doc === doc)) paths.push({ params: { unit: u.slug, doc } });
    }
  }
  return paths;
}

const { unit, doc } = Astro.params;

const unitLabels: Record<string, string> = {
  'ideologies': 'Foundations and Influences of Ideologies',
  'economic-systems': 'Economic Systems',
  'political-systems': 'Political Systems',
  'civic-engagement': 'Civic Engagement',
};

// Home practice sheets belong to the parent guide; everything else to the unit page.
const isHome = doc!.includes('-home-');
const backHref = isHome ? `${base}${manifest.parentHref(unit!)}` : `${base}social8/materials/${unit}`;
const backLabel = isHome ? '← Parent guide' : `← ${unitLabels[unit] ?? 'Social Studies 8'}`;
const fileUrl = `${base}materials/${doc}.html`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{unitLabels[unit] ?? unit} — {doc} | Social Studies 8</title>
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <style>
    html, body {
      margin: 0;
      padding: 0;
      height: 100%;
      overflow: hidden;
    }
    .viewer-shell {
      display: flex;
      flex-direction: column;
      height: 100vh;
    }
    .back-bar {
      background: #f6f4ef;
      border-bottom: 1px solid rgb(31 29 26 / 0.07);
      padding: 0.6rem 1.25rem;
      flex-shrink: 0;
    }
    .back-bar a {
      font-family: 'Atkinson Hyperlegible Next Variable', system-ui, sans-serif;
      font-weight: 600;
      font-size: 0.875rem;
      color: #6b665d;
      text-decoration: none;
    }
    .back-bar a:hover { color: #1f1d1a; }
    .doc-frame {
      flex: 1;
      border: none;
      width: 100%;
      display: block;
    }
    @media print {
      .viewer-nav, .back-bar { display: none !important; }
      .doc-frame { height: 100vh; }
    }
  </style>
</head>
<body>
  <div class="viewer-shell">
    <div class="viewer-nav">
      <Nav course="social8" />
    </div>
    <div class="back-bar">
      <a href={backHref}>{backLabel}</a>
    </div>
    <iframe
      src={fileUrl}
      class="doc-frame"
      title={doc}
    />
  </div>
  <script is:inline>
    // Pass a section id (#s3) on to the document, so a link can open one notes section.
    (function () {
      var f = document.querySelector('.doc-frame');
      function go() { if (f && location.hash) f.src = f.src.split('#')[0] + location.hash; }
      go();
      window.addEventListener('hashchange', go);
      // Answer-key links in a notes file (.key-link, from scripts/add_key_links.pl) point at
      // the key file beside it. Open the key in this viewer instead, in the whole window.
      function keyLinks() {
        var d; try { d = f.contentDocument; } catch (e) { return; }
        if (!d) return;
        var here = location.pathname.replace(/[^/]*\/?$/, '');
        d.querySelectorAll('.key-link a').forEach(function (a) {
          var u = new URL(a.getAttribute('href'), d.baseURI);
          a.href = here + u.pathname.split('/').pop().replace(/\.html$/, '') + u.hash;
          a.target = '_top';
        });
      }
      if (f) { f.addEventListener('load', keyLinks); keyLinks(); }
    })();
  </script>
</body>
</html>
