---
// Parent overview for Math 8: what the course covers in plain words, where
// it sits between Grade 7 and Grade 9, general ways to help, and a link to
// each topic's parent guide.
import ParentOverview from '../../../components/ParentOverview.astro';
import { getCollection } from 'astro:content';
import { strands, topicsInStrand } from '../../../data/math8';

const base = import.meta.env.BASE_URL;
const written = new Set((await getCollection('parent-guides')).map((e) => e.slug));

const stages = [
  { label: 'Grade 7', idea: 'All four operations with integers, fractions and decimals, ratios and percents, equations with x on both sides, functions, angles, circles, volume, sampling and probability.' },
  { label: 'Grade 8', idea: 'Rational and irrational numbers, square roots, proportional reasoning, polynomials, equations and inequalities, slope, similar shapes, triangle theorems and the Pythagorean theorem, surface area, the shape of data, and the chance of two events.', now: true },
  { label: 'Grade 9', idea: 'Sets of real numbers, exponent laws, multiplying and factoring polynomials, quadratic equations, solving inequalities, linear functions in context, congruent and similar triangles, composite 3-D shapes, box plots, and Venn diagrams.' },
  { label: 'High school', idea: 'Math 10C leads on to the 20-1/30-1 and 20-2/30-2 courses. Math 10-3 leads on to 20-3 and 30-3, which focus on workplace math.' },
];

const plainStrand: Record<string, string> = {
  number: 'Sorting numbers into kinds (whole, integer, rational, irrational), square roots with both signs, and comparing quantities with a constant of proportionality.',
  algebra: 'Naming and combining polynomials, solving equations with fractions and brackets, showing inequalities on a number line, and reading slope from a graph.',
  'measurement-geometry': 'Scaling shapes up and down, using triangle facts and the Pythagorean theorem, and finding the surface area of boxes, pyramids and cans.',
  'statistics-probability': 'Describing the shape of data in histograms, choosing the best average, circle graphs, and the chance of two things happening.',
};

const tips: [string, string][] = [
  ['Ask them to teach you', 'Have your child explain a problem from their notes. Explaining is one of the best ways to learn, and you don’t need to know the answer to listen.'],
  ['Ask “How do you know?”', 'Instead of “Is that right?”, ask how they know. Checking their own work is a skill they need on tests.'],
  ['Look at the pictures', 'The Grade 8 notes use lots of pictures: number lines, fraction bars, tiles and diagrams. Ask your child to show you the picture that goes with a problem.'],
  ['Short and often', 'Fifteen focused minutes a few times a week beats a long session the night before a test.'],
  ['Mistakes are clues', 'When an answer is wrong, have them find the step where it went off track. That is where the learning happens.'],
  ['Keep the basics sharp', 'Times tables, negative numbers and fractions come up all year. A few minutes of practice on these pays off in every topic.'],
];

const groups = strands.map((s) => ({
  id: s.slug,
  label: s.label,
  blurb: plainStrand[s.slug],
  items: topicsInStrand(s.slug).map((t) => ({
    label: t.label,
    href: written.has(`math8/${t.slug}`) ? `${base}math8/parents/${t.slug}` : undefined,
  })),
}));
---

<ParentOverview
  course="math8"
  title="Grade 8 math at home"
  pageTitle="Grade 8 Math — Parent guide"
  metaDescription="What your child learns in Grade 8 math, where it leads, and how to help at home."
  eyebrow="Parent guide · Grade 8 Mathematics"
  numeral="8"
  description="What your child is learning this year, how it connects to Grade 7 and Grade 9, and simple ways to help, with worked examples and short practice sheets for each topic."
  aboutHeading="What Grade 8 math is about"
  about={[
    'Grade 8 follows Alberta\'s new math curriculum (the 2026 draft). Students work with every kind of rational number, meet irrational numbers like √2 and π, and use proportional reasoning. In algebra they name and combine polynomials, solve harder equations, write inequalities and graph straight lines with slope. They scale shapes, use triangle facts and the Pythagorean theorem, find surface areas, read the shape of data and find the chance of two events.',
    'The notes are written in short, plain sentences with lots of pictures, so the reading never gets in the way of the math.',
  ]}
  stages={stages}
  groups={groups}
  listHeading="Topics this year"
  listIntro="Four strands, twelve topics. Pick one to see the parent guide."
  tips={tips}
/>
