---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseHero from '../../components/CourseHero.astro';
import TopicList from '../../components/TopicList.astro';
import { strands, topics, topicsInStrand, math8Course } from '../../data/math8';
import { materialCount } from '../../data/manifest';
const base = import.meta.env.BASE_URL;
// The same three facts as the other courses' landing pages, all read from the data.
const materials = materialCount(math8Course.units);

// One card per strand; each strand page lists its topics and workbook.
const descriptions: Record<string, string> = {
  number: 'Rational and irrational numbers, square roots with both signs, and the constant of proportionality.',
  algebra: 'Polynomials, equations with fractions and x on both sides, inequalities on a number line, and slope and y = mx + b.',
  'measurement-geometry': 'Similar shapes, scale factors and dilations, triangle theorems with the Pythagorean theorem, and surface area from nets and drawings.',
  'statistics-probability': 'The shape of a distribution, histograms and circle graphs, and the probability of independent and dependent events.',
};
---

<BaseLayout course="math8" title="Grade 8 Mathematics">
  <CourseHero
    eyebrow="Alberta curriculum"
    title="Grade 8 Mathematics"
    numeral="8"
    vtName="course-num-math8"
    description="Four strands, twelve topics, on Alberta's new (2026 draft) curriculum. Short sentences, lots of pictures, and practice for every topic."
    facts={[
      { n: `${strands.length}`, label: 'strands' },
      { n: `${topics.length}`, label: 'topics' },
      { n: `${materials}`, label: 'materials' },
    ]}
  />

  <TopicList
    heading="Strands"
    items={strands.map((s) => ({
      art: s.slug,
      href: `${base}math8/materials/${s.slug}`,
      title: s.label,
      kicker: topicsInStrand(s.slug).map((t) => t.label).join(' · '),
      description: descriptions[s.slug],
    }))}
  />
</BaseLayout>
