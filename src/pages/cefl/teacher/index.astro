---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TeacherHub from '../../../components/TeacherHub.astro';
import { getCollection } from 'astro:content';
import { cefl, splitSlug, ceflProject } from '../../../data/cefl';

// Per-unit tag (grade + organizing idea) and colour. Names and documents come from the manifest.
const ideaStyle: Record<string, { color: string; tagStyle: string }> = {
  'Career Exploration': { color: '#94631a', tagStyle: 'bg-amber-100 text-amber-800' },
  'Career Opportunities': { color: '#0f766e', tagStyle: 'bg-teal-100 text-teal-800' },
  'Financial Literacy': { color: '#1d4ed8', tagStyle: 'bg-blue-100 text-blue-800' },
};
const entries = Object.fromEntries((await getCollection('cefl-units')).map((e) => [e.slug, e.data]));
const units = cefl.units.map((u) => {
  const { grade, unit } = splitSlug(u.slug);
  const e = entries[`grade-${grade}/${unit}`];
  const style = ideaStyle[e?.organizingIdea ?? 'Career Exploration'];
  return { slug: u.slug, tag: `Grade ${grade} · ${e?.organizingIdea ?? ''}`, color: style.color, tagStyle: style.tagStyle, meta: `Project: ${ceflProject(u.slug)}`, summary: e?.teacherSummary ?? '' };
});
---

<BaseLayout title="CEFL 7–9 — Teacher Hub" course="cefl" audience="teacher">
  <TeacherHub course="cefl" name="CEFL 7–9" accent="#94631a" manifest={cefl} units={units} guideNote="7-session script · Look-fors · Misconceptions · Sample products" />
</BaseLayout>
