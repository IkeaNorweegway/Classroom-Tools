---
// Old Grade 7 unit URLs (/cefl/materials/<unit>) now live at /cefl/grade-7/<unit>.
// Kept as redirects so shared links keep working.
import { ceflUnitSlugs } from '../../../data/cefl';

export function getStaticPaths() {
  return ceflUnitSlugs.map((unit) => ({ params: { unit } }));
}

const { unit } = Astro.params;
const to = `${import.meta.env.BASE_URL}cefl/grade-7/${unit}`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content={`0; url=${to}`} />
  <link rel="canonical" href={to} />
  <title>Moved · CEFL</title>
</head>
<body><p>This page moved to <a href={to}>{to}</a>.</p></body>
</html>
