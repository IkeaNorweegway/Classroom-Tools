---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseHero from '../../components/CourseHero.astro';
import TopicList from '../../components/TopicList.astro';
import { getCollection } from 'astro:content';
import { cefl } from '../../data/cefl';
import { materialCount } from '../../data/manifest';
const base = import.meta.env.BASE_URL;

// Cards lead with the student hook; the unit's project is the kicker.
const entries = (await getCollection('cefl7-units')).sort((a, b) => a.data.order - b.data.order);
const materials = materialCount(cefl.units);
---

<BaseLayout course="cefl" title="Career Education and Financial Literacy 7">
  <CourseHero
    eyebrow="Alberta draft curriculum · 2026"
    title="Career Education & Financial Literacy 7"
    numeral="7"
    vtName="course-num-cefl"
    description="A project-based course. Every unit is a project, with short lessons inside it right when you need them."
    facts={[
      { n: `${cefl.units.length}`, label: 'units' },
      { n: `${cefl.units.length}`, label: 'projects' },
      { n: `${materials}`, label: 'materials' },
    ]}
  />

  <TopicList
    heading="Units"
    items={entries.map((e) => ({ art: e.slug, href: `${base}cefl/materials/${e.slug}`, title: e.data.title, kicker: `${e.data.organizingIdea} · Project: ${e.data.project}`, description: e.data.hook }))}
  />
</BaseLayout>
