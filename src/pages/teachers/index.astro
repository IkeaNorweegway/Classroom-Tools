---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseHero from '../../components/CourseHero.astro';
import TopicList from '../../components/TopicList.astro';
import { courses } from '../../data/courses';
const base = import.meta.env.BASE_URL;

const withHub = courses.filter((c) => c.teacherPath);
---

<BaseLayout title="Teacher hubs" audience="teacher" description="Teaching guides, answer keys and delivery notes by course.">
  <CourseHero
    eyebrow="Teacher view"
    title="Teacher hubs"
    description="Teaching guides, answer keys and delivery notes for each course."
  />

  <TopicList
    heading="Courses"
    numbered={false}
    items={withHub.map((c) => ({
      href: `${base}${c.teacherPath}`,
      kicker: c.grade,
      title: c.name,
      description: c.blurb,
    }))}
  />

  <a
    href="https://drive.google.com/drive/folders/1vvIuLJxxR6xu3ZQiNPvW0tNapQzEqPR5"
    target="_blank"
    rel="noopener noreferrer"
    class="lift group flex items-center gap-4 rounded-2xl px-5 py-4 sm:px-6"
  >
    <span class="min-w-0 flex-1">
      <span class="block text-[0.9375rem] font-semibold text-slate-800">Tests and answer keys</span>
      <span class="block text-sm text-slate-500">Google Drive folder. Sign-in and permission required.</span>
    </span>
    <span class="arrow shrink-0 text-slate-500" aria-hidden="true">↗</span>
  </a>
</BaseLayout>
