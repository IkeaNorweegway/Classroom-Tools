---
// Student topic page (shared StudentUnit layout), plus Math 7's warm-up and
// strand-workbook cards.
import StudentUnit from '../../components/StudentUnit.astro';
import { getEntry } from 'astro:content';
import { math7Course, topics, strandBySlug } from '../../data/math7';

export function getStaticPaths() {
  return math7Course.units.map((u, i) => ({
    params: { topic: u.slug },
    props: { i },
  }));
}

const { i } = Astro.props as { i: number };
const u = math7Course.units[i];
const strand = strandBySlug(topics[i].strand)!;
const entry = await getEntry('math7-units', u.slug);
if (!entry) throw new Error(`math7-units/${u.slug}.md is missing`);
const { Content } = await entry.render();
const base = import.meta.env.BASE_URL;
---

<StudentUnit
  manifest={math7Course}
  unit={u}
  title={`${u.label} — Math 7`}
  eyebrow={`Grade 7 Math · ${strand.label}`}
  back={{ href: `${base}math7/materials/${strand.slug}`, label: strand.label }}
  intro={entry.data}
  Content={Content}
  actions={[
    { href: `${base}math7/view/practice/math7-${u.slug}-prereq-practice-v1`, title: 'Need a warm-up?', description: 'Practise the skills you need before this topic. Every problem comes with a worked solution.', cta: 'Warm up' },
    { href: `${base}math7/view/${strand.workbook}`, title: `${strand.label} workbook`, description: `Mixed practice across every ${strand.label} topic. Good for reviewing before a test.`, cta: 'Open workbook' },
  ]}
  prev={math7Course.units[i - 1]}
  next={math7Course.units[i + 1]}
/>
