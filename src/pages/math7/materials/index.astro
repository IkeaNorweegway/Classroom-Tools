---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseHero from '../../../components/CourseHero.astro';
import TopicList from '../../../components/TopicList.astro';
import { strands, topicsInStrand } from '../../../data/math7';
const base = import.meta.env.BASE_URL;
---

<BaseLayout course="math7" title="Materials — Math 7">
  <CourseHero
    back={{ href: `${base}math7`, label: 'Math 7' }}
    eyebrow="Grade 7 Mathematics"
    title="Materials"
    description="Pick a strand to see all notes, worksheets, exit tickets and the strand workbook."
  />

  <TopicList
    items={strands.map((s) => ({
      art: s.slug,
      href: `${base}math7/materials/${s.slug}`,
      title: s.label,
      kicker: topicsInStrand(s.slug).map((t) => t.label).join(' · '),
      description: s.blurb,
    }))}
  />
</BaseLayout>
