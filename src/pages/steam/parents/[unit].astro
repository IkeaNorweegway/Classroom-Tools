---
// Parent guide for one STEAM unit (shared ParentUnit layout), one per
// file in src/content/parent-guides/steam/.
import ParentUnit from '../../../components/ParentUnit.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { steam as m } from '../../../data/steam';
import type { CourseUnit } from '../../../data/manifest';

export async function getStaticPaths() {
  const guides = await getCollection('parent-guides', (e) => e.slug.startsWith('steam/'));
  const pages = m.units
    .map((u) => ({ u, entry: guides.find((e) => e.slug === `steam/${u.slug}`) }))
    .filter((p) => p.entry);
  return pages.map((p, k) => ({
    params: { unit: p.u.slug },
    props: { ...p, prev: pages[k - 1]?.u, next: pages[k + 1]?.u },
  }));
}

interface Props { u: CourseUnit; entry: CollectionEntry<'parent-guides'>; prev?: CourseUnit; next?: CourseUnit }
const { u, entry, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<ParentUnit
  manifest={m}
  unit={u}
  entry={entry}
  eyebrow="Parent guide · STEAM"
  thisYear={u.label}
  thisYearIdea="This grade’s four projects"
  prev={prev}
  next={next}
/>
