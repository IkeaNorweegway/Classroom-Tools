---
// Parent overview for STEAM (shared ParentOverview layout).
import ParentOverview from '../../../components/ParentOverview.astro';
import { getCollection } from 'astro:content';
import { steam as m } from '../../../data/steam';

const base = import.meta.env.BASE_URL;
const written = new Set((await getCollection('parent-guides')).map((e) => e.slug));
const groups = [{
  items: m.units.filter((u) => u.home.length > 0).map((u) => ({
    label: u.label,
    href: written.has(`steam/${u.slug}`) ? `${base}${m.parentHref(u.slug)}` : undefined,
  })),
}];

const stages = [{"label": "Grade 5", "idea": "Algorithms with Dash robots, energy in a marble coaster, a water filter, and a Scratch story."}, {"label": "Grade 6", "idea": "Circuits with littleBits, 3-D design, bridges and a glider."}, {"label": "Grade 7", "idea": "Spike Prime robots, heat in a micro:bit box, branching stories and a CO2 dragster."}, {"label": "Grade 8", "idea": "Simple machines in a Rube Goldberg chain, a platform game, a motor circuit and a robot maze."}, {"label": "Grade 9", "idea": "Java or Python, REV robotics, electrified miniatures and a trebuchet."}, {"label": "High school", "idea": "Career and Technology Studies (computing science, robotics, design, electro-technologies) and Physics 20 and 30."}];
const tips: [string, string][] = [["Ask about the design journal", "Ask your child to show you their journal and explain what they changed and why."], ["Praise the process", "Ask “What didn’t work, and what did you try next?” Fixing problems is the main skill."], ["Build at home", "Cardboard, tape, string and recycling make great building materials. Small builds at home use the same design cycle."], ["Try free coding tools", "Scratch (scratch.mit.edu) is free and runs in a browser. Ask your child to show you something they made."], ["Talk in steps", "When planning anything, from a recipe to a trip, ask “What are the steps, in order?” That’s an algorithm."], ["Stay curious together", "Take apart an old toy or gadget (safely, unplugged) and guess what each part does."]];
---

<ParentOverview
  course="steam"
  title="STEAM at home"
  pageTitle="STEAM — Parent guide"
  eyebrow="Parent guide · STEAM"
  numeral="5–9"
  description={"What your child builds and learns in STEAM at each grade, how the grades connect, and simple ways to help, with worked examples and short practice sheets for each grade."}
  aboutHeading={"What STEAM is about"}
  about={["STEAM (science, technology, engineering, arts and math) is a hands-on course. Each grade has four projects: programming robots, building and testing structures and machines, and a capstone build. Students follow a design cycle: plan, build, test, improve.", "The real goal is learning to solve problems: breaking a big job into steps, testing ideas, and fixing what doesn’t work. Mistakes are part of the process, and the design journal records how your child’s thinking changed."]}
  stages={stages}
  groups={groups}
  listHeading="Grades"
  listIntro="Five grades, four projects each. Pick a grade to see the parent guide."
  tips={tips}
/>
