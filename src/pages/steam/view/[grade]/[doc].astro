---
import Nav from '../../../../components/Nav.astro';
import { steam as manifest, steamUnits } from '../../../../data/steam';
import { unitDocs } from '../../../../data/manifest';
import { existsSync } from 'node:fs';
const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
  const docsByGrade: Record<string, string[]> = {
    'grade-5': [
      'steam5-dash-notes-v1', 'steam5-dash-workbook-v1', 'steam5-dash-trainer-v1',
      'steam5-coaster-notes-v1', 'steam5-coaster-workbook-v1',
      'steam5-waterfilter-notes-v1', 'steam5-waterfilter-workbook-v1',
      'steam5-scratch-notes-v1', 'steam5-scratch-workbook-v1',
    ],
    'grade-6': [
      'steam6-littlebits-notes-v1', 'steam6-littlebits-workbook-v1', 'steam6-littlebits-trainer-v1',
      'steam6-bagtag-notes-v1', 'steam6-bagtag-workbook-v1',
      'steam6-bridges-notes-v1', 'steam6-bridges-workbook-v1',
      'steam6-glider-notes-v1', 'steam6-glider-workbook-v1',
    ],
    'grade-7': [
      'steam7-spikeprime-notes-v1', 'steam7-spikeprime-workbook-v1',
      'steam7-thermobox-notes-v1', 'steam7-thermobox-workbook-v1',
      'steam7-cyoa-notes-v1', 'steam7-cyoa-workbook-v1',
      'steam7-dragster-notes-v1', 'steam7-dragster-workbook-v1',
    ],
    'grade-8': [
      'steam8-rubegoldberg-notes-v1', 'steam8-rubegoldberg-workbook-v1',
      'steam8-platformgame-notes-v1', 'steam8-platformgame-workbook-v1',
      'steam8-motor-notes-v1', 'steam8-motor-workbook-v1',
      'steam8-maze-notes-v1', 'steam8-maze-workbook-v1',
    ],
    'grade-9': [
      'steam9-java-notes-v1', 'steam9-java-workbook-v1',
      'steam9-python-notes-v1', 'steam9-python-workbook-v1', 'steam9-python-trainer-v1',
      'steam9-rev-notes-v1', 'steam9-rev-workbook-v1',
      'steam9-rev-notes-python-path-v1', 'steam9-rev-workbook-python-path-v1',
      'steam9-miniatures-notes-v1', 'steam9-miniatures-workbook-v1',
      'steam9-trebuchet-notes-v1', 'steam9-trebuchet-workbook-v1',
    ],
  };

  const paths: { params: { grade: string; doc: string } }[] = [];
  for (const [grade, docs] of Object.entries(docsByGrade)) {
    for (const doc of docs) {
      paths.push({ params: { grade, doc } });
    }
  }
  // Every document the course's pages link to (from the manifest), including
  // the parent home sheets. Routes listed above stay even if no page links them.
  for (const u of manifest.units) {
    for (const doc of unitDocs(u)) {
      if (!existsSync(`public/materials/${doc}.html`)) console.warn(`[${manifest.course}] missing material: ${doc}.html`);
      if (!paths.some((p) => p.params.grade === u.slug && p.params.doc === doc)) paths.push({ params: { grade: u.slug, doc } });
    }
  }
  return paths;
}

const { grade, doc } = Astro.params;

const gradeLabels: Record<string, string> = {
  'grade-5': 'Grade 5',
  'grade-6': 'Grade 6',
  'grade-7': 'Grade 7',
  'grade-8': 'Grade 8',
  'grade-9': 'Grade 9',
};

// Home practice sheets belong to the parent guide; everything else to its unit page.
const isHome = doc!.includes('-home-');
const unit = steamUnits.units.find((u) => unitDocs(u).includes(doc!));
const backHref = isHome ? `${base}${manifest.parentHref(grade!)}` : `${base}${unit ? steamUnits.studentHref(unit.slug) : `steam/materials/${grade}`}`;
const backLabel = isHome ? '← Parent guide' : `← ${unit?.label ?? gradeLabels[grade!] ?? 'STEAM'}`;
const fileUrl = `${base}materials/${doc}.html`;
// Simulations and trainers fill the window: no site nav, a slim back bar, a full-screen button.
const isApp = /-(sim|trainer)-v\d+$/.test(doc!);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{gradeLabels[grade!] ?? grade} — {doc} | STEAM</title>
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <style>
    html, body {
      margin: 0;
      padding: 0;
      height: 100%;
      overflow: hidden;
    }
    .viewer-shell {
      display: flex;
      flex-direction: column;
      height: 100vh;
    }
    .back-bar {
      background: #f6f4ef;
      border-bottom: 1px solid rgb(31 29 26 / 0.07);
      padding: 0.6rem 1.25rem;
      flex-shrink: 0;
    }
    .back-bar a {
      font-family: 'Atkinson Hyperlegible Next Variable', system-ui, sans-serif;
      font-weight: 600;
      font-size: 0.875rem;
      color: #6b665d;
      text-decoration: none;
    }
    .back-bar a:hover { color: #1f1d1a; }
    .doc-frame {
      flex: 1;
      border: none;
      width: 100%;
      display: block;
    }
    @media print {
      .viewer-nav, .back-bar { display: none !important; }
      .doc-frame { height: 100vh; }
    }
    .back-bar.app { padding: 0.3rem 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .fs-btn { font: 600 0.8rem system-ui, sans-serif; color: #6b665d; background: #fff; border: 1px solid rgb(31 29 26 / 0.15); border-radius: 8px; padding: 0.3rem 0.75rem; cursor: pointer; }
    .fs-btn:hover { color: #1f1d1a; }
  </style>
</head>
<body>
  <div class="viewer-shell">
    {!isApp && (
      <div class="viewer-nav">
        <Nav course="steam" />
      </div>
    )}
    <div class:list={['back-bar', { app: isApp }]}>
      <a href={backHref}>{backLabel}</a>
      {isApp && <button type="button" id="fs-btn" class="fs-btn">⛶ Full screen</button>}
    </div>
    <iframe
      src={fileUrl}
      class="doc-frame"
      title={doc}
      allowfullscreen
    />
  </div>
  <script is:inline>
    var fsBtn = document.getElementById('fs-btn');
    if (fsBtn) fsBtn.addEventListener('click', function () {
      var f = document.querySelector('.doc-frame'), go = f.requestFullscreen || f.webkitRequestFullscreen;
      if (go) go.call(f);
    });
  </script>
  <script is:inline>
    // Pass a section id (#s3) on to the document, so a link can open one notes section.
    (function () {
      var f = document.querySelector('.doc-frame');
      function go() { if (f && location.hash) f.src = f.src.split('#')[0] + location.hash; }
      go();
      window.addEventListener('hashchange', go);
    })();
  </script>
</body>
</html>
