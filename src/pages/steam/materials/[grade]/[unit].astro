---
// Student unit page (shared StudentUnit layout). Materials come from
// src/data/steam.ts; the intro from src/content/steam-units/grade-N/.
import StudentUnit from '../../../../components/StudentUnit.astro';
import { getEntry } from 'astro:content';
import { steamUnits as m, steamGrades, steamUnitsInGrade, splitSteamSlug } from '../../../../data/steam';

export function getStaticPaths() {
  return steamGrades.flatMap((g) =>
    steamUnitsInGrade(g).map((u, i) => ({ params: { grade: `grade-${g}`, unit: splitSteamSlug(u.slug).unit }, props: { g, i } })),
  );
}

const { g, i } = Astro.props as { g: number; i: number };
const units = steamUnitsInGrade(g);
const u = units[i];
const { unit } = splitSteamSlug(u.slug);
const entry = await getEntry('steam-units', `grade-${g}/${unit}`);
if (!entry) throw new Error(`steam-units/grade-${g}/${unit}.md is missing`);
const { Content } = await entry.render();
const base = import.meta.env.BASE_URL;
---

<StudentUnit
  manifest={m}
  unit={u}
  title={`Grade ${g} ${u.label} — STEAM Materials`}
  eyebrow={`STEAM Grade ${g} · Unit ${i + 1}`}
  back={{ href: `${base}steam/materials/grade-${g}`, label: `STEAM Grade ${g}` }}
  intro={entry.data}
  Content={Content}
  prev={units[i - 1]}
  next={units[i + 1]}
/>
