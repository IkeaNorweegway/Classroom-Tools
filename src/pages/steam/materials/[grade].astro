---
// STEAM grade page (shared StudentUnit layout): the grade's four projects as
// numbered steps. Materials come from src/data/steam.ts; the intro from
// src/content/steam-grades/.
import StudentUnit from '../../../components/StudentUnit.astro';
import { getEntry } from 'astro:content';
import { steam as m } from '../../../data/steam';

export function getStaticPaths() {
  return m.units.map((u, i) => ({ params: { grade: u.slug }, props: { i } }));
}

const { i } = Astro.props as { i: number };
const u = m.units[i];
const entry = await getEntry('steam-grades', u.slug);
if (!entry) throw new Error(`steam-grades/${u.slug}.md is missing`);
const { Content } = await entry.render();
const base = import.meta.env.BASE_URL;
---

<StudentUnit
  manifest={m}
  unit={u}
  title={`${u.label} — STEAM Materials`}
  eyebrow={`STEAM · ${u.label}`}
  back={{ href: `${base}steam`, label: 'STEAM' }}
  intro={entry.data}
  Content={Content}
  prev={m.units[i - 1]}
  next={m.units[i + 1]}
/>
