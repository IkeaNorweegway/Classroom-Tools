---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TeacherHub from '../../../components/TeacherHub.astro';
import { getCollection } from 'astro:content';
import { science7 } from '../../../data/science7';

// Per-unit tier, weeks, colour and misconception flags. Names, guides and keys come from the manifest.
const meta = [
  { slug: 'interactions-ecosystems', tier: 1, weeks: '6–7', color: '#059669', tagStyle: 'bg-emerald-100 text-emerald-800', misconceptions: ['Ecosystems can recover from any disturbance', 'Decomposers are not important', 'Food chains are linear in nature'] },
  { slug: 'plants-food-fibre', tier: 1, weeks: '5–6', color: '#16a34a', tagStyle: 'bg-green-100 text-green-800', misconceptions: ['Plants get food from soil', 'Photosynthesis and respiration are opposites', 'GMO and selective breeding are the same'] },
  { slug: 'heat-temperature', tier: 1, weeks: '5–6', color: '#ea580c', tagStyle: 'bg-orange-100 text-orange-800', misconceptions: ['Cold travels into warm spaces', 'Metal is colder than wood', 'Heat and temperature are the same'] },
  { slug: 'structures-forces', tier: 2, weeks: '5–6', color: '#7c3aed', tagStyle: 'bg-violet-100 text-violet-800', misconceptions: ['Simple machines reduce the work done', 'Heavier = more stable', 'Compression and tension are the same'] },
  { slug: 'planet-earth', tier: 2, weeks: '4–5', color: '#d97706', tagStyle: 'bg-amber-100 text-amber-800', misconceptions: ['Continents are fixed', 'Volcanoes and earthquakes happen everywhere', 'Sedimentary rocks form quickly'] },
];

// One-line scope notes per unit, from the unit files.
const summaries = Object.fromEntries((await getCollection('science7-units')).map((e) => [e.slug, e.data.teacherSummary]));
const units = meta.map((u) => ({
  ...u,
  tag: `Tier ${u.tier}`,
  meta: `${u.weeks} weeks`,
  summary: summaries[u.slug] ?? '',
}));
---

<BaseLayout title="Science 7 — Teacher Hub" course="science7" audience="teacher">
  <TeacherHub
    course="science7"
    name="Grade 7 Science"
    accent="#b45309"
    manifest={science7}
    units={units}
    guideNote="SHOW / SAY / CUE · Lesson Sequence · Lab Notes"
  />
</BaseLayout>
