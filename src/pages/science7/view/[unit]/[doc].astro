---
import Nav from '../../../../components/Nav.astro';
import { science7 as manifest } from '../../../../data/science7';
import { unitDocs } from '../../../../data/manifest';
import { existsSync } from 'node:fs';
const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
  const unitFiles: Record<string, string[]> = {
    'interactions-ecosystems': [
      'sci7-interactions-ecosystems-notes-v1',
      'sci7-interactions-ecosystems-workbook-v1',
      'sci7-interactions-ecosystems-exits-v1',
      'sci7-interactions-ecosystems-quiz-v1',
      'sci7-interactions-ecosystems-test-v1',
      'sci7-interactions-ecosystems-notes-answers-v2',
      'sci7-interactions-ecosystems-workbook-answers-v1',
      'sci7-interactions-ecosystems-assessment-answers-v1',
      'sci7-interactions-ecosystems-teacherguide-v2',
    ],
    'plants-food-fibre': [
      'sci7-plants-food-fibre-notes-v1',
      'sci7-plants-food-fibre-workbook-v1',
      'sci7-plants-food-fibre-exits-v1',
      'sci7-plants-food-fibre-quiz-v1',
      'sci7-plants-food-fibre-test-v1',
      'sci7-plants-food-fibre-notes-answers-v2',
      'sci7-plants-food-fibre-workbook-answers-v1',
      'sci7-plants-food-fibre-assessment-answers-v1',
      'sci7-plants-food-fibre-teacherguide-v2',
      'sci7-plant-systems-organizer-ipp-v1',
      'sci7-plant-cells-organizer-ipp-v1',
      'sci7-photosynthesis-organizer-ipp-v1',
      'sci7-reproduction-organizer-ipp-v1',
      'sci7-photosynthesis-organizer-nonreader-cards-v1',
      'sci7-photosynthesis-organizer-nonreader-circle-v1',
      'sci7-plant-systems-organizer-nonreader-cards-v1',
      'sci7-plant-systems-organizer-nonreader-circle-v1',
      'sci7-plant-hunt-outdoor-v1',
      'sci7-plant-hunt-outdoor-ipp-v1',
      'sci7-lily-dissection-lab-v1',
      'sci7-lily-dissection-lab-ipp-v1',
      'sci7-lily-dissection-lab-teachernotes-v1',
      'sci7-photosynthesis-sim-v2',
      'sci7-flower-reproduction-sim-v2',
      'sci7-flower-field-game-v1',
      'sci7-flower-field-game-v2',
      'sci7-clone-field-game-v1',
      'sci7-clone-field-game-v2',
      'sci7-seed-to-seed-game-v1',
      'sci7-seed-to-seed-game-v2',
    ],
    'heat-temperature': [
      'sci7-heat-temperature-notes-v1',
      'sci7-heat-temperature-workbook-v1',
      'sci7-heat-temperature-exits-v1',
      'sci7-heat-temperature-quiz-v1',
      'sci7-heat-temperature-test-v1',
      'sci7-heat-temperature-notes-answers-v2',
      'sci7-heat-temperature-workbook-answers-v1',
      'sci7-heat-temperature-assessment-answers-v1',
      'sci7-heat-temperature-teacherguide-v3',
    ],
    'structures-forces': [
      'sci7-structures-forces-notes-v1',
      'sci7-structures-forces-workbook-v1',
      'sci7-structures-forces-exits-v1',
      'sci7-structures-forces-quiz-v1',
      'sci7-structures-forces-test-v1',
      'sci7-structures-forces-notes-answers-v2',
      'sci7-structures-forces-workbook-answers-v1',
      'sci7-structures-forces-assessment-answers-v1',
      'sci7-structures-forces-teacherguide-v2',
    ],
    'planet-earth': [
      'sci7-planet-earth-notes-v1',
      'sci7-planet-earth-workbook-v1',
      'sci7-planet-earth-exits-v1',
      'sci7-planet-earth-quiz-v1',
      'sci7-planet-earth-test-v1',
      'sci7-planet-earth-notes-answers-v2',
      'sci7-planet-earth-workbook-answers-v1',
      'sci7-planet-earth-assessment-answers-v1',
      'sci7-planet-earth-teacherguide-v2',
    ],
  };

  const paths: { params: { unit: string; doc: string } }[] = [];
  for (const [unit, files] of Object.entries(unitFiles)) {
    for (const doc of files) {
      paths.push({ params: { unit, doc } });
    }
  }
  // Every document the course's pages link to (from the manifest), including
  // the parent home sheets. Routes listed above stay even if no page links them.
  for (const u of manifest.units) {
    for (const doc of unitDocs(u)) {
      if (!existsSync(`public/materials/${doc}.html`)) console.warn(`[${manifest.course}] missing material: ${doc}.html`);
      if (!paths.some((p) => p.params.unit === u.slug && p.params.doc === doc)) paths.push({ params: { unit: u.slug, doc } });
    }
  }
  return paths;
}

const { unit, doc } = Astro.params;

const unitLabels: Record<string, string> = {
  'interactions-ecosystems': 'Interactions and Ecosystems',
  'plants-food-fibre': 'Plants for Food and Fibre',
  'heat-temperature': 'Heat and Temperature',
  'structures-forces': 'Structures and Forces',
  'planet-earth': 'Planet Earth',
};

// Home practice sheets belong to the parent guide; everything else to the unit page.
const isHome = doc!.includes('-home-');
const backHref = isHome ? `${base}${manifest.parentHref(unit!)}` : `${base}science7/materials/${unit}`;
const backLabel = isHome ? '← Parent guide' : `← ${unitLabels[unit] ?? 'Science 7'}`;
const fileUrl = `${base}materials/${doc}.html`;
// Simulations and trainers fill the window: no site nav, a slim back bar, a full-screen button.
const isApp = /-(sim|trainer)-v\d+$/.test(doc!);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{unitLabels[unit] ?? unit} — {doc} | Grade 7 Science</title>
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <style>
    html, body {
      margin: 0;
      padding: 0;
      height: 100%;
      overflow: hidden;
    }
    .viewer-shell {
      display: flex;
      flex-direction: column;
      height: 100vh;
    }
    .back-bar {
      background: #f6f4ef;
      border-bottom: 1px solid rgb(31 29 26 / 0.07);
      padding: 0.6rem 1.25rem;
      flex-shrink: 0;
    }
    .back-bar a {
      font-family: 'Atkinson Hyperlegible Next Variable', system-ui, sans-serif;
      font-weight: 600;
      font-size: 0.875rem;
      color: #6b665d;
      text-decoration: none;
    }
    .back-bar a:hover { color: #1f1d1a; }
    .doc-frame {
      flex: 1;
      border: none;
      width: 100%;
      display: block;
    }
    @media print {
      .viewer-nav, .back-bar { display: none !important; }
      .doc-frame { height: 100vh; }
    }
    .back-bar.app { padding: 0.3rem 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .fs-btn { font: 600 0.8rem system-ui, sans-serif; color: #6b665d; background: #fff; border: 1px solid rgb(31 29 26 / 0.15); border-radius: 8px; padding: 0.3rem 0.75rem; cursor: pointer; }
    .fs-btn:hover { color: #1f1d1a; }
  </style>
</head>
<body>
  <div class="viewer-shell">
    {!isApp && (
      <div class="viewer-nav">
        <Nav course="science7" />
      </div>
    )}
    <div class:list={['back-bar', { app: isApp }]}>
      <a href={backHref}>{backLabel}</a>
      {isApp && <button type="button" id="fs-btn" class="fs-btn">⛶ Full screen</button>}
    </div>
    <iframe
      src={fileUrl}
      class="doc-frame"
      title={doc}
      allowfullscreen
    />
  </div>
  <script is:inline>
    var fsBtn = document.getElementById('fs-btn');
    if (fsBtn) fsBtn.addEventListener('click', function () {
      var f = document.querySelector('.doc-frame'), go = f.requestFullscreen || f.webkitRequestFullscreen;
      if (go) go.call(f);
    });
  </script>
  <script is:inline>
    // Pass a section id (#s3) on to the document, so a link can open one notes section.
    (function () {
      var f = document.querySelector('.doc-frame');
      function go() { if (f && location.hash) f.src = f.src.split('#')[0] + location.hash; }
      go();
      window.addEventListener('hashchange', go);
      // Answer-key links in a notes file (.key-link, from scripts/add_key_links.pl) point at
      // the key file beside it. Open the key in this viewer instead, in the whole window.
      function keyLinks() {
        var d; try { d = f.contentDocument; } catch (e) { return; }
        if (!d) return;
        var here = location.pathname.replace(/[^/]*\/?$/, '');
        d.querySelectorAll('.key-link a').forEach(function (a) {
          var u = new URL(a.getAttribute('href'), d.baseURI);
          a.href = here + u.pathname.split('/').pop().replace(/\.html$/, '') + u.hash;
          a.target = '_top';
        });
      }
      if (f) { f.addEventListener('load', keyLinks); keyLinks(); }
    })();
  </script>
</body>
</html>
