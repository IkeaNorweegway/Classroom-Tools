---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ActionCard from '../../../components/ActionCard.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout course="science7" title="Word Problems — Science 7">
  <div class="mb-8">
    <p class="text-xs font-bold uppercase tracking-widest text-emerald-600 mb-2">Science 7</p>
    <h1 class="text-3xl font-bold text-slate-900 mb-2">Word Problems</h1>
    <p class="text-slate-500 max-w-2xl">
      Real Alberta situations, often with a small data table, like the application questions in the workbooks and unit tests. Not every sentence matters: find the key facts first, then the science idea, then what you can assume, and only then answer.
      <strong class="text-slate-700">Part a</strong> applies one idea, and <strong class="text-slate-700">parts b and c</strong> read the data, predict what happens next, or judge a claim.
    </p>
  </div>

  <div class="grid sm:grid-cols-2 gap-4 mb-10">
    <ActionCard
      href={`${base}science7/view/word-problems/sci7-word-problems-trainer-v3`}
      title="Word Problems Trainer"
      description="Each scenario has 2–3 linked parts. Work through each part step by step, and finish by picking the best written answer. A picture and the reasoning come after. Ecosystems and Plants so far; more units coming."
      cta="Practise"
    />
  </div>
</BaseLayout>
