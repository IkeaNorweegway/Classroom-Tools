---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WordProblems from '../../../components/WordProblems.astro';
---

<BaseLayout course="science7" title="Word Problems — Science 7">
  <div class="mb-8">
    <p class="text-xs font-bold uppercase tracking-widest text-emerald-600 mb-2">Science 7</p>
    <h1 class="text-3xl font-bold text-slate-900 mb-2">Word Problems</h1>
    <p class="text-slate-500 max-w-2xl">
      Science calculations for every unit at three levels. <strong class="text-slate-700">Level 1</strong> takes one step,
      <strong class="text-slate-700">Level 2</strong> takes two, and <strong class="text-slate-700">Level 3</strong> takes three or more.
      Every set is new numbers each time, with hints and worked solutions.
    </p>
  </div>
  <WordProblems courseName="Science 7" />
</BaseLayout>

<script>
  import { initWordProblems } from '../../../scripts/word-problems/engine.js';
  import { SCIENCE7_TOPICS } from '../../../scripts/word-problems/science7.js';
  initWordProblems({ topics: SCIENCE7_TOPICS, storageKey: 'science7-word-problems', courseName: 'Science 7' });
</script>
