---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ActionCard from '../../../components/ActionCard.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout course="science7" title="Word Problems — Science 7">
  <div class="mb-8">
    <p class="text-xs font-bold uppercase tracking-widest text-emerald-600 mb-2">Science 7</p>
    <h1 class="text-3xl font-bold text-slate-900 mb-2">Word Problems</h1>
    <p class="text-slate-500 max-w-2xl">
      Science stories from every unit, set in Alberta, that practise careful reading. Not every sentence matters: find the key facts first, then the science idea, then what you can assume, and only then answer.
      <strong class="text-slate-700">Level 1</strong> names the science idea, <strong class="text-slate-700">Level 2</strong> uses it to predict or explain,
      and <strong class="text-slate-700">Level 3</strong> follows a chain of causes and effects.
    </p>
  </div>

  <div class="grid sm:grid-cols-2 gap-4 mb-10">
    <ActionCard
      href={`${base}science7/view/word-problems/sci7-word-problems-trainer-v2`}
      title="Word Problems Trainer"
      description="Read a science story from each unit, then work through it step by step: tap the key facts, pick the science idea, decide what you can assume, and answer. A picture of the story and the reasoning come after."
      cta="Practise"
    />
  </div>
</BaseLayout>
