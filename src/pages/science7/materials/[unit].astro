const data = units[unit];

const unitEntry = await getEntry('science7-units', unit!);
const { Content } = unitEntry ? await unitEntry.render() : { Content: null };
---

<BaseLayout title={`${data.label} — Materials`} course="science7">
  <CourseHero
    back={{ href: `${base}science7`, label: 'Grade 7 Science' }}
    eyebrow={unitEntry ? `Grade 7 Science · Tier ${unitEntry.data.tier} · ${unitEntry.data.weeks} weeks` : 'Grade 7 Science'}
    title={data.label}
    description={unitEntry ? unitEntry.data.guidingQuestion : data.tagline}
    italic={!!unitEntry}
  />

  {unitEntry && (
    <>
      <div class="mb-8 rounded-2xl border border-slate-900/[0.07] bg-accent-soft/60 p-6">
        <p class="mb-1.5 text-sm font-semibold text-accent-ink">Learning outcome</p>
        <p class="max-w-[68ch] text-slate-800 leading-relaxed">{unitEntry.data.learningOutcome}</p>
      </div>
      <Collapsible class="mb-12">
        <div class="prose max-w-none">
          <Content />
        </div>
      </Collapsible>
    </>
  )}

  {data.sections.map(section => (
    <MaterialList
      heading={section.heading}
      items={section.items.map(item => ({ label: item.label, badge: item.badge, href: `${base}science7/view/${unit}/${item.doc}` }))}
    />
  ))}

  <MaterialList
    heading="Assessments"
    items={data.assessments.map(item => ({ label: item.label, href: `${base}science7/view/${unit}/${item.doc}` }))}
  />

  <MaterialList
    answerKeys
    heading="Show answer keys"
    items={data.answerKeys.map(item => ({ label: item.label, href: `${base}science7/view/${unit}/${item.doc}` }))}
  />
</BaseLayout>
