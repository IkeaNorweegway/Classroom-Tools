---
// Student unit page (shared StudentUnit layout). Materials come from
// src/data/science7.ts; the intro from src/content/science7-units/.
import StudentUnit from '../../../components/StudentUnit.astro';
import { getEntry } from 'astro:content';
import { science7 as m } from '../../../data/science7';

export function getStaticPaths() {
  return m.units.map((u, i) => ({ params: { unit: u.slug }, props: { i } }));
}

const { i } = Astro.props as { i: number };
const u = m.units[i];
const entry = await getEntry('science7-units', u.slug);
if (!entry) throw new Error(`science7-units/${u.slug}.md is missing`);
const { Content } = await entry.render();
const base = import.meta.env.BASE_URL;
---

<StudentUnit
  manifest={m}
  unit={u}
  title={`${u.label} — Materials`}
  eyebrow={`Grade 7 Science · Unit ${i + 1}`}
  back={{ href: `${base}science7`, label: 'Grade 7 Science' }}
  intro={entry.data}
  Content={Content}
  prev={m.units[i - 1]}
  next={m.units[i + 1]}
/>
