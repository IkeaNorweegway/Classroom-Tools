---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseHero from '../../components/CourseHero.astro';
import TopicList from '../../components/TopicList.astro';
import ActionCard from '../../components/ActionCard.astro';
const base = import.meta.env.BASE_URL;

const units = [
  {
    slug: 'interactions-ecosystems',
    label: 'Interactions and Ecosystems',
    description: 'Ecosystems, food webs, energy pyramids, biodiversity, and human impacts on Alberta ecosystems.',
    color: '#059669',
    colorDark: '#047857',
    colorLight: '#d1fae5',
  },
  {
    slug: 'plants-food-fibre',
    label: 'Plants for Food and Fibre',
    description: 'Cell theory, plant systems, photosynthesis, reproduction, Alberta agriculture, and biotechnology.',
    color: '#16a34a',
    colorDark: '#15803d',
    colorLight: '#dcfce7',
  },
  {
    slug: 'heat-temperature',
    label: 'Heat and Temperature',
    description: 'Temperature scales, heat vs. temperature, the particle model, modes of heat transfer, and specific heat.',
    color: '#ea580c',
    colorDark: '#c2410c',
    colorLight: '#ffedd5',
  },
  {
    slug: 'structures-forces',
    label: 'Structures and Forces',
    description: 'Structure types, loads, internal forces, stability, simple machines, and materials.',
    color: '#7c3aed',
    colorDark: '#6d28d9',
    colorLight: '#ede9fe',
  },
  {
    slug: 'planet-earth',
    label: 'Planet Earth',
    description: "Earth's interior, the rock cycle, plate tectonics, earthquakes, landforms, and geological time.",
    color: '#d97706',
    colorDark: '#b45309',
    colorLight: '#fef3c7',
  },
];
---

<BaseLayout course="science7" title="Grade 7 Science">
  <CourseHero
    eyebrow="Alberta curriculum · 2007"
    title="Grade 7 Science"
    numeral="7"
    vtName="course-num-science7"
    description="Five units. Notes, workbooks, quizzes, tests, and answer keys."
    facts={[
      { n: '5', label: 'units' },
      { n: '~26', label: 'weeks' },
      { n: '40', label: 'materials' },
      { n: '30', label: 'exit tickets' },
    ]}
  />

  <TopicList
    heading="Units"
    items={units.map(u => ({ href: `${base}science7/materials/${u.slug}`, title: u.label, description: u.description }))}
  />

  <div class="grid gap-4 sm:grid-cols-2">
    <ActionCard
      href={`${base}science7/practice`}
      title="Prereq practice"
      description="Review the vocabulary and concepts you need before each unit. Randomized questions with worked answers."
      cta="Practice"
      index={5}
    />
  </div>
</BaseLayout>
