---
// Parent overview for Grade 7 Social Studies (shared ParentOverview layout).
import ParentOverview from '../../../components/ParentOverview.astro';
import { getCollection } from 'astro:content';
import { social7 as m } from '../../../data/social7';

const base = import.meta.env.BASE_URL;
const written = new Set((await getCollection('parent-guides')).map((e) => e.slug));
const groups = [{
  items: m.units.filter((u) => u.home.length > 0).map((u) => ({
    label: u.label,
    href: written.has(`social7/${u.slug}`) ? `${base}${m.parentHref(u.slug)}` : undefined,
  })),
}];

const stages = [{"label": "Grade 6", "idea": "How democracy works in Canada: rights, voting and local government."}, {"label": "Grade 7", "idea": "Building Canada after Confederation: expansion west, the new government, the economy, immigration and the armed forces.", "now": true}, {"label": "Grade 8", "idea": "Ideologies, economic systems, political systems and civic engagement."}, {"label": "Grade 9", "idea": "Canada in the 20th century: industry, independence, the Second World War, the economy, government and citizenship."}, {"label": "High school", "idea": "Social 10 (globalization), 20 (nationalism) and 30 (ideology). Social 20 returns to how Canada was built as a nation."}];
const tips: [string, string][] = [["Talk about the news", "Pick a headline together and ask “Who is affected? What do different people think about it?”"], ["Ask for evidence", "When your child gives an opinion, ask “What makes you think that?” Good answers point to facts or sources."], ["Look at more than one side", "Ask “How might someone else see this?” Considering other perspectives is a key skill in social studies."], ["Use their notes", "The notes show how ideas were taught in class. Reading a section together before practice helps."], ["Learn the key words", "Words like ideology, democracy and economy have specific meanings. Ask your child to explain one in their own words."], ["Short and often", "Fifteen focused minutes a few times a week beats a long session the night before a test."]];
---

<ParentOverview
  course="social7"
  title="Grade 8 social studies at home"
  pageTitle="Social Studies 7 — Parent guide"
  eyebrow="Parent guide · Grade 7 Social Studies"
  numeral="7"
  description={"What your child is learning in social studies this year, how it connects to earlier and later grades, and simple ways to help, with worked examples and short practice sheets for each unit."}
  aboutHeading={"What Grade 7 social studies is about"}
  about={["Grade 7 social studies tells the story of how Canada was built after 1867: how four colonies became a country, how the government expanded west and set up its system of government, how it grew the economy and brought in settlers, and how Canada built its own police and military on the way to running its own affairs.", "Along the way students practise thinking like historians: reading maps and timelines, telling facts from opinions in old sources, looking at events from several points of view, including First Nations, Métis and immigrant perspectives, and backing up a judgement with evidence."]}
  stages={stages}
  groups={groups}
  listHeading="Units this year"
  listIntro="Five units. Pick one to see the parent guide."
  tips={tips}
/>
