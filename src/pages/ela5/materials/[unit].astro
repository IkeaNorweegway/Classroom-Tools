---
// Student unit page (shared StudentUnit layout). Materials come from
// src/data/ela5.ts; the intro from src/content/ela5-units/.
import StudentUnit from '../../../components/StudentUnit.astro';
import { getEntry } from 'astro:content';
import { ela5 as m } from '../../../data/ela5';

export function getStaticPaths() {
  return m.units.map((u, i) => ({ params: { unit: u.slug }, props: { i } }));
}

const { i } = Astro.props as { i: number };
const u = m.units[i];
const entry = await getEntry('ela5-units', u.slug);
if (!entry) throw new Error(`ela5-units/${u.slug}.md is missing`);
const { Content } = await entry.render();
const base = import.meta.env.BASE_URL;
---

<StudentUnit
  manifest={m}
  unit={u}
  title={`${u.label} — Materials`}
  eyebrow={`English Language Arts 5 · Unit ${i + 1}`}
  back={{ href: `${base}ela5`, label: 'English Language Arts 5' }}
  intro={entry.data}
  Content={Content}
  prev={m.units[i - 1]}
  next={m.units[i + 1]}
/>
