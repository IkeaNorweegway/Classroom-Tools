---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TeacherHub from '../../../components/TeacherHub.astro';
import { getCollection } from 'astro:content';
import { ela5 } from '../../../data/ela5';

// Per-unit colour and genre tag. Names and documents come from the manifest.
const meta = [
  { slug: 'tall-tales', tag: 'Narrative · 30 lessons', color: '#b4235a', tagStyle: 'bg-pink-100 text-pink-800' },
  { slug: 'information-report', tag: 'Non-fiction · 30 lessons', color: '#9a2d5c', tagStyle: 'bg-rose-100 text-rose-800' },
  { slug: 'opinion', tag: 'Persuasive · 30 lessons', color: '#8a2f6e', tagStyle: 'bg-fuchsia-100 text-fuchsia-800' },
  { slug: 'science-fiction', tag: 'Fiction · 30 lessons', color: '#6d2f8a', tagStyle: 'bg-purple-100 text-purple-800' },
  { slug: 'lyric-poetry', tag: 'Poetry · 20 lessons', color: '#4f3c8f', tagStyle: 'bg-violet-100 text-violet-800' },
  { slug: 'scripted-drama', tag: 'Drama · 30 lessons', color: '#3f4a8f', tagStyle: 'bg-indigo-100 text-indigo-800' },
];

// One-line scope note per unit, from the unit files.
const summaries = Object.fromEntries((await getCollection('ela5-units')).map((e) => [e.slug, e.data.teacherSummary]));
const units = meta.map((u) => ({ ...u, summary: summaries[u.slug] ?? '' }));
---

<BaseLayout title="ELA 5 — Teacher Hub" course="ela5" audience="teacher">
  <a
    href={`${import.meta.env.BASE_URL}ela5/view/course/ela5-course-guide-v1`}
    class="mb-6 block rounded-xl border border-slate-200 bg-white px-4 py-3 hover:border-slate-400"
  >
    <span class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Start here · 2-page guide</span>
    <span class="block font-semibold text-slate-800">How to use the Grade 5 ELA materials, and why each one is there →</span>
  </a>
  <TeacherHub course="ela5" name="English Language Arts 5" accent="#b4235a" manifest={ela5} units={units} guideNote="Lesson cards · Outcome map · Groups and editions" />
</BaseLayout>
