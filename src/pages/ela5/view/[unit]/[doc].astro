---
import Nav from '../../../../components/Nav.astro';
import { ela5 as manifest, ela5Folder } from '../../../../data/ela5';
import { unitDocs } from '../../../../data/manifest';
import { existsSync } from 'node:fs';
const base = import.meta.env.BASE_URL;

// Grade 5 ELA files live in public/materials/grade-5-ela/, not flat.
export function getStaticPaths() {
  const paths: { params: { unit: string; doc: string } }[] = [];
  for (const u of manifest.units) {
    const docs = [...unitDocs(u), ...(u.teacherGuide ? [u.teacherGuide] : [])];
    for (const doc of docs) {
      if (!existsSync(`public/materials/${ela5Folder}/${doc}.html`)) console.warn(`[ela5] missing material: ${doc}.html`);
      if (!paths.some((p) => p.params.unit === u.slug && p.params.doc === doc)) paths.push({ params: { unit: u.slug, doc } });
    }
  }
  return paths;
}

const { unit, doc } = Astro.params;
const label = manifest.units.find((u) => u.slug === unit)?.label ?? 'English Language Arts 5';

// Home sheets go back to the parent guide, the teacher guide to the hub, everything else to the unit page.
const isHome = doc!.includes('-home-');
const isGuide = doc!.includes('-teacherguide-');
const backHref = isHome ? `${base}${manifest.parentHref(unit!)}` : isGuide ? `${base}ela5/teacher#${unit}` : `${base}${manifest.studentHref(unit!)}`;
const backLabel = isHome ? '← Parent guide' : isGuide ? '← Teacher hub' : `← ${label}`;
const fileUrl = `${base}materials/${ela5Folder}/${doc}.html`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{label} — {doc} | English Language Arts 5</title>
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <style>
    html, body {
      margin: 0;
      padding: 0;
      height: 100%;
      overflow: hidden;
    }
    .viewer-shell {
      display: flex;
      flex-direction: column;
      height: 100vh;
    }
    .back-bar {
      background: #f6f4ef;
      border-bottom: 1px solid rgb(31 29 26 / 0.07);
      padding: 0.6rem 1.25rem;
      flex-shrink: 0;
    }
    .back-bar a {
      font-family: 'Atkinson Hyperlegible Next Variable', system-ui, sans-serif;
      font-weight: 600;
      font-size: 0.875rem;
      color: #6b665d;
      text-decoration: none;
    }
    .back-bar a:hover { color: #1f1d1a; }
    .doc-frame {
      flex: 1;
      border: none;
      width: 100%;
      display: block;
    }
    @media print {
      .viewer-nav, .back-bar { display: none !important; }
      .doc-frame { height: 100vh; }
    }
  </style>
</head>
<body>
  <div class="viewer-shell">
    <div class="viewer-nav">
      <Nav course="ela5" />
    </div>
    <div class="back-bar">
      <a href={backHref}>{backLabel}</a>
    </div>
    <iframe
      src={fileUrl}
      class="doc-frame"
      title={doc}
    />
  </div>
</body>
</html>
