---
// Secondary destination (Practice, Problem of the Day, PAT Prep, Year Review…).
interface Props {
  href: string;
  title: string;
  description: string;
  cta: string;
  index?: number;
  lang?: string;
}

const { href, title, description, cta, index = 0, lang } = Astro.props;
---

<a
  href={href}
  lang={lang}
  class="tile rise group flex h-full flex-col rounded-2xl border border-slate-900/[0.07] bg-accent-soft/60 p-6"
  style={`--i: ${index}`}
>
  <span class="block text-[1.0625rem] font-bold text-slate-900">{title}</span>
  <span class="mt-2 block flex-1 text-[0.9375rem] leading-relaxed text-slate-600">{description}</span>
  <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-accent-ink">
    {cta} <span class="arrow" aria-hidden="true">→</span>
  </span>
</a>
