---
// Numbered list of units, strands or grades on a single surface. Each row
// tints and nudges its arrow on hover; rows rise in with a short stagger.
interface Item {
  href: string;
  title: string;
  kicker?: string;
  description?: string;
  meta?: string;
}

interface Props {
  items: Item[];
  heading?: string;
  numbered?: boolean;
}

const { items, heading, numbered = true } = Astro.props;
---

<section class="mb-10">
  {heading && <h2 class="mb-4 text-sm font-semibold text-slate-500">{heading}</h2>}
  <ol class="overflow-hidden rounded-2xl border border-slate-900/[0.07] bg-[rgb(var(--surface))] divide-y divide-slate-900/[0.06]">
    {items.map((item, i) => (
      <li class="rise" style={`--i: ${i}`}>
        <a href={item.href} class="row group flex items-start gap-5 px-5 py-5 sm:px-7 sm:py-6">
          {numbered && (
            <span class="font-display w-7 shrink-0 pt-0.5 text-lg font-medium text-accent/70 tabular" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
          )}
          <span class="min-w-0 flex-1">
            {item.kicker && <span class="mb-1 block text-[0.8125rem] font-semibold text-accent-ink">{item.kicker}</span>}
            <span class="block text-[1.0625rem] font-bold text-slate-900">{item.title}</span>
            {item.description && <span class="mt-1.5 block max-w-[62ch] text-[0.9375rem] leading-relaxed text-slate-600">{item.description}</span>}
            {item.meta && <span class="mt-2 block text-[0.8125rem] text-slate-500">{item.meta}</span>}
          </span>
          <span class="arrow mt-0.5 shrink-0 text-lg text-accent opacity-50" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ol>
</section>
