---
// Numbered list of units, strands or grades as raised cards. Each card lifts
// with a course-tinted shadow on hover; cards rise in with a short stagger.
// Items with `art` (a key in src/data/unitArt.ts) show a spot illustration of
// the unit's core idea, which moves on hover.
import { unitArt } from '../data/unitArt';

interface Item {
  art?: string;
  href: string;
  title: string;
  kicker?: string;
  description?: string;
  meta?: string;
}

interface Props {
  items: Item[];
  heading?: string;
  numbered?: boolean;
}

const { items, heading, numbered = true } = Astro.props;
---

<section class="mb-10">
  {heading && <h2 class="mb-4 text-sm font-semibold text-slate-500">{heading}</h2>}
  <ol class="grid gap-3">
    {items.map((item, i) => (
      <li class="rise" style={`--i: ${i}`}>
        <a href={item.href} class="lift group flex items-center gap-5 rounded-2xl px-5 py-5 sm:px-7 sm:py-6">
          {item.art && unitArt[item.art] ? (
            <span class="unit-art-tile" aria-hidden="true">
              <svg class="unit-art" data-m={unitArt[item.art].m} viewBox="0 0 64 64" fill="none" set:html={unitArt[item.art].svg} />
              {numbered && <span class="unit-art-num font-display tabular">{String(i + 1).padStart(2, '0')}</span>}
            </span>
          ) : numbered && (
            <span class="num-chip font-display shrink-0 tabular" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
          )}
          <span class="min-w-0 flex-1">
            {item.kicker && <span class="mb-1 block text-[0.8125rem] font-semibold text-accent-ink">{item.kicker}</span>}
            <span class="block text-[1.0625rem] font-bold text-slate-900">{item.title}</span>
            {item.description && <span class="mt-1.5 block max-w-[62ch] text-[0.9375rem] leading-relaxed text-slate-600">{item.description}</span>}
            {item.meta && <span class="mt-2 block text-[0.8125rem] text-slate-500">{item.meta}</span>}
          </span>
          <span class="arrow mt-1.5 shrink-0 text-lg text-accent opacity-60" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ol>
</section>
