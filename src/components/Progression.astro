---
// "The big picture" strip for parent pages: earlier grades → this year →
// later courses. A row on wide screens, a vertical timeline on phones.
interface Stage {
  label: string;
  idea: string;
  now?: boolean;
}
interface Props {
  stages: Stage[];
}
const { stages } = Astro.props;
---

<ol class="prog">
  {stages.map((s) => (
    <li class={`prog-stage ${s.now ? 'is-now' : ''}`} aria-current={s.now ? 'step' : undefined}>
      <span class="prog-dot" aria-hidden="true"></span>
      <p class="prog-label">{s.label}{s.now && <span class="prog-now">This year</span>}</p>
      <p class="prog-idea">{s.idea}</p>
    </li>
  ))}
</ol>

<style>
  .prog {
    display: grid;
    gap: 0;
    position: relative;
  }
  .prog-stage {
    position: relative;
    padding: 0 0 1.25rem 1.75rem;
  }
  /* The connecting line runs through the dots. */
  .prog-stage::before {
    content: '';
    position: absolute;
    left: 0.4375rem;
    top: 0.5rem;
    bottom: -0.5rem;
    width: 2px;
    background: rgb(31 29 26 / 0.12);
  }
  .prog-stage:last-child::before { display: none; }
  .prog-dot {
    position: absolute;
    left: 0;
    top: 0.25rem;
    height: 1rem;
    width: 1rem;
    border-radius: 9999px;
    background: white;
    box-shadow: inset 0 0 0 2px rgb(31 29 26 / 0.2);
  }
  .prog-label { font-size: 0.875rem; font-weight: 700; color: rgb(63 59 53); }
  .prog-idea { margin-top: 0.25rem; font-size: 0.9375rem; line-height: 1.55; color: rgb(84 79 71); }
  .prog-now {
    margin-left: 0.5rem;
    border-radius: 9999px;
    padding: 0.125rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    vertical-align: 0.1em;
    background: rgb(var(--accent));
    color: white;
  }
  .is-now .prog-dot { background: rgb(var(--accent)); box-shadow: 0 0 0 4px rgb(var(--accent) / 0.18); }
  .is-now .prog-label { color: rgb(31 29 26); }
  .is-now .prog-idea { color: rgb(31 29 26); }

  @media (min-width: 900px) {
    .prog { grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 1.25rem; }
    .prog-stage { padding: 1.75rem 0 0; }
    .prog-stage::before { left: 0.5rem; right: -1.25rem; top: 0.4375rem; bottom: auto; width: auto; height: 2px; }
    .prog-dot { top: 0; }
  }
</style>
