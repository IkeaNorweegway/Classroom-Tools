---
// Parent overview for a course: what it covers in plain words, where it sits
// between earlier and later grades, general ways to help, and a link to each
// unit's parent guide.
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseHero from './CourseHero.astro';
import Progression from './Progression.astro';
import type { CourseKey } from '../data/courses';

interface Item { label: string; href?: string }
interface Props {
  course: CourseKey;
  title: string;
  /** Browser-tab title and meta description, when different from the hero. */
  pageTitle?: string;
  metaDescription?: string;
  eyebrow: string;
  numeral?: string;
  description: string;
  aboutHeading: string;
  about: string[];
  stages: { label: string; idea: string; now?: boolean }[];
  /** Units, grouped (Math 9 strands) or as a single unnamed group. */
  groups: { id?: string; label?: string; blurb?: string; items: Item[] }[];
  listHeading: string;
  listIntro: string;
  tips: [string, string][];
}
const p = Astro.props;
---

<BaseLayout course={p.course} audience="parent" title={p.pageTitle ?? p.title} description={p.metaDescription ?? p.description}>
  <CourseHero eyebrow={p.eyebrow} title={p.title} numeral={p.numeral} description={p.description} />

  <section class="mb-12 grid gap-6 lg:grid-cols-[1.2fr_1fr]">
    <div>
      <h2 class="mb-3 font-display text-[1.5rem] font-medium text-slate-900">{p.aboutHeading}</h2>
      <div class="grid max-w-[64ch] gap-3 text-[1.0625rem] leading-relaxed text-slate-700">
        {p.about.map((para) => <p>{para}</p>)}
      </div>
    </div>
    <div class="raised self-start rounded-2xl p-6">
      <h2 class="mb-2 text-[1.0625rem] font-bold text-slate-900">On each guide</h2>
      <ul class="grid gap-1.5 text-[0.9375rem] text-slate-700">
        <li>· The topic in plain words</li>
        <li>· What your child should already know</li>
        <li>· Where it leads in later grades</li>
        <li>· Worked examples with what to say</li>
        <li>· Short practice sheets with answers</li>
      </ul>
    </div>
  </section>

  <section class="mb-14" aria-labelledby="big-picture">
    <h2 id="big-picture" class="mb-1.5 font-display text-[1.5rem] font-medium text-slate-900">The big picture</h2>
    <p class="mb-6 text-slate-600">
      {p.stages.some((st) => st.now) ? 'How this year fits between the grades before and after.' : 'How each grade builds on the one before.'}
      Exact grade placements can shift a little from school to school.
    </p>
    <Progression stages={p.stages} />
  </section>

  <section class="mb-14" aria-labelledby="topics">
    <h2 id="topics" class="mb-1.5 font-display text-[1.5rem] font-medium text-slate-900">{p.listHeading}</h2>
    <p class="mb-6 text-slate-600">{p.listIntro}</p>
    <div class="grid gap-8">
      {p.groups.map((g) => (
        <div id={g.id} class="scroll-mt-28">
          {g.label && <h3 class="text-[1.0625rem] font-bold text-slate-900">{g.label}</h3>}
          {g.blurb && <p class="mb-3 max-w-[64ch] text-[0.9375rem] text-slate-600">{g.blurb}</p>}
          <ul class="grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((t) => (
              <li>
                {t.href ? (
                  <a href={t.href} class="lift flex h-full items-center justify-between gap-3 rounded-2xl px-5 py-4">
                    <span class="font-bold text-slate-900">{t.label}</span>
                    <span class="arrow text-accent" aria-hidden="true">→</span>
                  </a>
                ) : (
                  <span class="flex h-full items-center justify-between gap-3 rounded-2xl px-5 py-4 shadow-[inset_0_0_0_1px_rgb(31_29_26/0.08)]">
                    <span class="font-semibold text-slate-500">{t.label}</span>
                    <span class="text-xs text-slate-400">Coming soon</span>
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section aria-labelledby="help">
    <h2 id="help" class="mb-4 font-display text-[1.5rem] font-medium text-slate-900">Helping, whatever the {p.course === 'steam' ? 'project' : 'topic'}</h2>
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {p.tips.map(([title, text]) => (
        <li class="rounded-2xl bg-white/70 p-5 shadow-[inset_0_0_0_1px_rgb(31_29_26/0.07)]">
          <p class="mb-1 font-bold text-slate-900">{title}</p>
          <p class="text-[0.9375rem] leading-relaxed text-slate-600">{text}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
