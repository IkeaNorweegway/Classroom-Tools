---
import '../styles/global.css';
import { courses, courseByKey, type CourseKey } from '../data/courses';

interface Props {
  course?: CourseKey;
  teacherMode?: boolean;
}
const { course, teacherMode = false } = Astro.props;

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const active = courseByKey(course);

// Teacher link: from a student page go to the course's teacher index; from a
// teacher page go back to the course. Hidden where there is no teacher index.
const teacherHref = active?.teacherPath
  ? `${base}${teacherMode ? active.path : active.teacherPath}`
  : null;

const dark = teacherMode;
const tabIdle = dark
  ? 'text-slate-300 hover:text-white hover:bg-white/10'
  : 'text-slate-600 hover:text-slate-900 hover:bg-slate-900/[0.04]';
---

<header
  class={`site-nav sticky top-0 z-40 border-b ${dark ? 'bg-slate-900 border-white/10' : 'bg-paper/95 border-slate-900/[0.07]'}`}
  data-course={course}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6">

    <div class="vt-nav-top flex h-16 items-center gap-6">
      <a
        href={base}
        class={`group flex items-center gap-2.5 shrink-0 font-display text-[1.15rem] font-semibold tracking-tight ${dark ? 'text-white' : 'text-slate-900'}`}
      >
        <span class="block h-2.5 w-2.5 rounded-full bg-accent transition-transform duration-300 ease-out group-hover:scale-125" aria-hidden="true"></span>
        Mr. Bremness
      </a>

      <nav aria-label="Courses" class="hidden lg:block flex-1">
        <ul class="flex items-center gap-0.5">
          {courses.map((c) => {
            const isActive = c.key === course;
            return (
              <li>
                <a
                  href={`${base}${c.path}`}
                  data-course={c.key}
                  aria-current={isActive ? 'true' : undefined}
                  class={`relative block rounded-full px-3.5 py-1.5 text-[0.8125rem] font-semibold transition-colors duration-200
                    ${isActive ? (dark ? 'text-white' : 'text-accent-ink') : tabIdle}`}
                >
                  {isActive && (
                    <span
                      class={`absolute inset-0 rounded-full ${dark ? 'bg-accent/40' : 'bg-accent-soft vt-nav-pill'}`}
                      aria-hidden="true"
                    ></span>
                  )}
                  <span class="relative">{c.tab}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <div class="ml-auto flex items-center">
        {teacherHref && (
          <a
            href={teacherHref}
            class={`rounded-full px-3.5 py-1.5 text-[0.8125rem] font-semibold border transition-colors duration-200
              ${dark
                ? 'border-teacher-400/60 text-teacher-400 hover:bg-teacher-400 hover:text-slate-900'
                : 'border-slate-900/15 text-slate-600 hover:border-slate-900/30 hover:text-slate-900'}`}
          >
            {teacherMode ? '← Student view' : 'Teacher'}
          </a>
        )}
      </div>
    </div>

    <!-- Course tabs on small screens: one scrollable row -->
    <nav aria-label="Courses" class="lg:hidden -mx-4 px-4 sm:-mx-6 sm:px-6 pb-2 overflow-x-auto [scrollbar-width:none]">
      <ul class="flex items-center gap-1 w-max">
        {courses.map((c) => {
          const isActive = c.key === course;
          return (
            <li>
              <a
                href={`${base}${c.path}`}
                data-course={c.key}
                aria-current={isActive ? 'true' : undefined}
                class={`relative block whitespace-nowrap rounded-full px-3 py-1.5 text-[0.8125rem] font-semibold transition-colors duration-200
                  ${isActive ? (dark ? 'text-white' : 'text-accent-ink') : tabIdle}`}
              >
                {isActive && (
                  <span
                    class={`absolute inset-0 rounded-full ${dark ? 'bg-accent/40' : 'bg-accent-soft vt-nav-pill'}`}
                    aria-hidden="true"
                  ></span>
                )}
                <span class="relative">{c.tab}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    {active && (
      <nav
        aria-label={`${active.grade} ${active.name}`}
        class="-mx-4 px-4 sm:-mx-6 sm:px-6 overflow-x-auto [scrollbar-width:none]"
      >
        <ul class="flex items-center gap-1 w-max">
          {active.subnav.map((item) => {
            const isActive = item.match(currentPath);
            return (
              <li>
                <a
                  href={`${base}${item.path}`}
                  aria-current={isActive ? 'page' : undefined}
                  class={`relative block whitespace-nowrap px-2.5 pt-1.5 pb-3 text-sm transition-colors duration-200
                    ${isActive
                      ? (dark ? 'text-white font-semibold' : 'text-slate-900 font-semibold')
                      : (dark ? 'text-slate-400 hover:text-white' : 'text-slate-500 hover:text-slate-900')}`}
                >
                  {item.label}
                  {isActive && (
                    <span class="vt-subnav-bar absolute inset-x-2.5 bottom-0 h-[3px] rounded-t-full bg-accent" aria-hidden="true"></span>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    )}
  </div>
</header>

<style>
  /* The pill is a soft tint; multiply keeps tab text readable through it
     while it slides between tabs during a page transition. */
  :global(::view-transition-group(nav-pill)) { mix-blend-mode: multiply; }
</style>
