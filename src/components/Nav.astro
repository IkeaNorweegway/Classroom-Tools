---
interface Props {
  course?: 'science' | 'math9' | 'science7' | 'social9';
  teacherMode?: boolean;
}
const { course, teacherMode = false } = Astro.props;

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const scienceUnits = [
  { slug: 'matter',           label: 'Matter' },
  { slug: 'forces',           label: 'Forces' },
  { slug: 'living-systems',   label: 'Living Systems' },
  { slug: 'climate',          label: 'Climate' },
  { slug: 'energy-resources', label: 'Energy Resources' },
  { slug: 'space',            label: 'Space' },
];

const math9Strands = [
  { slug: 'number',                 label: 'Number' },
  { slug: 'algebra',                label: 'Algebra' },
  { slug: 'measurement-geometry',   label: 'M&G' },
  { slug: 'statistics-probability', label: 'Stats & Prob' },
  { slug: 'practice',               label: 'Practice', href: `${base}math9/practice` },
  { slug: 'pat-prep',               label: 'PAT Prep', href: `${base}math9/pat-prep` },
  { slug: 'potd',                    label: 'POTD', href: `${base}math9/potd` },
];

const science7Units = [
  { slug: 'interactions-ecosystems', label: 'Ecosystems' },
  { slug: 'plants-food-fibre',       label: 'Plants' },
  { slug: 'heat-temperature',        label: 'Heat' },
  { slug: 'structures-forces',       label: 'Structures' },
  { slug: 'planet-earth',            label: 'Planet Earth' },
  { slug: 'practice',                label: 'Practice', href: `${base}science7/practice` },
];

const social9Units = [
  { slug: 'urbanization-industry',            label: 'Urbanization' },
  { slug: 'independence-democratic-rights',   label: 'Independence' },
  { slug: 'canada-in-wwii',                   label: 'WWII' },
  { slug: 'postwar-canada',                   label: 'Post-War' },
  { slug: 'modern-economy',                   label: 'Economy' },
  { slug: 'system-of-government',             label: 'Government' },
  { slug: 'evolving-citizenship',             label: 'Citizenship' },
];

const navBg   = teacherMode ? 'bg-slate-900 border-slate-700' : 'bg-white border-slate-200';
const textBase = teacherMode ? 'text-slate-300' : 'text-slate-600';
const hoverBase = teacherMode ? 'hover:bg-slate-700 hover:text-white' : 'hover:bg-slate-100 hover:text-slate-900';
---

<nav class={`border-b ${navBg} sticky top-0 z-50`}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6">

    <!-- ── Top bar ── -->
    <div class="flex items-center justify-between h-14">

      <!-- Site name → home -->
      <a
        href={base}
        class={`font-bold text-base tracking-tight ${teacherMode ? 'text-white' : 'text-slate-800'} hover:opacity-80 transition-opacity`}
      >
        Mr. Bremness
      </a>

      <!-- Course tabs (desktop) -->
      <div class="hidden sm:flex items-center gap-1">
        <a
          href={`${base}materials`}
          class={`text-xs px-3 py-1.5 rounded-md font-medium transition-colors
            ${course === 'science'
              ? (teacherMode ? 'bg-teacher-600 text-white' : 'bg-science-600 text-white')
              : `${textBase} ${hoverBase}`
            }`}
        >
          Gr. 6 Science
        </a>
        <a
          href={`${base}math9`}
          class={`text-xs px-3 py-1.5 rounded-md font-medium transition-colors
            ${course === 'math9'
              ? 'bg-math9-600 text-white'
              : `${textBase} ${hoverBase}`
            }`}
        >
          Math 9
        </a>
        <a
          href={`${base}science7`}
          class={`text-xs px-3 py-1.5 rounded-md font-medium transition-colors
            ${course === 'science7'
              ? 'text-white'
              : `${textBase} ${hoverBase}`
            }`}
          style={course === 'science7' ? 'background-color: #059669;' : ''}
        >
          Gr. 7 Science
        </a>
        <a
          href={`${base}social9`}
          class={`text-xs px-3 py-1.5 rounded-md font-medium transition-colors
            ${course === 'social9'
              ? 'text-white'
              : `${textBase} ${hoverBase}`
            }`}
          style={course === 'social9' ? 'background-color: #b91c1c;' : ''}
        >
          Social 9
        </a>
      </div>

      <!-- Right: Teacher toggle -->
      <a
        href={teacherMode
          ? (course === 'math9' ? `${base}math9` : course === 'science7' ? `${base}science7` : course === 'social9' ? `${base}social9` : `${base}materials`)
          : (course === 'math9' ? `${base}math9/teacher` : course === 'science7' ? `${base}science7/teacher` : course === 'social9' ? `${base}social9/teacher` : `${base}teacher`)}
        class={`text-xs px-3 py-1.5 rounded-md font-medium border transition-colors
          ${teacherMode
            ? 'border-teacher-500 text-teacher-400 hover:bg-teacher-700 hover:text-white'
            : 'border-slate-300 text-slate-500 hover:bg-slate-100 hover:text-slate-800'
          }`}
      >
        {teacherMode ? '← Student view' : 'Teacher'}
      </a>
    </div>

    <!-- ── Course subnav ── -->
    {course === 'science' && (
      <div class="flex gap-1 pb-2 overflow-x-auto">
        {scienceUnits.map(u => (
          <a
            href={`${base}units/${u.slug}`}
            class={`text-xs px-2.5 py-1 rounded-md font-medium whitespace-nowrap transition-colors
              ${currentPath.includes(u.slug)
                ? (teacherMode ? 'bg-teacher-600 text-white' : 'bg-science-600 text-white')
                : (teacherMode ? 'text-slate-400 hover:bg-slate-700 hover:text-white' : 'text-slate-600 hover:bg-slate-100')
              }`}
          >
            {u.label}
          </a>
        ))}
        <a
          href={`${base}materials`}
          class={`text-xs px-2.5 py-1 rounded-md font-medium whitespace-nowrap transition-colors
            ${currentPath.includes('/materials') && !currentPath.includes('/materials/fr') && !currentPath.includes('/units/')
              ? (teacherMode ? 'bg-teacher-600 text-white' : 'bg-science-600 text-white')
              : (teacherMode ? 'text-slate-400 hover:bg-slate-700 hover:text-white' : 'text-slate-600 hover:bg-slate-100')
            }`}
        >
          All Materials
        </a>
        <a
          href={`${base}materials/fr`}
          class={`text-xs px-2.5 py-1 rounded-md font-medium whitespace-nowrap transition-colors
            ${currentPath.includes('/materials/fr')
              ? 'bg-blue-600 text-white'
              : (teacherMode ? 'text-slate-400 hover:bg-slate-700 hover:text-white' : 'text-blue-600 hover:bg-blue-50')
            }`}
        >
          Français
        </a>
      </div>
    )}

    {course === 'math9' && (
      <div class="flex gap-1 pb-2 overflow-x-auto">
        {math9Strands.map(s => (
          <a
            href={s.href || `${base}math9/materials/${s.slug}`}
            class={`text-xs px-2.5 py-1 rounded-md font-medium whitespace-nowrap transition-colors
              ${currentPath.includes(s.slug)
                ? 'bg-math9-600 text-white'
                : 'text-slate-600 hover:bg-slate-100'
              }`}
          >
            {s.label}
          </a>
        ))}
        <a
          href={`${base}math9/materials`}
          class={`text-xs px-2.5 py-1 rounded-md font-medium whitespace-nowrap transition-colors
            ${currentPath.endsWith('/math9/materials') || currentPath.endsWith('/math9/materials/')
              ? 'bg-math9-600 text-white'
              : 'text-slate-600 hover:bg-slate-100'
            }`}
        >
          All Materials
        </a>
      </div>
    )}

    {course === 'science7' && (
      <div class="flex gap-1 pb-2 overflow-x-auto">
        {science7Units.map(u => (
          <a
            href={u.href || `${base}science7/materials/${u.slug}`}
            class={`text-xs px-2.5 py-1 rounded-md font-medium whitespace-nowrap transition-colors
              ${currentPath.includes(u.slug)
                ? 'text-white'
                : 'text-slate-600 hover:bg-slate-100'
              }`}
            style={currentPath.includes(u.slug) ? 'background-color: #059669;' : ''}
          >
            {u.label}
          </a>
        ))}
        <a
          href={`${base}science7`}
          class={`text-xs px-2.5 py-1 rounded-md font-medium whitespace-nowrap transition-colors
            ${currentPath.endsWith('/science7') || currentPath.endsWith('/science7/')
              ? 'text-white'
              : 'text-slate-600 hover:bg-slate-100'
            }`}
          style={currentPath.endsWith('/science7') || currentPath.endsWith('/science7/') ? 'background-color: #059669;' : ''}
        >
          All Units
        </a>
      </div>
    )}

    {course === 'social9' && (
      <div class="flex gap-1 pb-2 overflow-x-auto">
        {social9Units.map(u => (
          <a
            href={`${base}social9/materials/${u.slug}`}
            class={`text-xs px-2.5 py-1 rounded-md font-medium whitespace-nowrap transition-colors
              ${currentPath.includes(u.slug)
                ? 'text-white'
                : 'text-slate-600 hover:bg-slate-100'
              }`}
            style={currentPath.includes(u.slug) ? 'background-color: #b91c1c;' : ''}
          >
            {u.label}
          </a>
        ))}
        <a
          href={`${base}social9`}
          class={`text-xs px-2.5 py-1 rounded-md font-medium whitespace-nowrap transition-colors
            ${currentPath.endsWith('/social9') || currentPath.endsWith('/social9/')
              ? 'text-white'
              : 'text-slate-600 hover:bg-slate-100'
            }`}
          style={currentPath.endsWith('/social9') || currentPath.endsWith('/social9/') ? 'background-color: #b91c1c;' : ''}
        >
          All Units
        </a>
      </div>
    )}

  </div>
</nav>
