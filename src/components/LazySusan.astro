---
// Decorative turntable for the home page hero. One icon per course stands on
// a tilted platter that turns a sixth of a revolution, pauses with the next
// course at the front, then turns again. Pure CSS transforms; the motion is
// composited, pauses on hover and when scrolled out of view, and is static
// under prefers-reduced-motion.
import { courses } from '../data/courses';

// Stroke icons drawn on a 24px grid, 1.75 stroke, matching the lock icon.
const icons: Record<string, string> = {
  science:  '<path d="M9.5 3.5h5M10.5 3.5v5.5l-5 8.6a1.8 1.8 0 0 0 1.6 2.9h9.8a1.8 1.8 0 0 0 1.6-2.9l-5-8.6V3.5"/><path d="M7.6 14.5h8.8"/>',
  math9:    '<path d="M7 4.5v5M4.5 7h5M14.5 7h5M5.2 15.2l3.6 3.6M8.8 15.2l-3.6 3.6M14.5 15.5h5M14.5 18.5h5"/>',
  science7: '<path d="M5 19.5C5 11 10 5 19.5 4.5 19.5 14 14 19 5 19.5Z"/><path d="M5 19.5l8-8"/>',
  social9:  '<path d="M3.5 9.5 12 4l8.5 5.5"/><path d="M5.5 10v7.5M10 10v7.5M14 10v7.5M18.5 10v7.5M3.5 20h17"/>',
  social8:  '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c3.2 3 3.2 14 0 17M12 3.5c-3.2 3-3.2 14 0 17"/>',
  steam:    '<rect x="5" y="8.5" width="14" height="11" rx="3"/><path d="M12 8.5V5.5"/><circle cx="12" cy="4.5" r="1"/><path d="M9.5 13.2h.01M14.5 13.2h.01M9.5 16.5h5"/>',
};
---

<div class="susan-wrap" aria-hidden="true">
  <div class="susan" data-susan>
    <div class="susan-shadow"></div>
    <div class="susan-platter">
      <div class="susan-edge"></div>
      <div class="susan-disc"></div>
      <div class="susan-ring">
        <div class="susan-groove"></div>
        {Array.from({ length: 24 }, (_, i) => (
          <span class="susan-tick" style={`--a: ${i * 15}deg`}></span>
        ))}
        {courses.map((c, i) => (
          <div class="susan-slot" style={`--a: ${180 + i * 60}deg`}>
            <div class="susan-upright">
              <div class="susan-counter">
                <div class="susan-face" data-course={c.key} style={`--i: ${i}`}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={icons[c.key]} />
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="susan-hub"></div>
    </div>
  </div>

  <p class="susan-caption">
    <span class="susan-caption-static">Six courses, one place</span>
    {courses.map((c, i) => (
      <span class="susan-caption-item" data-course={c.key} style={`--i: ${i}`}>
        <span class="susan-caption-dot"></span>{c.grade} {c.name}
      </span>
    ))}
  </p>
</div>

<style>
  .susan-wrap {
    --s: 0.74;
    --tilt: 64deg;
    --cycle: 18s;
    --step: 3s;
    position: relative;
    width: 100%;
    height: calc(400px * var(--s));
  }
  @media (min-width: 640px) { .susan-wrap { --s: 0.86; } }
  @media (min-width: 1024px) { .susan-wrap { --s: 1; } }

  .susan {
    position: absolute;
    left: 50%;
    top: 0;
    width: 440px;
    height: 360px;
    margin-left: -220px;
    perspective: 1100px;
    perspective-origin: 50% 20%;
    transform: scale(var(--s));
    transform-origin: 50% 0;
  }

  .susan-shadow {
    position: absolute;
    left: 50%;
    top: 262px;
    width: 400px;
    height: 90px;
    margin-left: -200px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(var(--ink) / 0.16), rgb(var(--ink) / 0.06) 60%, transparent);
  }

  .susan-platter {
    position: absolute;
    left: 50%;
    top: 40px;
    width: 360px;
    height: 360px;
    margin-left: -180px;
    transform-style: preserve-3d;
    transform: rotateX(var(--tilt));
  }

  .susan-disc,
  .susan-edge {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }
  .susan-disc {
    background:
      radial-gradient(circle at 50% 50%, rgb(var(--surface)) 0 22%, transparent 22.5%),
      radial-gradient(circle at 40% 30%, #fffdf8, #efebe2 70%);
    box-shadow: inset 0 0 0 1px rgb(var(--ink) / 0.08);
  }
  .susan-edge {
    transform: translateZ(-14px);
    background: #d9d4c8;
    box-shadow: inset 0 0 0 1px rgb(var(--ink) / 0.1);
  }
  .susan-hub {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 46px;
    height: 46px;
    margin: -23px 0 0 -23px;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #fffdf8, #e4dfd4);
    box-shadow: inset 0 0 0 1px rgb(var(--ink) / 0.1);
    transform: translateZ(1px);
  }

  .susan-ring,
  .susan-groove {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    transform-style: preserve-3d;
  }
  .susan-ring { animation: susan-turn var(--cycle) infinite; }
  .susan-groove {
    inset: 24px;
    border: 1px dashed rgb(var(--ink) / 0.14);
  }
  .susan-tick {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4px;
    height: 4px;
    margin: -2px 0 0 -2px;
    border-radius: 50%;
    background: rgb(var(--ink) / 0.16);
    transform: rotate(var(--a)) translateY(-168px);
  }

  .susan-slot,
  .susan-upright,
  .susan-counter {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
  }
  .susan-slot { transform: rotateZ(var(--a)) translateY(-128px); }
  .susan-upright { left: 0; top: 0; transform: rotateZ(calc(var(--a) * -1)); }
  .susan-counter { left: 0; top: 0; animation: susan-counter var(--cycle) infinite; }

  /* Stands on the platter: hinge at its bottom edge, tilted back upright. */
  .susan-face {
    position: absolute;
    left: -34px;
    top: -68px;
    width: 68px;
    height: 68px;
    display: grid;
    place-items: center;
    border-radius: 20px;
    background: rgb(var(--surface));
    color: rgb(var(--accent));
    box-shadow:
      inset 0 0 0 1px rgb(var(--ink) / 0.08),
      0 10px 18px -10px rgb(var(--accent) / 0.45);
    transform-origin: 50% 100%;
    transform: rotateX(calc(var(--tilt) * -1));
  }
  .susan-face svg {
    width: 32px;
    height: 32px;
    animation: susan-spot var(--cycle) infinite;
    animation-delay: calc(var(--i) * var(--step) - var(--cycle));
  }
  .susan-face::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: rgb(var(--accent-soft));
    box-shadow: inset 0 0 0 1.5px rgb(var(--accent) / 0.45);
    opacity: 0;
    animation: susan-glow var(--cycle) infinite;
    animation-delay: calc(var(--i) * var(--step) - var(--cycle));
  }
  .susan-face svg { position: relative; }

  .susan-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1.5rem;
    text-align: center;
    font-size: 0.9375rem;
    font-weight: 600;
    color: rgb(var(--ink) / 0.75);
  }
  .susan-caption-static { display: none; }
  .susan-caption-item {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    opacity: 0;
    animation: susan-caption var(--cycle) infinite;
    animation-delay: calc(var(--i) * var(--step) - var(--cycle));
  }
  .susan-caption-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: rgb(var(--accent));
  }

  .susan-wrap:hover *,
  .susan-wrap.is-paused * { animation-play-state: paused !important; }

  /* Six steps per cycle: hold 70% of each step, then turn with a soft settle. */
  @keyframes susan-turn {
    0%, 11.667%      { transform: rotateZ(0deg);    animation-timing-function: cubic-bezier(0.6, 0, 0.25, 1.08); }
    16.667%, 28.333% { transform: rotateZ(-60deg);  animation-timing-function: cubic-bezier(0.6, 0, 0.25, 1.08); }
    33.333%, 45%     { transform: rotateZ(-120deg); animation-timing-function: cubic-bezier(0.6, 0, 0.25, 1.08); }
    50%, 61.667%     { transform: rotateZ(-180deg); animation-timing-function: cubic-bezier(0.6, 0, 0.25, 1.08); }
    66.667%, 78.333% { transform: rotateZ(-240deg); animation-timing-function: cubic-bezier(0.6, 0, 0.25, 1.08); }
    83.333%, 95%     { transform: rotateZ(-300deg); animation-timing-function: cubic-bezier(0.6, 0, 0.25, 1.08); }
    100%             { transform: rotateZ(-360deg); }
  }
  /* Exactly mirrors susan-turn so every icon keeps facing the viewer. */
  @keyframes susan-counter {
    0%, 11.667%      { transform: rotateZ(0deg);   animation-timing-function: cubic-bezier(0.6, 0, 0.25, 1.08); }
    16.667%, 28.333% { transform: rotateZ(60deg);  animation-timing-function: cubic-bezier(0.6, 0, 0.25, 1.08); }
    33.333%, 45%     { transform: rotateZ(120deg); animation-timing-function: cubic-bezier(0.6, 0, 0.25, 1.08); }
    50%, 61.667%     { transform: rotateZ(180deg); animation-timing-function: cubic-bezier(0.6, 0, 0.25, 1.08); }
    66.667%, 78.333% { transform: rotateZ(240deg); animation-timing-function: cubic-bezier(0.6, 0, 0.25, 1.08); }
    83.333%, 95%     { transform: rotateZ(300deg); animation-timing-function: cubic-bezier(0.6, 0, 0.25, 1.08); }
    100%             { transform: rotateZ(360deg); }
  }
  /* The front icon's window is the first hold of its own (offset) cycle. */
  @keyframes susan-spot {
    0%, 11.667% { transform: scale(1.12); }
    15%, 96%    { transform: scale(1); }
    100%        { transform: scale(1.12); }
  }
  @keyframes susan-glow {
    0%, 11.667% { opacity: 1; }
    15%, 96%    { opacity: 0; }
    100%        { opacity: 1; }
  }
  @keyframes susan-caption {
    0%, 11.667% { opacity: 1; transform: translateY(0); }
    14.5%       { opacity: 0; transform: translateY(-6px); }
    96.5%       { opacity: 0; transform: translateY(6px); }
    100%        { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .susan-wrap * { animation: none !important; }
    .susan-caption-item { display: none; }
    .susan-caption-static { display: inline; }
  }
</style>

<script>
  // Stop the turntable when it is off screen so it costs nothing while
  // students read the course list.
  const wrap = document.querySelector<HTMLElement>('[data-susan]')?.parentElement;
  if (wrap && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      wrap.classList.toggle('is-paused', !entry.isIntersecting);
    }).observe(wrap);
  }
</script>
