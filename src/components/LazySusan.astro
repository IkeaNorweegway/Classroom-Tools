---
// The home page course menu: one icon per course standing on a tilted
// turntable, plus a panel describing the course at the front.
//
// - It turns one step every few seconds; hovering, focusing, or scrolling it
//   off screen pauses it. Reduced motion: it never turns on its own.
// - Hover or focus an icon to preview that course; click it to open it.
// - The arrows and dots bring a course to the front.
//
// Rotation is a CSS transition on `transform` (composited). The script only
// sets the target angle, so the motion never waits on the main thread.
//
// Renders two grid items (stage and panel) so the page can place them;
// the parent grid needs `stage` and `panel` areas.
import { courses, audiencePath } from '../data/courses';

const base = import.meta.env.BASE_URL;

// Stroke icons on a 24px grid, 1.75 stroke.
const icons: Record<string, string> = {
  science:  '<path d="M9.5 3.5h5M10.5 3.5v5.5l-5 8.6a1.8 1.8 0 0 0 1.6 2.9h9.8a1.8 1.8 0 0 0 1.6-2.9l-5-8.6V3.5"/><path d="M7.6 14.5h8.8"/>',
  math9:    '<path d="M7 4.5v5M4.5 7h5M14.5 7h5M5.2 15.2l3.6 3.6M8.8 15.2l-3.6 3.6M14.5 15.5h5M14.5 18.5h5"/>',
  science7: '<path d="M5 19.5C5 11 10 5 19.5 4.5 19.5 14 14 19 5 19.5Z"/><path d="M5 19.5l8-8"/>',
  social9:  '<path d="M3.5 9.5 12 4l8.5 5.5"/><path d="M5.5 10v7.5M10 10v7.5M14 10v7.5M18.5 10v7.5M3.5 20h17"/>',
  social8:  '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c3.2 3 3.2 14 0 17M12 3.5c-3.2 3-3.2 14 0 17"/>',
  steam:    '<rect x="5" y="8.5" width="14" height="11" rx="3"/><path d="M12 8.5V5.5"/><circle cx="12" cy="4.5" r="1"/><path d="M9.5 13.2h.01M14.5 13.2h.01M9.5 16.5h5"/>',
};
---

<div class="contents" data-susan-root>
  <nav class="susan-wrap [grid-area:stage]" aria-label="Courses">
    <div class="susan" data-susan-stage>
      <div class="susan-shadow" aria-hidden="true"></div>
      <div class="susan-platter">
        <div class="susan-edge" aria-hidden="true"></div>
        <div class="susan-disc" aria-hidden="true"></div>
        <div class="susan-ring" data-susan-ring>
          <div class="susan-groove" aria-hidden="true"></div>
          {Array.from({ length: 24 }, (_, i) => (
            <span class="susan-tick" style={`--a: ${i * 15}deg`} aria-hidden="true"></span>
          ))}
          {courses.map((c, i) => (
            <div class={`susan-slot ${i === 0 ? 'is-front' : ''}`} style={`--a: ${180 + i * 60}deg`} data-slot={i}>
              <div class="susan-upright">
                <div class="susan-counter" data-susan-counter>
                  <span class="susan-contact" aria-hidden="true"></span>
                  <a
                    href={`${base}${c.path}`}
                    data-href-student={`${base}${c.path}`}
                    data-href-parent={audiencePath(c, 'parent') && `${base}${audiencePath(c, 'parent')}`}
                    data-href-teacher={audiencePath(c, 'teacher') && `${base}${audiencePath(c, 'teacher')}`}
                    class="susan-face"
                    data-course={c.key}
                    data-index={i}
                    aria-label={`${c.grade} ${c.name}`}
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[c.key]} />
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="susan-hub" aria-hidden="true"></div>
      </div>
    </div>
    <p class="susan-hint">Tap a course to open it</p>
  </nav>

  <div class="susan-panel raised [grid-area:panel]" data-susan-panel>
    <div class="mb-5 flex items-center justify-between gap-4">
      <p class="text-sm font-semibold text-slate-500">Choose a course</p>
      <div class="flex items-center gap-2">
        <button type="button" class="susan-step btn-3d" data-step="-1" aria-label="Previous course">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" /></svg>
        </button>
        <button type="button" class="susan-step btn-3d" data-step="1" aria-label="Next course">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg>
        </button>
      </div>
    </div>

    <div class="susan-panes">
      {courses.map((c, i) => (
        <div
          class={`susan-pane ${i === 0 ? 'is-active' : ''}`}
          data-course={c.key}
          data-pane={i}
          aria-hidden={i === 0 ? undefined : 'true'}
          inert={i === 0 ? undefined : true}
        >
          <div class="flex items-end gap-4">
            <span
              class="pane-num numeral-3d font-display text-[4.5rem] leading-[0.82] font-medium tracking-tight text-accent tabular"
              style={`--vtn: course-num-${c.key}`}
              aria-hidden="true"
            >{c.numeral}</span>
            <div class="pane-title min-w-0 pb-1">
              <p class="text-sm font-semibold text-accent-ink">{c.grade}</p>
              <p class="font-display text-[2rem] leading-tight font-medium tracking-[-0.01em] text-slate-900">{c.name}</p>
            </div>
          </div>
          <p class="pane-copy mt-4 text-[0.9875rem] leading-relaxed text-slate-600">{c.blurb}</p>
          <p class="pane-copy mt-3 flex flex-wrap gap-x-3 gap-y-1 text-[0.8125rem] font-semibold text-slate-500 tabular">
            {c.facts.map((f, j) => (
              <>
                {j > 0 && <span class="text-slate-300" aria-hidden="true">·</span>}
                <span>{f}</span>
              </>
            ))}
          </p>
          <a
            href={`${base}${c.path}`}
            data-href-student={`${base}${c.path}`}
            data-href-parent={audiencePath(c, 'parent') && `${base}${audiencePath(c, 'parent')}`}
            data-href-teacher={audiencePath(c, 'teacher') && `${base}${audiencePath(c, 'teacher')}`}
            class="susan-open pane-copy"
          >
            Open {c.grade} {c.name} <span class="susan-open-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      ))}
    </div>

    <div class="mt-6 flex items-center gap-2.5" role="group" aria-label="Courses">
      {courses.map((c, i) => (
        <button
          type="button"
          class="susan-dot"
          data-course={c.key}
          data-dot={i}
          aria-label={`Show ${c.grade} ${c.name}`}
          aria-current={i === 0 ? 'true' : undefined}
        ></button>
      ))}
    </div>
  </div>
</div>

<style>
  .susan-wrap {
    --s: 0.74;
    --tilt: 64deg;
    --turn: 1050ms;
    position: relative;
    display: block;
    width: 100%;
    height: calc(380px * var(--s) + 2rem);
  }
  @media (min-width: 640px) { .susan-wrap { --s: 0.9; } }
  @media (min-width: 1024px) { .susan-wrap { --s: 1.08; } }

  .susan {
    position: absolute;
    left: 50%;
    top: 0;
    width: 440px;
    height: 380px;
    margin-left: -220px;
    perspective: 1100px;
    perspective-origin: 50% 15%;
    transform: scale(var(--s));
    transform-origin: 50% 0;
  }

  .susan-shadow {
    position: absolute;
    left: 50%;
    top: 270px;
    width: 420px;
    height: 100px;
    margin-left: -210px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(var(--ink) / 0.22), rgb(var(--ink) / 0.08) 60%, transparent);
  }

  .susan-platter {
    position: absolute;
    left: 50%;
    top: 46px;
    width: 360px;
    height: 360px;
    margin-left: -180px;
    transform-style: preserve-3d;
    transform: rotateX(var(--tilt));
  }

  .susan-disc,
  .susan-edge {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }
  .susan-disc {
    background:
      radial-gradient(circle at 50% 50%, rgb(var(--surface)) 0 22%, transparent 22.5%),
      radial-gradient(circle at 35% 25%, #fffefa, #ece7dc 72%);
    box-shadow: inset 0 0 0 1px rgb(var(--ink) / 0.08), inset 0 -10px 24px rgb(var(--ink) / 0.06);
  }
  .susan-edge {
    transform: translateZ(-18px);
    background: linear-gradient(90deg, #cfc9bc, #e2ddd2 45%, #cbc5b7);
    box-shadow: inset 0 0 0 1px rgb(var(--ink) / 0.12), 0 0 0 1px rgb(var(--ink) / 0.05);
  }
  .susan-hub {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 50px;
    height: 50px;
    margin: -25px 0 0 -25px;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 32%, #fffefa, #ddd7ca);
    box-shadow: inset 0 0 0 1px rgb(var(--ink) / 0.1), 0 0 0 6px rgb(var(--ink) / 0.03);
    transform: translateZ(2px);
  }

  .susan-ring,
  .susan-groove {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    transform-style: preserve-3d;
  }
  .susan-ring { transition: transform var(--turn) cubic-bezier(0.6, 0, 0.25, 1.08); }
  .susan-groove {
    inset: 24px;
    border: 1px dashed rgb(var(--ink) / 0.14);
  }
  .susan-tick {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4px;
    height: 4px;
    margin: -2px 0 0 -2px;
    border-radius: 50%;
    background: rgb(var(--ink) / 0.18);
    transform: rotate(var(--a)) translateY(-168px);
  }

  .susan-slot,
  .susan-upright,
  .susan-counter {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
  }
  .susan-slot { transform: rotateZ(var(--a)) translateY(-128px); }
  .susan-upright { left: 0; top: 0; transform: rotateZ(calc(var(--a) * -1)); }
  .susan-counter { left: 0; top: 0; transition: transform var(--turn) cubic-bezier(0.6, 0, 0.25, 1.08); }

  /* Ground shadow under each icon, lying flat on the platter. */
  .susan-contact {
    position: absolute;
    left: -46px;
    top: -18px;
    width: 92px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(var(--ink) / 0.28), rgb(var(--ink) / 0.08) 60%, transparent);
    transform: translateZ(1px);
    transition: transform 420ms var(--ease-out), opacity 420ms var(--ease-out);
  }
  .susan-slot.is-hover .susan-contact { transform: translateZ(1px) scale(0.78); opacity: 0.55; }

  /* Stands on the platter: hinge at its bottom edge, tilted back upright. */
  .susan-face {
    --lift: 0px;
    position: absolute;
    left: -36px;
    top: -72px;
    width: 72px;
    height: 72px;
    display: grid;
    place-items: center;
    border-radius: 22px;
    background: linear-gradient(165deg, #ffffff, rgb(var(--surface)) 55%, rgb(var(--accent-soft)));
    color: rgb(var(--accent));
    box-shadow:
      inset 0 1px 0 white,
      inset 0 0 0 1px rgb(var(--ink) / 0.08),
      inset 0 -2px 0 rgb(var(--ink) / 0.05),
      0 14px 22px -12px rgb(var(--accent) / 0.55);
    transform-origin: 50% 100%;
    transform: rotateX(calc(var(--tilt) * -1)) translateY(var(--lift));
    transition: transform 380ms cubic-bezier(0.34, 1.4, 0.64, 1);
    cursor: pointer;
  }
  .susan-face::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(165deg, #ffffff, rgb(var(--accent-soft)) 70%);
    box-shadow:
      inset 0 0 0 1.5px rgb(var(--accent) / 0.5),
      0 18px 30px -12px rgb(var(--accent) / 0.65);
    opacity: 0;
    transition: opacity 420ms var(--ease-out);
  }
  .susan-face svg {
    position: relative;
    width: 34px;
    height: 34px;
    transition: transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .susan-slot.is-front .susan-face::before { opacity: 1; }
  .susan-slot.is-front .susan-face svg { transform: scale(1.12); }
  .susan-slot.is-hover .susan-face { --lift: -12px; }
  .susan-slot.is-hover .susan-face::before { opacity: 1; }
  .susan-face:active { --lift: -4px; transition-duration: 120ms; }

  .susan-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgb(var(--ink) / 0.5);
  }
  @media (hover: hover) { .susan-hint { visibility: hidden; } }

  /* ── Panel ─────────────────────────────────────────────────────────── */

  .susan-panel {
    position: relative;
    border-radius: 1.75rem;
    padding: 1.5rem;
  }
  @media (min-width: 640px) { .susan-panel { padding: 1.75rem 2rem; } }

  .susan-step {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    color: rgb(var(--ink) / 0.7);
  }
  .susan-step svg { width: 1rem; height: 1rem; }

  .susan-panes { display: grid; }
  .susan-pane {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 260ms var(--ease-out), visibility 0s linear 260ms;
  }
  .susan-pane.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 360ms var(--ease-out) 80ms, visibility 0s;
  }
  .susan-pane.is-active .pane-num { view-transition-name: var(--vtn); }

  /* Each part of the incoming pane settles in a beat after the last. */
  .pane-num, .pane-title, .pane-copy {
    transition: transform 520ms var(--ease-out);
  }
  .susan-pane:not(.is-active) .pane-num { transform: translateY(14px) rotate(-6deg); }
  .susan-pane:not(.is-active) .pane-title { transform: translateX(-10px); }
  .susan-pane:not(.is-active) .pane-copy { transform: translateY(8px); }
  .susan-pane.is-active .pane-title { transition-delay: 40ms; }
  .susan-pane.is-active .pane-copy { transition-delay: 90ms; }

  .susan-open {
    position: relative;
    isolation: isolate;
    margin-top: 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    padding: 0.75rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 700;
    color: white;
    background: linear-gradient(180deg, rgb(var(--accent) / 0.88), rgb(var(--accent)));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.3),
      inset 0 -2px 0 rgb(0 0 0 / 0.12),
      0 10px 20px -10px rgb(var(--accent) / 0.9);
  }
  .susan-open::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    box-shadow: 0 18px 30px -12px rgb(var(--accent) / 0.85);
    opacity: 0;
    transition: opacity 300ms var(--ease-out);
  }
  .susan-open-arrow { transition: transform 300ms var(--ease-out); }
  @media (hover: hover) {
    .susan-pane.is-active .susan-open:hover { transform: translateY(-2px); }
    .susan-open:hover::after { opacity: 1; }
    .susan-open:hover .susan-open-arrow { transform: translateX(4px); }
  }
  .susan-pane.is-active .susan-open:active { transform: translateY(0) scale(0.97); transition-duration: 90ms; }

  .susan-dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 999px;
    background: rgb(var(--accent) / 0.3);
    box-shadow: inset 0 1px 1px rgb(var(--ink) / 0.15);
    transition: transform 360ms cubic-bezier(0.34, 1.56, 0.64, 1), background-color 300ms var(--ease-out);
  }
  .susan-dot[aria-current='true'] {
    background: rgb(var(--accent));
    transform: scale(1.45);
    box-shadow: 0 3px 6px -2px rgb(var(--accent) / 0.8);
  }
  @media (hover: hover) { .susan-dot:hover { transform: scale(1.3); } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-susan-root]');
  const STEP_MS = 3400;
  const COUNT = 6;

  if (root) {
    const stage = root.querySelector<HTMLElement>('[data-susan-stage]')!;
    const wrap = stage.parentElement!;
    const panel = root.querySelector<HTMLElement>('[data-susan-panel]')!;
    const ring = root.querySelector<HTMLElement>('[data-susan-ring]')!;
    const counters = [...root.querySelectorAll<HTMLElement>('[data-susan-counter]')];
    const slots = [...root.querySelectorAll<HTMLElement>('[data-slot]')];
    const panes = [...root.querySelectorAll<HTMLElement>('[data-pane]')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');

    // k counts steps without wrapping, so the platter never spins backwards
    // through a full turn to get from the last course to the first.
    let k = 0;
    let hover: number | null = null;
    let pointerInside = false;
    let visible = true;
    let holdUntil = 0;

    const front = () => ((k % COUNT) + COUNT) % COUNT;

    const render = () => {
      ring.style.transform = `rotateZ(${-60 * k}deg)`;
      counters.forEach((c) => { c.style.transform = `rotateZ(${60 * k}deg)`; });
      const f = front();
      const shown = hover ?? f;
      slots.forEach((s, i) => {
        s.classList.toggle('is-front', i === f);
        s.classList.toggle('is-hover', i === hover);
      });
      panes.forEach((p, i) => {
        const on = i === shown;
        p.classList.toggle('is-active', on);
        p.toggleAttribute('inert', !on);
        if (on) p.removeAttribute('aria-hidden'); else p.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((d, i) => {
        if (i === shown) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current');
      });
    };

    const bringToFront = (i: number) => {
      const d = ((i - front() + COUNT + 3) % COUNT) - 3; // shortest way round
      k += d;
      hover = null;
      holdUntil = Date.now() + 9000;
      render();
    };

    const paused = () =>
      reduce.matches || pointerInside || !visible || document.hidden ||
      root.contains(document.activeElement) || Date.now() < holdUntil;

    setInterval(() => {
      if (paused()) return;
      k += 1;
      render();
    }, STEP_MS);

    root.querySelectorAll<HTMLElement>('.susan-face').forEach((face) => {
      const i = Number(face.dataset.index);
      face.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse') return;
        hover = i;
        render();
      });
      face.addEventListener('pointerleave', () => {
        if (hover === i) { hover = null; render(); }
      });
      face.addEventListener('focus', () => { hover = i; render(); });
      face.addEventListener('blur', () => { if (hover === i) { hover = null; render(); } });
    });

    root.querySelectorAll<HTMLElement>('[data-step]').forEach((btn) => {
      btn.addEventListener('click', () => bringToFront(front() + Number(btn.dataset.step)));
    });
    dots.forEach((dot, i) => dot.addEventListener('click', () => bringToFront(i)));

    [wrap, panel].forEach((el) => {
      el.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') pointerInside = true; });
      el.addEventListener('pointerleave', () => { pointerInside = false; });
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; }).observe(wrap);
    }

    render();
  }
</script>
