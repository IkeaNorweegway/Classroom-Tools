---
// Prereq practice: pick a unit, answer one question per skill (up to five), get a
// hint and an explanation, and see which skills are mastered. Each unit card
// can also print a 10-question sheet with an answer key. Questions come from
// a bank in src/data/practice/; progress stays in this browser.
import type { PracticeUnit } from '../data/practice/types';

interface Props {
  /** Shown above the title and on the printed sheet, e.g. "Social Studies 8". */
  courseName: string;
  /** localStorage prefix, e.g. "soc8". */
  storageKey: string;
  units: PracticeUnit[];
}

const { courseName, storageKey, units } = Astro.props;
// Escape "<" so no question text can close the script tag.
const data = JSON.stringify({ courseName, storageKey, units }).replace(/</g, '\\u003c');
---

<div class="practice">
  <div class="practice-head mb-8">
    <p class="text-xs font-bold uppercase tracking-widest text-accent-ink mb-2">{courseName}</p>
    <h1 class="text-3xl font-bold text-slate-900 mb-2">Prereq practice</h1>
    <p class="text-slate-600">Pick the unit you're about to start. A few quick questions check what you need to know first. Every question explains its answer.</p>
  </div>

  <div id="pp-grid" class="grid sm:grid-cols-2 gap-3"></div>

  <div id="pp-problem" class="hidden max-w-xl mx-auto">
    <button id="pp-back" type="button" class="text-sm text-slate-500 hover:text-slate-800 mb-4 transition-colors">&larr; Back to units</button>
    <div class="flex items-center justify-between gap-3 mb-4">
      <h2 id="pp-title" class="text-lg font-bold text-slate-800"></h2>
      <span id="pp-progress" class="text-xs font-medium text-slate-500 whitespace-nowrap"></span>
    </div>
    <div class="bg-white rounded-xl border border-slate-200 p-6 mb-4">
      <p id="pp-skill" class="text-xs font-semibold uppercase tracking-wider text-accent-ink mb-2"></p>
      <p id="pp-question" class="text-base font-medium text-slate-800 mb-4 leading-relaxed whitespace-pre-line"></p>
      <button id="pp-hint-toggle" type="button" class="text-xs font-medium text-accent-ink hover:underline mb-3">Show hint</button>
      <div id="pp-hint" class="hidden text-sm text-slate-600 bg-slate-50 border border-slate-200 rounded-lg p-3 mb-4"></div>
      <div id="pp-choices" class="grid gap-2"></div>
      <form id="pp-typed" class="flex gap-2">
        <input id="pp-input" type="text" autocomplete="off" spellcheck="false" aria-label="Your answer"
          class="flex-1 min-w-0 border border-slate-300 rounded-lg px-4 py-2.5 text-base focus:outline-none focus:ring-2 focus:ring-accent/40 focus:border-accent" placeholder="Your answer…" />
        <button id="pp-check" type="submit" class="bg-accent text-white font-semibold px-5 py-2.5 rounded-lg hover:bg-accent-ink transition-colors whitespace-nowrap">Check</button>
      </form>
    </div>
    <div id="pp-feedback" class="hidden rounded-xl border p-4 mb-4" aria-live="polite">
      <p id="pp-feedback-text" class="font-semibold text-sm mb-1"></p>
      <p id="pp-why" class="text-sm leading-relaxed whitespace-pre-line text-slate-700"></p>
    </div>
    <button id="pp-next" type="button" class="hidden w-full bg-accent-soft text-accent-ink font-semibold py-2.5 rounded-lg hover:bg-accent/15 transition-colors">Next &rarr;</button>
  </div>

  <div id="pp-summary" class="hidden max-w-md mx-auto text-center">
    <div class="bg-white rounded-xl border border-slate-200 p-8 mb-6">
      <p id="pp-sum-title" class="text-lg font-bold text-slate-800 mb-4"></p>
      <p id="pp-sum-score" class="text-5xl font-bold text-accent-ink mb-2"></p>
      <p id="pp-sum-label" class="text-sm text-slate-500 mb-6"></p>
      <div class="w-full bg-slate-100 rounded-full h-3 mb-4">
        <div id="pp-sum-bar" class="h-3 rounded-full transition-all"></div>
      </div>
      <div id="pp-sum-skills" class="text-left space-y-2 mt-4 pt-4 border-t border-slate-100"></div>
    </div>
    <div class="flex gap-3">
      <button id="pp-retry" type="button" class="flex-1 bg-accent text-white font-semibold py-2.5 rounded-lg hover:bg-accent-ink transition-colors">Try again</button>
      <button id="pp-pick" type="button" class="flex-1 bg-slate-100 text-slate-700 font-semibold py-2.5 rounded-lg hover:bg-slate-200 transition-colors">Pick another unit</button>
    </div>
  </div>

  <div id="pp-print" class="hidden">
    <div class="text-center mb-8">
      <h1 id="pp-print-title" class="text-2xl font-bold mb-1"></h1>
      <p class="text-sm text-slate-500 mb-4">Prereq practice · {courseName}</p>
      <div class="flex justify-between border-b border-slate-300 pb-2 text-sm">
        <span>Name: ________________________________</span>
        <span>Date: ________________</span>
      </div>
    </div>
    <div id="pp-print-problems" class="pp-columns"></div>
    <div id="pp-print-answers" class="mt-12 pt-6 border-t-2 border-slate-400">
      <h2 class="text-lg font-bold mb-4">Answer key</h2>
      <div id="pp-print-key" class="pp-columns text-sm"></div>
    </div>
  </div>
</div>

<script type="application/json" id="pp-data" set:html={data} />

<style is:global>
  .pp-columns { columns: 2; column-gap: 2rem; }
  .pp-columns > div { break-inside: avoid; }
  .pp-box { border: 1px solid #cbd5e1; border-radius: 0.5rem; min-height: 2.5rem; }
  @media print {
    nav, header, footer, .skip-link,
    .practice-head, #pp-grid, #pp-problem, #pp-summary { display: none !important; }
    #pp-print { display: block !important; }
    #pp-print-answers { break-before: page; }
  }
</style>

<script>
  import type { PracticeItem, PracticeUnit } from '../data/practice/types';

  type Problem = PracticeItem & { skill: string; hint?: string; shown?: string[] };

  const { courseName, storageKey, units } = JSON.parse(document.getElementById('pp-data')!.textContent!) as {
    courseName: string; storageKey: string; units: PracticeUnit[];
  };
  const $ = (id: string) => document.getElementById(id)!;

  // ─── Random helpers ───
  const randInt = (n: number) => Math.floor(Math.random() * n);
  const shuffle = <T,>(arr: T[]) => {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) { const j = randInt(i + 1); [a[i], a[j]] = [a[j], a[i]]; }
    return a;
  };
  const toProblem = (item: PracticeItem, skill: PracticeUnit['skills'][number]): Problem => ({
    ...item,
    skill: skill.name,
    hint: item.hint ?? skill.hint,
    // Two options keep their order ("living, non-living"); more are shuffled.
    shown: item.choices && (item.choices.length > 2 ? shuffle(item.choices) : item.choices),
  });

  // ─── Checking typed answers ───
  // Ignore case, accents, punctuation, a leading article and a trailing "s".
  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/^\s*(a|an|the)\s+/, '').replace(/[^a-z0-9]/g, '').replace(/s$/, '');
  // The first number in the answer; spaces and commas inside it are ignored.
  const firstNumber = (s: string) => {
    const m = s.replace(/[−–]/g, '-').replace(/(\d)[\s,]+(?=\d{3}\b)/g, '$1').match(/-?\d+(\.\d+)?/);
    return m ? Number(m[0]) : NaN;
  };
  const isCorrect = (p: Problem, input: string) => {
    if (p.n !== undefined) return firstNumber(input) === p.n;
    const given = norm(input);
    return [p.a, ...(p.accept ?? [])].some((ok) => norm(ok) === given);
  };

  // ─── Progress, saved per browser ───
  const PROGRESS_KEY = `${storageKey}-practice-progress`;
  const SKILLS_KEY = `${storageKey}-practice-skills`;
  const load = (key: string) => { try { return JSON.parse(localStorage.getItem(key) ?? '') || {}; } catch { return {}; } };
  const save = (key: string, value: unknown) => { try { localStorage.setItem(key, JSON.stringify(value)); } catch {} };
  const skillId = (unitId: string, name: string) => `${unitId}::${name}`;

  function recordSkill(id: string, correct: boolean) {
    const skills = load(SKILLS_KEY);
    const s = skills[id] ?? { correct: 0, total: 0 };
    s.total++;
    if (correct) s.correct++;
    skills[id] = s;
    save(SKILLS_KEY, skills);
  }
  type Status = 'mastered' | 'developing' | 'needs-work' | 'new';
  function skillStatus(id: string): Status {
    const s = load(SKILLS_KEY)[id];
    if (!s || s.total === 0) return 'new';
    const rate = s.correct / s.total;
    if (rate >= 0.8 && s.total >= 2) return 'mastered';
    return rate >= 0.5 ? 'developing' : 'needs-work';
  }
  const dot: Record<Status, string> = { mastered: '🟢', developing: '🟡', 'needs-work': '🔴', new: '⚪' };
  const statusLabel: Record<Status, string> = { mastered: 'Mastered', developing: 'Developing', 'needs-work': 'Needs work', new: 'Not tried' };

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  // ─── State ───
  let unit: PracticeUnit;
  let problems: Problem[] = [];
  let index = 0;
  let score = 0;
  let answered = false;

  function showState(state: 'grid' | 'problem' | 'summary') {
    $('pp-grid').classList.toggle('hidden', state !== 'grid');
    $('pp-problem').classList.toggle('hidden', state !== 'problem');
    $('pp-summary').classList.toggle('hidden', state !== 'summary');
    window.scrollTo({ top: 0 });
  }

  function renderGrid() {
    const progress = load(PROGRESS_KEY);
    $('pp-grid').innerHTML = units.map((u) => {
      const p = progress[u.id];
      const total = p?.total ?? Math.min(u.skills.length, 5);
      const badge = p ? `<span class="text-xs font-semibold ${p.best / total >= 0.8 ? 'text-emerald-700' : 'text-slate-500'}">Best: ${p.best}/${total}</span>` : '';
      const dots = u.skills.map((s) => {
        const st = skillStatus(skillId(u.id, s.name));
        return `<span title="${esc(s.name)}: ${statusLabel[st]}">${dot[st]}</span>`;
      }).join(' ');
      return `<div class="bg-white rounded-xl border border-slate-200 px-5 py-4">
        <div class="flex items-center justify-between mb-1">
          <span class="text-xs font-bold text-accent-ink">Unit ${u.num}</span>${badge}
        </div>
        <p class="font-bold text-slate-800 text-sm mb-1">${esc(u.name)}</p>
        <p class="text-xs text-slate-500 mb-2">${esc(u.summary)}</p>
        <p class="text-xs mb-3" aria-label="Skill progress">${dots}</p>
        <div class="flex items-center gap-2">
          <button type="button" data-start="${u.id}" class="text-sm font-semibold text-accent-ink hover:underline">Start practice →</button>
          <button type="button" data-print="${u.id}" class="text-xs font-medium text-slate-500 hover:text-slate-800 ml-auto">🖨 Print</button>
        </div>
      </div>`;
    }).join('');
  }

  // One question per skill, at most five skills.
  function start(unitId: string) {
    unit = units.find((u) => u.id === unitId)!;
    const skills = unit.skills.length > 5 ? shuffle(unit.skills).slice(0, 5) : unit.skills;
    problems = skills.map((s) => toProblem(s.items[randInt(s.items.length)], s));
    index = 0;
    score = 0;
    $('pp-title').textContent = unit.name;
    showState('problem');
    showProblem();
  }

  function progressText() {
    $('pp-progress').textContent = `Question ${index + 1} of ${problems.length} · ${score} correct`;
  }

  function showProblem() {
    answered = false;
    const p = problems[index];
    progressText();
    $('pp-skill').textContent = p.skill;
    $('pp-question').textContent = p.q;
    $('pp-feedback').classList.add('hidden');
    $('pp-next').classList.add('hidden');
    $('pp-hint').classList.add('hidden');
    $('pp-hint').textContent = p.hint ?? '';
    $('pp-hint-toggle').classList.toggle('hidden', !p.hint);
    $('pp-hint-toggle').textContent = 'Show hint';

    const choices = $('pp-choices');
    const typed = $('pp-typed');
    const input = $('pp-input') as HTMLInputElement;
    choices.classList.toggle('hidden', !p.shown);
    typed.classList.toggle('hidden', !!p.shown);
    if (p.shown) {
      choices.innerHTML = p.shown.map((c, i) =>
        `<button type="button" data-choice="${i}" class="pp-choice text-left border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-800 hover:border-accent hover:bg-accent-soft transition-colors">${esc(c)}</button>`
      ).join('');
      (choices.firstElementChild as HTMLElement).focus();
    } else {
      input.value = '';
      input.disabled = false;
      ($('pp-check') as HTMLButtonElement).disabled = false;
      setTimeout(() => input.focus(), 50);
    }
  }

  function answer(given: string) {
    if (answered) return;
    const p = problems[index];
    answered = true;
    const correct = p.shown ? given === p.a : isCorrect(p, given);
    recordSkill(skillId(unit.id, p.skill), correct);
    if (correct) score++;
    progressText();

    if (p.shown) {
      $('pp-choices').querySelectorAll<HTMLButtonElement>('.pp-choice').forEach((b) => {
        const text = p.shown![Number(b.dataset.choice)];
        b.disabled = true;
        b.classList.remove('hover:border-accent', 'hover:bg-accent-soft');
        if (text === p.a) b.classList.add('border-emerald-500', 'bg-emerald-50', 'font-semibold');
        else if (text === given) b.classList.add('border-red-400', 'bg-red-50');
        else b.classList.add('opacity-60');
      });
    } else {
      ($('pp-input') as HTMLInputElement).disabled = true;
      ($('pp-check') as HTMLButtonElement).disabled = true;
    }

    const fb = $('pp-feedback');
    fb.className = `rounded-xl border p-4 mb-4 ${correct ? 'border-emerald-200 bg-emerald-50' : 'border-red-200 bg-red-50'}`;
    $('pp-feedback-text').className = `font-semibold text-sm mb-1 ${correct ? 'text-emerald-800' : 'text-red-800'}`;
    $('pp-feedback-text').textContent = correct ? 'Correct!' : `Not quite. The answer is: ${p.a}`;
    $('pp-why').textContent = p.why;
    $('pp-next').classList.remove('hidden');
    $('pp-next').focus();
  }

  function next() {
    index++;
    if (index >= problems.length) showSummary();
    else showProblem();
  }

  function showSummary() {
    const progress = load(PROGRESS_KEY);
    const prev = progress[unit.id] ?? { best: 0, attempts: 0 };
    progress[unit.id] = { best: Math.max(prev.best, score), total: problems.length, attempts: prev.attempts + 1, lastDate: new Date().toISOString().slice(0, 10) };
    save(PROGRESS_KEY, progress);

    showState('summary');
    const total = problems.length;
    const pct = (score / total) * 100;
    $('pp-sum-title').textContent = unit.name;
    $('pp-sum-score').textContent = `${score} / ${total}`;
    $('pp-sum-label').textContent = score === total ? 'Perfect! You’re ready.' : pct >= 60 ? 'Good work. Look back at the ones you missed.' : 'Keep practising. Try again and read each explanation.';
    $('pp-sum-bar').style.width = `${pct}%`;
    $('pp-sum-bar').className = `h-3 rounded-full transition-all ${pct >= 80 ? 'bg-emerald-500' : pct >= 60 ? 'bg-amber-400' : 'bg-red-400'}`;
    const skills = load(SKILLS_KEY);
    $('pp-sum-skills').innerHTML = '<p class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-2">Skill tracker</p>' +
      unit.skills.map((s) => {
        const id = skillId(unit.id, s.name);
        const d = skills[id];
        return `<div class="flex items-center justify-between gap-2 text-sm">
          <span class="flex items-center gap-2"><span>${dot[skillStatus(id)]}</span>${esc(s.name)}</span>
          <span class="text-xs text-slate-500">${d ? `${d.correct}/${d.total} correct` : 'Not tried'}</span>
        </div>`;
      }).join('');
  }

  // A 10-question sheet: go round the skills, never repeating a question.
  function printSheet(unitId: string) {
    const u = units.find((x) => x.id === unitId)!;
    const pools = u.skills.map((s) => ({ s, items: shuffle(s.items) }));
    const sheet: Problem[] = [];
    while (sheet.length < 10 && pools.some((p) => p.items.length)) {
      for (const pool of pools) {
        const item = pool.items.pop();
        if (item && sheet.length < 10) sheet.push(toProblem(item, pool.s));
      }
    }
    const letter = (i: number) => String.fromCharCode(97 + i);
    $('pp-print-title').textContent = `${u.name}: get ready`;
    $('pp-print-problems').innerHTML = sheet.map((p, i) => `<div class="mb-5">
      <p class="text-sm mb-1"><span class="font-bold text-slate-500">${i + 1}.</span> ${esc(p.q).replace(/\n/g, '<br>')}</p>
      ${p.shown ? `<p class="text-sm pl-4">${p.shown.map((c, j) => `${letter(j)}) ${esc(c)}`).join('<br>')}</p>` : '<div class="pp-box"></div>'}
    </div>`).join('');
    $('pp-print-key').innerHTML = sheet.map((p, i) => {
      const a = p.shown ? `${letter(p.shown.indexOf(p.a))}) ${esc(p.a)}` : esc(p.a);
      return `<div class="mb-4"><p class="font-semibold">${i + 1}. ${a}</p><p class="text-xs text-slate-600">${esc(p.why).replace(/\n/g, '<br>')}</p></div>`;
    }).join('');
    window.print();
  }

  // ─── Events ───
  $('pp-grid').addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const printBtn = t.closest<HTMLElement>('[data-print]');
    if (printBtn) return printSheet(printBtn.dataset.print!);
    const startBtn = t.closest<HTMLElement>('[data-start]');
    if (startBtn) start(startBtn.dataset.start!);
  });
  $('pp-choices').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-choice]');
    if (b) answer(problems[index].shown![Number(b.dataset.choice)]);
  });
  $('pp-typed').addEventListener('submit', (e) => {
    e.preventDefault();
    const value = ($('pp-input') as HTMLInputElement).value.trim();
    if (value) answer(value);
  });
  $('pp-next').addEventListener('click', next);
  $('pp-hint-toggle').addEventListener('click', () => {
    const hidden = $('pp-hint').classList.toggle('hidden');
    $('pp-hint-toggle').textContent = hidden ? 'Show hint' : 'Hide hint';
  });
  const toGrid = () => { renderGrid(); showState('grid'); };
  $('pp-back').addEventListener('click', toGrid);
  $('pp-pick').addEventListener('click', toGrid);
  $('pp-retry').addEventListener('click', () => start(unit.id));

  renderGrid();
</script>
