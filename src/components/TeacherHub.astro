---
// The teacher hub for a course with one teacher guide per unit: a card per
// unit with its guide and answer keys. The page supplies the per-unit colours,
// tags and any scope lines; the manifest supplies names, guides and keys.
import type { CourseManifest } from '../data/manifest';

interface Unit {
  slug: string;
  /** Short tag shown first in the header, e.g. 'Time and Place' or 'Tier 1'. */
  tag: string;
  tagStyle: string;
  color: string;
  /** One-line scope note from the unit's content file. */
  summary: string;
  /** Optional line after the tag, e.g. '6–7 weeks'. */
  meta?: string;
  /** Optional misconception flags shown under the summary. */
  misconceptions?: string[];
}

interface Props {
  /** Course key: also the route segment, e.g. 'social8'. */
  course: string;
  manifest: CourseManifest;
  units: Unit[];
  /** Course accent for the heading line. */
  accent: string;
  /** Course name for the page heading, e.g. 'Social Studies 8'. */
  name: string;
  /** Text after the guide's name, describing what it holds. */
  guideNote?: string;
}

const {
  course,
  manifest,
  units,
  accent,
  name,
  guideNote = 'Pacing · Discussion Prompts · Misconceptions',
} = Astro.props;
const base = import.meta.env.BASE_URL;

// Join each page's unit metadata to the manifest, so labels, guides and keys
// have one source.
const rows = units.map((u) => {
  const m = manifest.units.find((x) => x.slug === u.slug);
  if (!m) throw new Error(`${course}: no manifest unit for ${u.slug}`);
  return { ...u, label: m.label, teacherGuide: m.teacherGuide, keys: m.keys };
});
---

<div class="mb-8">
  <p class="text-xs font-bold uppercase tracking-widest mb-2" style={`color: ${accent};`}>Teacher Hub · {name}</p>
  <h1 class="text-3xl font-bold text-slate-900 mb-2">{name} — Teacher View</h1>
  <p class="text-slate-500">Teaching guides with pacing, discussion prompts, and misconception flags for all {rows.length} units.</p>
</div>

<div class="space-y-4">
  {rows.map((u) => (
    <div
      id={u.slug}
      class="scroll-mt-32 bg-white rounded-xl border border-slate-200 border-l-4 overflow-hidden"
      style={`border-left-color: ${u.color};`}
    >
      <!-- Unit header -->
      <div class="px-5 py-4 flex items-start justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class={`text-xs font-semibold px-2 py-0.5 rounded-full ${u.tagStyle}`}>{u.tag}</span>
            {u.meta && <span class="text-xs text-slate-400">{u.meta}</span>}
          </div>
          <p class="font-bold text-slate-900">{u.label}</p>
          <p class="mt-1.5 max-w-[78ch] text-sm leading-relaxed text-slate-600">{u.summary}</p>
          {u.misconceptions && (
            <p class="text-xs text-slate-400 mt-1">Key misconceptions: {u.misconceptions.join(' · ')}</p>
          )}
        </div>
        <a href={`${base}${course}/materials/${u.slug}`} class="shrink-0 text-xs font-semibold text-slate-400 hover:text-slate-700">Student page →</a>
      </div>

      <!-- Teacher guide link -->
      {u.teacherGuide && (
        <div class="border-t border-slate-100 px-5 py-3 flex items-center justify-between gap-4 bg-amber-50">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-amber-600 text-white">Teacher Guide</span>
            <span class="text-sm font-medium text-slate-700">{guideNote}</span>
          </div>
          <a
            href={`${base}${course}/view/${u.slug}/${u.teacherGuide}`}
            target="_blank"
            rel="noopener"
            class="flex-shrink-0 text-sm font-semibold text-amber-700 hover:text-amber-900 border border-amber-300 hover:border-amber-500 px-4 py-1.5 rounded-lg transition-colors whitespace-nowrap"
          >
            Open ↗
          </a>
        </div>
      )}

      <!-- Answer keys (collapsed) -->
      <div class="border-t border-slate-100 px-5 py-3">
        <details class="group">
          <summary class="cursor-pointer list-none flex items-center gap-2 text-sm font-medium text-slate-400 hover:text-slate-600 transition-colors select-none">
            <span class="inline-block transition-transform group-open:rotate-90">▶</span>
            Answer keys
          </summary>
          <div class="mt-3 space-y-2">
            {u.keys.map((ak) => (
              <div class="bg-slate-50 rounded-lg border border-slate-200 px-4 py-2.5 flex items-center justify-between gap-4">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-slate-200 text-slate-600">Answer Key</span>
                  <span class="text-sm font-medium text-slate-600">{ak.label}</span>
                </div>
                <a
                  href={`${base}${course}/view/${u.slug}/${ak.doc}`}
                  target="_blank"
                  rel="noopener"
                  class="flex-shrink-0 text-sm font-semibold text-slate-500 hover:text-slate-800 border border-slate-200 hover:border-slate-400 px-4 py-1.5 rounded-lg transition-colors"
                >
                  Open ↗
                </a>
              </div>
            ))}
          </div>
        </details>
      </div>
    </div>
  ))}
</div>

<div class="mt-10 pt-6 border-t border-slate-100">
  <a href={`${base}${course}`} class="text-sm text-slate-400 hover:text-slate-600 transition-colors">
    ← Back to {name}
  </a>
</div>
