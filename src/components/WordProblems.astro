---
// Shared markup + styles for the Word Problems practice page.
// Accent colours come from the site-wide --accent variables set by <body data-course="…">.
interface Props {
  courseName: string;
}
const { courseName } = Astro.props;
---

<div class="wp">
  <!-- STATE 1: topic grid -->
  <div id="wp-grid" class="grid sm:grid-cols-2 gap-4"></div>

  <!-- STATE 2: problem view -->
  <div id="wp-problem" class="hidden max-w-2xl mx-auto">
    <button id="wp-back" type="button" class="text-sm text-slate-400 hover:text-slate-700 mb-4 transition-colors">&larr; Back to topics</button>
    <div class="flex items-center justify-between gap-3 mb-3">
      <h2 id="wp-title" class="text-lg font-bold text-slate-800"></h2>
      <span id="wp-progress" class="text-xs font-medium text-slate-400 whitespace-nowrap"></span>
    </div>
    <div class="bg-white rounded-xl border border-slate-200 p-6 mb-4">
      <span id="wp-level-tag" class="wp-tag"></span>
      <p id="wp-question" class="text-base text-slate-800 mt-3 mb-5 leading-relaxed"></p>
      <button id="wp-hint-toggle" type="button" class="hidden text-xs font-medium wp-accent-text mb-3">Show hint</button>
      <div id="wp-hint" class="hidden text-sm text-slate-600 bg-slate-50 border border-slate-200 rounded-lg p-3 mb-4"></div>
      <div class="flex gap-2 items-center">
        <input id="wp-input" type="text" autocomplete="off" spellcheck="false" inputmode="text"
          class="wp-input flex-1 min-w-0 border border-slate-300 rounded-lg px-4 py-2.5 text-base" />
        <span id="wp-unit" class="hidden text-sm text-slate-500 whitespace-nowrap"></span>
        <button id="wp-check" type="button" class="wp-btn-primary px-5 py-2.5 whitespace-nowrap">Check</button>
      </div>
    </div>
    <div id="wp-feedback" class="hidden">
      <p id="wp-feedback-text" class="font-semibold text-sm"></p>
      <button id="wp-steps-toggle" type="button" class="hidden text-xs font-medium underline mt-2">Show worked solution</button>
      <div id="wp-feedback-steps" class="mt-3"></div>
    </div>
    <button id="wp-next" type="button" class="hidden wp-btn-soft w-full py-2.5 mt-4">Next problem &rarr;</button>
  </div>

  <!-- STATE 3: summary -->
  <div id="wp-summary" class="hidden max-w-md mx-auto text-center">
    <div class="bg-white rounded-xl border border-slate-200 p-8 mb-6">
      <p id="wp-sum-title" class="text-lg font-bold text-slate-800 mb-4"></p>
      <p id="wp-sum-score" class="text-5xl font-bold mb-2 wp-accent-text"></p>
      <p id="wp-sum-label" class="text-sm text-slate-500 mb-6"></p>
      <div class="w-full bg-slate-100 rounded-full h-3">
        <div id="wp-sum-bar" class="h-3 rounded-full"></div>
      </div>
    </div>
    <div class="flex flex-wrap gap-3">
      <button id="wp-retry" type="button" class="flex-1 wp-btn-primary py-2.5">New set, same level</button>
      <button id="wp-levelup" type="button" class="flex-1 wp-btn-soft py-2.5">Next level →</button>
      <button id="wp-pick" type="button" class="w-full bg-slate-100 text-slate-700 font-semibold py-2.5 rounded-lg hover:bg-slate-200 transition-colors">Pick another topic</button>
    </div>
  </div>

  <!-- PRINT SHEET -->
  <div id="wp-print" class="hidden">
    <div class="text-center mb-6">
      <h1 id="wp-print-title" class="text-2xl font-bold mb-1"></h1>
      <p id="wp-print-sub" class="text-sm text-slate-500 mb-4">{courseName}</p>
      <div class="flex justify-between border-b border-slate-300 pb-2 text-sm">
        <span>Name: ________________________________</span>
        <span>Date: ________________</span>
      </div>
      <p class="text-xs text-slate-500 mt-3 text-left">Show your work for every problem. Include units in your answer.</p>
    </div>
    <div id="wp-print-problems"></div>
    <div class="wp-print-keypage">
      <h2 class="text-lg font-bold mb-4">Answer Key</h2>
      <div id="wp-print-key" class="wp-print-keycols"></div>
    </div>
  </div>
</div>

<style is:global>
  /* Course colours come from the site-wide --accent variables (src/styles/global.css). */
  .wp, #wp-print { --wp-accent: rgb(var(--accent)); --wp-accent-dark: rgb(var(--accent-ink)); --wp-accent-soft: rgb(var(--accent-soft)); }

  .wp-accent-text { color: var(--wp-accent); }
  .wp-card { @apply bg-white rounded-xl border border-slate-200 border-l-4 px-5 py-4; border-left-color: var(--wp-accent); }

  .wp-level-btn { @apply relative flex flex-col items-start text-left rounded-lg border px-2.5 py-2 transition-colors; }
  .wp-level-btn:hover { filter: brightness(0.97); }
  .wp-level-name { @apply text-xs font-bold; }
  .wp-level-sub { @apply text-[11px] leading-tight text-slate-500; }
  .wp-level-1 { @apply bg-emerald-50 border-emerald-200; }
  .wp-level-1 .wp-level-name { @apply text-emerald-700; }
  .wp-level-2 { @apply bg-amber-50 border-amber-200; }
  .wp-level-2 .wp-level-name { @apply text-amber-700; }
  .wp-level-3 { @apply bg-rose-50 border-rose-200; }
  .wp-level-3 .wp-level-name { @apply text-rose-700; }
  .wp-badge { @apply absolute top-1.5 right-1.5 text-[10px] font-semibold text-slate-400; }
  .wp-badge-done { @apply text-emerald-600; }
  .wp-mixed-btn { @apply w-full text-left text-xs font-semibold py-1 hover:underline; color: var(--wp-accent); }

  .wp-tag { @apply inline-block text-xs font-bold uppercase tracking-wide px-2 py-0.5 rounded-full; }
  .wp-tag-1 { @apply bg-emerald-100 text-emerald-700; }
  .wp-tag-2 { @apply bg-amber-100 text-amber-700; }
  .wp-tag-3 { @apply bg-rose-100 text-rose-700; }

  .wp-input:focus { outline: none; border-color: var(--wp-accent); box-shadow: 0 0 0 2px var(--wp-accent-soft); }
  .wp-btn-primary { @apply text-white font-semibold rounded-lg transition-colors; background-color: var(--wp-accent); }
  .wp-btn-primary:hover { background-color: var(--wp-accent-dark); }
  .wp-btn-primary:disabled { @apply opacity-50; }
  .wp-btn-soft { @apply font-semibold rounded-lg transition-colors; background-color: var(--wp-accent-soft); color: var(--wp-accent-dark); }

  .wp-feedback { @apply rounded-xl border p-4; }
  .wp-feedback-ok { @apply border-emerald-200 bg-emerald-50 text-emerald-800; }
  .wp-feedback-bad { @apply border-red-200 bg-red-50 text-red-800; }
  .wp-steps { @apply list-decimal pl-5 text-sm text-slate-700; }
  .wp-steps li + li { margin-top: 0.375rem; }

  /* Print */
  .wp-print-h2 { @apply text-base font-bold border-b border-slate-300 pb-1 mb-3 mt-2; }
  .wp-print-h2 span { @apply font-normal text-slate-500 text-sm; }
  .wp-print-h3 { @apply text-sm font-bold mt-3 mb-1; }
  .wp-print-problem { @apply mb-4 text-sm; break-inside: avoid; }
  .wp-print-work { @apply border border-slate-300 rounded-md mt-2 mb-1; height: 7.5rem; }
  .wp-print-answer-line { @apply text-right text-sm; }
  .wp-print-keyitem { @apply text-xs mb-3; break-inside: avoid; }
  .wp-print-keyitem ol { @apply list-decimal pl-5 text-slate-600; }
  .wp-print-keycols { columns: 2; column-gap: 2rem; }

  @media print {
    body.wp-printing main > *:not(.wp) { display: none !important; }
    body.wp-printing .wp > *:not(#wp-print) { display: none !important; }
    body.wp-printing #wp-print { display: block !important; }
    body.wp-printing main { padding: 0 !important; max-width: none !important; }
    .wp-print-section { break-inside: auto; }
    .wp-print-keypage { break-before: page; }
  }
</style>
